@model TSSC.Unified.ViewModel.TrainerRegistrationViewModel

@{
    Layout = "_Layout";

    var qualifications = ViewBag.Qualifications;
    var experiences = ViewBag.Experiences;
    var documents = ViewBag.Documents;

    string registrationNo = ViewBag.RegistrationNo?.ToString() ?? "-";
    string registrationMode = ViewBag.RegistrationMode?.ToString() ?? "-";
    string status = ViewBag.Status?.ToString() ?? "Pending";
    string remarks = ViewBag.Remarks?.ToString() ?? "";

    string jobRoleName = ViewBag.JobRoleName?.ToString() ?? "-";
    string stateName = ViewBag.StateName?.ToString() ?? "-";
    string districtName = ViewBag.DistrictName?.ToString() ?? "-";
    string cityName = ViewBag.CityName?.ToString() ?? "-";

    bool emailVerified = Convert.ToBoolean(
        ViewBag.EmailVerified ?? false
    );
}

<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between align-items-center">

        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                My Application
            </h3>

            <div class="nk-block-des">
                <p>
                    View your trainer registration application details.
                </p>
            </div>

        </div>

        <div class="nk-block-head-content">

            <a asp-area="Trainer"
               asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-primary">

                <em class="icon ni ni-dashboard"></em>

                <span>
                    Dashboard
                </span>

            </a>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- TRAINER REGISTRATION -->
<!-- ========================================================= -->

<div class="card card-bordered mb-4">

    <div class="card-inner">

        <!-- HEADER -->
        <div class="row align-items-start mb-4">

            <div class="col-md-8">

                <h5 class="title mb-1">
                    Trainer Registration
                </h5>

                <div class="text-soft">

                    <span>
                        Registration No:
                    </span>

                    <strong class="text-primary">
                        @registrationNo
                    </strong>

                </div>

            </div>


            <div class="col-md-4 text-md-end mt-2 mt-md-0">

                @if (status.Equals("Approved",
                                StringComparison.OrdinalIgnoreCase))
                {
                    <span class="badge badge-dim bg-success">
                        Approved
                    </span>
                }
                else if (status.Equals("Rejected",
                StringComparison.OrdinalIgnoreCase))
                {
                    <span class="badge badge-dim bg-danger">
                        Rejected
                    </span>
                }
                else
                {
                    <span class="badge badge-dim bg-warning">
                        @status
                    </span>
                }

            </div>

        </div>


        <!-- BASIC DETAILS -->
        <div class="row g-4">

            <!-- Candidate Name -->
            <div class="col-md-4">

                <label class="form-label">
                    Candidate Name
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.CandidateName ?? "-")"
                       readonly />

            </div>


            <!-- Registration Mode -->
            <div class="col-md-4">

                <label class="form-label">
                    Registration Mode
                </label>

                <input type="text"
                       class="form-control"
                       value="@registrationMode"
                       readonly />

            </div>


            <!-- Date of Birth -->
            <div class="col-md-4">

                <label class="form-label">
                    Date of Birth
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.DateOfBirth?.ToString("dd-MMM-yyyy") ?? "-")"
                       readonly />

            </div>


            <!-- Gender -->
            <div class="col-md-4">

                <label class="form-label">
                    Gender
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.Gender ?? "-")"
                       readonly />

            </div>


            <!-- Job Role -->
            <div class="col-md-4">

                <label class="form-label">
                    Job Role
                </label>

                <input type="text"
                       class="form-control"
                       value="@jobRoleName"
                       readonly />

            </div>


            <!-- Scheme -->
            <div class="col-md-4">

                <label class="form-label">
                    Scheme
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.Scheme ?? "-")"
                       readonly />

            </div>


            <!-- TP / AB -->
            <div class="col-md-4">

                <label class="form-label">
                    TP / AB Name
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.TPId?.ToString() ?? "-")"
                       readonly />

            </div>


            <!-- SPOC -->
            <div class="col-md-4">

                <label class="form-label">
                    SPOC Name
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.SPOCName ?? "-")"
                       readonly />

            </div>


            <!-- SIDH -->
            <div class="col-md-4">

                <label class="form-label">
                    Applied for Training Request on SIDH
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.SIDHApplied ?? "-")"
                       readonly />

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- CONTACT DETAILS -->
<!-- ========================================================= -->

<div class="card card-bordered mb-4">

    <div class="card-inner">

        <h5 class="title mb-4">
            Contact Details
        </h5>

        <div class="row g-4">

            <!-- Email -->
            <div class="col-md-6">

                <label class="form-label">
                    Email
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.Email ?? "-")"
                       readonly />

            </div>


            <!-- Mobile -->
            <div class="col-md-6">

                <label class="form-label">
                    Mobile
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.Mobile ?? "-")"
                       readonly />

            </div>


            <!-- Address -->
            <div class="col-md-12">

                <label class="form-label">
                    Address
                </label>

                <textarea class="form-control"
                          rows="2"
                          readonly>@(Model.Address ?? "-")</textarea>

            </div>


            <!-- State -->
            <div class="col-md-3">

                <label class="form-label">
                    State
                </label>

                <input type="text"
                       class="form-control"
                       value="@stateName"
                       readonly />

            </div>


            <!-- District -->
            <div class="col-md-3">

                <label class="form-label">
                    District
                </label>

                <input type="text"
                       class="form-control"
                       value="@districtName"
                       readonly />

            </div>


            <!-- City -->
            <div class="col-md-3">

                <label class="form-label">
                    City
                </label>

                <input type="text"
                       class="form-control"
                       value="@cityName"
                       readonly />

            </div>


            <!-- Pincode -->
            <div class="col-md-3">

                <label class="form-label">
                    Pincode
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.Pincode ?? "-")"
                       readonly />

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- REFERENCE DETAILS -->
<!-- ========================================================= -->

<div class="card card-bordered mb-4">

    <div class="card-inner">

        <h5 class="title mb-4">
            Reference Details
        </h5>

        <div class="row g-4">

            <div class="col-md-4">

                <label class="form-label">
                    Reference Name
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.ReferenceName ?? "-")"
                       readonly />

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Reference Designation
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.ReferenceDesignation ?? "-")"
                       readonly />

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Reference Organization
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.ReferenceOrganization ?? "-")"
                       readonly />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Reference Email
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.ReferenceEmail ?? "-")"
                       readonly />

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Reference Mobile
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.ReferenceMobile ?? "-")"
                       readonly />

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- EDUCATION QUALIFICATION -->
<!-- ========================================================= -->

<div class="card card-bordered mb-4">

    <div class="card-inner">

        <h5 class="title mb-4">
            Education Qualification
        </h5>

        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead class="tb-odr-head">

                    <tr>

                        <th>S.No.</th>
                        <th>Qualification</th>
                        <th>Board</th>
                        <th>Passing Year</th>
                        <th>Percentage / CGPA</th>
                        <th>Document</th>

                    </tr>

                </thead>

                <tbody>

                    @if (qualifications != null)
                    {
                        int serial = 1;

                        foreach (var item in qualifications)
                        {
                            <tr>

                                <td>
                                    @serial
                                </td>

                                <td>
                                    @(item.Qualification ?? "-")
                                </td>

                                <td>
                                    @(item.Board ?? "-")
                                </td>

                                <td>
                                    @(item.PassingYear ?? "-")
                                </td>

                                <td>
                                    @(item.PercentageOrCGPA ?? "-")
                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.FilePath))
                                    {
                                        <a href="@item.FilePath"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">

                                            <em class="icon ni ni-file-pdf"></em>
                                            View

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-soft">
                                            No Document
                                        </span>
                                    }

                                </td>

                            </tr>

                            serial++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center text-soft">

                                No qualification details available.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- EXPERIENCE -->
<!-- ========================================================= -->

<div class="card card-bordered mb-4">

    <div class="card-inner">

        <h5 class="title mb-4">
            Experience
        </h5>

        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead class="tb-odr-head">

                    <tr>

                        <th>S.No.</th>
                        <th>Organization</th>
                        <th>Designation</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Duration</th>
                        <th>Document</th>

                    </tr>

                </thead>

                <tbody>

                    @if (experiences != null)
                    {
                        int serial = 1;

                        foreach (var item in experiences)
                        {
                            <tr>

                                <td>
                                    @serial
                                </td>

                                <td>
                                    @(item.OrganizationName ?? "-")
                                </td>

                                <td>
                                    @(item.Designation ?? "-")
                                </td>

                                <td>
                                    @(item.FromDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>
                                    @(item.ToDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>
                                    @(item.Duration ?? "-")
                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.FilePath))
                                    {
                                        <a href="@item.FilePath"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">

                                            <em class="icon ni ni-file-pdf"></em>
                                            View

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-soft">
                                            No Document
                                        </span>
                                    }

                                </td>

                            </tr>

                            serial++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center text-soft">

                                No experience details available.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- DOCUMENTS -->
<!-- ========================================================= -->

<div class="card card-bordered mb-4">

    <div class="card-inner">

        <h5 class="title mb-4">
            Documents
        </h5>

        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead class="tb-odr-head">

                    <tr>

                        <th>
                            Document Type
                        </th>

                        <th>
                            File Name
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (documents != null)
                    {
                        foreach (var item in documents)
                        {
                            <tr>

                                <td>
                                    @(item.DocumentType ?? "-")
                                </td>

                                <td>
                                    @(item.FileName ?? "-")
                                </td>

                                <td>

                                    @if (item.VerificationStatus == "Approved")
                                    {
                                        <span class="badge badge-dim bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (item.VerificationStatus == "Rejected")
                                    {
                                        <span class="badge badge-dim bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dim bg-warning">
                                            @(item.VerificationStatus ?? "Pending")
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.FilePath))
                                    {
                                        <a href="@item.FilePath"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">

                                            <em class="icon ni ni-eye"></em>
                                            View

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-soft">
                                            No Document
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4"
                                class="text-center text-soft">

                                No documents available.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- APPLICATION STATUS & REMARKS -->
<!-- ========================================================= -->

<div class="card card-bordered">

    <div class="card-inner">

        <h5 class="title mb-4">
            Application Status &amp; Remarks
        </h5>


        <!-- STATUS INFORMATION -->

        <div class="row g-4 mb-4">

            <!-- APPLICATION STATUS -->

            <div class="col-md-4">

                <div class="d-flex align-items-center gap-2">

                    <span class="fw-semibold">
                        Application Status
                    </span>

                    @if (status.Equals(
                                        "Approved",
                                        StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge badge-dim bg-success">
                            Approved
                        </span>
                    }
                    else if (status.Equals(
                    "Rejected",
                    StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge badge-dim bg-danger">
                            Rejected
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-dim bg-warning">
                            @status
                        </span>
                    }

                </div>

            </div>


            <!-- EMAIL VERIFICATION -->

            <div class="col-md-4">

                <div class="d-flex align-items-center gap-2">

                    <span class="fw-semibold">
                        Email Verification
                    </span>

                    @if (emailVerified)
                    {
                        <span class="badge badge-dim bg-success">
                            Verified
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-dim bg-warning">
                            Not Verified
                        </span>
                    }

                </div>

            </div>


            <!-- MOBILE VERIFICATION -->

            <div class="col-md-4">

                <div class="d-flex align-items-center gap-2">

                    <span class="fw-semibold">
                        Mobile Verification
                    </span>

                    @if (Model.MobileVerified)
                    {
                        <span class="badge badge-dim bg-success">
                            Verified
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-dim bg-warning">
                            Not Verified
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- REMARKS -->

        <div>

            <label class="form-label">
                Remarks
            </label>

            <div class="border rounded p-3 bg-light">

                @if (!string.IsNullOrWhiteSpace(remarks))
                {
                    @remarks
                }
                else
                {
                    <span class="text-soft">
                        No remarks available.
                    </span>
                }

            </div>

        </div>

    </div>

</div>