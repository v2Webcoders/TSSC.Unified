@model TSSC.Unified.ViewModel.ScreeningScheduleVM

@{
    Layout = "_Layout";

    // =========================================================
    // BASIC TRAINER INFORMATION
    // =========================================================

    string trainerName =
        ViewBag.TrainerName?.ToString() ?? "-";

    string registrationNo =
        ViewBag.RegistrationNo?.ToString() ?? "-";

    string registrationStatus =
        ViewBag.RegistrationStatus?.ToString() ?? "Pending";

    string jobRole =
        ViewBag.JobRole?.ToString() ?? "-";


    // =========================================================
    // SCREENING
    // =========================================================

    string screeningStatus =
        ViewBag.ScreeningStatus?.ToString() ?? "Awaiting Schedule";


    // =========================================================
    // PAYMENT / FINANCE
    // =========================================================

    string paymentStatus =
        ViewBag.PaymentStatus?.ToString() ?? "Not Applicable";

    bool paymentPaid =
        ViewBag.PaymentPaid is bool paid && paid;

    bool paymentVerified =
        ViewBag.PaymentVerified is bool verified && verified;

    bool financeApproved =
        ViewBag.FinanceApproved is bool finance && finance;


    // =========================================================
    // BATCH
    // =========================================================

    bool batchAssigned =
        ViewBag.BatchAssigned is bool assigned && assigned;

    string batchCode =
        ViewBag.BatchCode?.ToString() ?? "-";

    string batchName =
        ViewBag.BatchName?.ToString() ?? "-";


    // =========================================================
    // ASSESSMENT
    // =========================================================

    bool resultUploaded =
           ViewBag.ResultUploaded is bool uploaded && uploaded;
    bool raiseReq =
    ViewBag.RaiseReq is bool raised && raised;

    // =========================================================
    // DATE / SCREENING FLAGS
    // =========================================================

    bool registrationCompleted =
        ViewBag.RegistrationDate != null;

    bool screeningScheduled =
        string.Equals(
            screeningStatus,
            "Scheduled",
            StringComparison.OrdinalIgnoreCase);

    bool screeningSuccess =
        string.Equals(
            screeningStatus,
            "Success",
            StringComparison.OrdinalIgnoreCase);

    bool screeningRejected =
        string.Equals(
            screeningStatus,
            "Rejected",
            StringComparison.OrdinalIgnoreCase);

    bool screeningOnHold =
        string.Equals(
            screeningStatus,
            "On Hold",
            StringComparison.OrdinalIgnoreCase);

    bool certificateUploaded =
ViewBag.CertificateUploaded is bool certUploaded && certUploaded;

    string certificateFileName =
        ViewBag.CertificateFileName?.ToString() ?? "";
 
}


<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between align-items-center">

        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                My Application Status
            </h3>

            <div class="nk-block-des">
                <p>
                    Track your registration, screening, payment,
                    finance approval, batch and assessment status.
                </p>
            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- APPLICATION JOURNEY -->
<!-- ========================================================= -->

<div class="card card-bordered mb-4">

    <div class="card-inner">

        <h5 class="title mb-4">
            Application Journey
        </h5>

        <div class="row g-3">

            <!-- ================================================= -->
            <!-- 1. REGISTRATION -->
            <!-- ================================================= -->

            <div class="col-md-4 col-lg-2">

                <div class="border rounded p-3 text-center h-100">

                    <div class="fs-4
                        @(registrationCompleted
                            ? "text-success"
                            : "text-warning") mb-2">

                        @(registrationCompleted ? "✓" : "1")

                    </div>

                    <div class="fw-semibold">
                        Registration
                    </div>

                    <small class="text-soft">
                        @(registrationCompleted
                            ? "Completed"
                            : registrationStatus)
                    </small>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- 2. SCREENING -->
            <!-- ================================================= -->

            <div class="col-md-4 col-lg-2">

                <div class="border rounded p-3 text-center h-100">

                    <div class="fs-4
                        @(screeningSuccess
                            ? "text-success"
                            : screeningRejected
                                ? "text-danger"
                                : screeningScheduled
                                    ? "text-primary"
                                    : screeningOnHold
                                        ? "text-warning"
                                        : "text-secondary") mb-2">

                        @(screeningSuccess
                            ? "✓"
                            : screeningRejected
                                ? "!"
                                : "2")

                    </div>

                    <div class="fw-semibold">
                        Screening
                    </div>

                    <small class="text-soft">
                        @screeningStatus
                    </small>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- 3. PAYMENT -->
            <!-- ================================================= -->

            <div class="col-md-4 col-lg-2">

                <div class="border rounded p-3 text-center h-100">

                    <div class="fs-4
                        @(paymentPaid
                            ? "text-success"
                            : screeningSuccess
                                ? "text-warning"
                                : "text-secondary") mb-2">

                        @(paymentPaid ? "✓" : "3")

                    </div>

                    <div class="fw-semibold">
                        Payment
                    </div>

                    <small class="text-soft">
                        @paymentStatus
                    </small>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- 4. FINANCE -->
            <!-- ================================================= -->

            <div class="col-md-4 col-lg-2">

                <div class="border rounded p-3 text-center h-100">

                    <div class="fs-4
                        @(financeApproved
                            ? "text-success"
                            : paymentVerified
                                ? "text-primary"
                                : "text-secondary") mb-2">

                        @(financeApproved ? "✓" : "4")

                    </div>

                    <div class="fw-semibold">
                        Finance
                    </div>

                    <small class="text-soft">

                        @(financeApproved
                            ? "Approved"
                            : paymentVerified
                                ? "Approval Pending"
                                : "Pending")

                    </small>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- 5. BATCH -->
            <!-- ================================================= -->

            <div class="col-md-4 col-lg-2">

                <div class="border rounded p-3 text-center h-100">

                    <div class="fs-4
                        @(batchAssigned
                            ? "text-success"
                            : financeApproved
                                ? "text-primary"
                                : "text-secondary") mb-2">

                        @(batchAssigned ? "✓" : "5")

                    </div>

                    <div class="fw-semibold">
                        Batch
                    </div>

                    <small class="text-soft">

                        @(batchAssigned
                            ? "Assigned"
                            : financeApproved
                                ? "Awaiting Assignment"
                                : "Pending")

                    </small>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- 6. ASSESSMENT -->
            <!-- ================================================= -->

            <div class="col-md-4 col-lg-2">

                <div class="border rounded p-3 text-center h-100">

                    <div class="fs-4
            @(resultUploaded
                                         ? "text-success"
                                         : "text-secondary") mb-2">

                        @(resultUploaded ? "✓" : "6")

                    </div>

                    <div class="fw-semibold">
                        Result
                    </div>

                    <small class="text-soft">
                        @(resultUploaded ? "Done" : "Pending")
                    </small>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- APPLICATION SUMMARY -->
<!-- ========================================================= -->

<div class="card card-bordered mb-4">

    <div class="card-inner">

        <div class="row g-4">

            <!-- ================================================= -->
            <!-- TRAINER NAME -->
            <!-- ================================================= -->

            <div class="col-md-4">

                <label class="form-label">
                    Trainer Name
                </label>

                <div class="form-control">
                    @trainerName
                </div>

            </div>


            <!-- ================================================= -->
            <!-- REGISTRATION NUMBER -->
            <!-- ================================================= -->

            <div class="col-md-4">

                <label class="form-label">
                    Registration No.
                </label>

                <div class="form-control">
                    @registrationNo
                </div>

            </div>


            <!-- ================================================= -->
            <!-- APPLICATION STATUS -->
            <!-- ================================================= -->

            <div class="col-md-4">

                <label class="form-label">
                    Application Status
                </label>

                <div>

                    @if (registrationStatus.Equals(
                        "Approved",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge badge-dim bg-success">
                            Approved
                        </span>
                    }
                    else if (registrationStatus.Equals(
                        "Rejected",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge badge-dim bg-danger">
                            Rejected
                        </span>
                    }
                    else if (registrationStatus.Equals(
                        "On Hold",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge badge-dim bg-warning">
                            On Hold
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-dim bg-warning">
                            @registrationStatus
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- APPLICATION DETAILS -->
<!-- ========================================================= -->

<div class="card card-bordered">

    <div class="card-inner">

        <h5 class="title mb-4">
            My Application Details
        </h5>

        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead class="tb-odr-head">

                    <tr>

                        <th>
                            Registration Date
                        </th>

                        <th>
                            Job Role
                        </th>

                        <th>
                            Screening
                        </th>

                        <th>
                            Payment
                        </th>

                        <th>
                            Finance
                        </th>

                        <th>
                            Batch
                        </th>

                        <th>
                            Result
                        </th>
                        <th>
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <!-- ================================================= -->
                        <!-- REGISTRATION DATE -->
                        <!-- ================================================= -->

                        <td>

                            @(ViewBag.RegistrationDate != null
                                ? Convert.ToDateTime(
                                    ViewBag.RegistrationDate)
                                    .ToString("dd-MM-yyyy")
                                : "-")

                        </td>


                        <!-- ================================================= -->
                        <!-- JOB ROLE -->
                        <!-- ================================================= -->

                        <td>
                            @jobRole
                        </td>


                        <!-- ================================================= -->
                        <!-- SCREENING -->
                        <!-- ================================================= -->
                        <!-- SCREENING -->
                        <td>

                            @{
                                var screeningBadgeClass = screeningStatus switch
                                {
                                    "Success" => "bg-success",
                                    "Rejected" => "bg-danger",
                                    "Scheduled" => "bg-warning",
                                    "On Hold" => "bg-warning",
                                    "Cancelled" => "bg-secondary",
                                    _ => "bg-secondary"
                                };
                            }

                            <span class="badge badge-dim @screeningBadgeClass">
                                @screeningStatus
                            </span>

                            @if (Model.ScreeningDate.HasValue)
                            {
                                <div class="mt-1">
                                    @(Model.ScreeningDate.Value.ToString("dd-MM-yyyy"))
                                </div>
                            }

                            @if (Model.StartTime.HasValue)
                            {
                                <div>
                                    @(Model.StartTime.Value.ToString(@"hh\:mm"))

                                    @if (Model.EndTime.HasValue)
                                    {
                                        <span>
                                            -
                                            @(Model.EndTime.Value.ToString(@"hh\:mm"))
                                        </span>
                                    }
                                </div>
                            }

                        </td>


                        <!-- ================================================= -->
                        <!-- PAYMENT -->
                        <!-- ================================================= -->

                        <td>

                            @if (!screeningSuccess)
                            {
                                <span class="badge badge-dim bg-secondary">
                                    Not Applicable
                                </span>
                            }
                            else if (!paymentPaid)
                            {
                                <a href="@Url.Content("~/Trainer/Trainer/Payment")"
                                   class="btn btn-sm btn-primary">

                                    <em class="icon ni ni-wallet"></em>

                                    Pay Now

                                </a>
                            }
                            else if (!paymentVerified)
                            {
                                <span class="badge badge-dim bg-warning">
                                    Verification Pending
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-dim bg-success">
                                    Payment Verified
                                </span>
                            }

                        </td>


                        <!-- ================================================= -->
                        <!-- FINANCE -->
                        <!-- ================================================= -->

                        <td>

                            @if (!paymentVerified)
                            {
                                <span class="badge badge-dim bg-secondary">
                                    Pending
                                </span>
                            }
                            else if (!financeApproved)
                            {
                                <span class="badge badge-dim bg-warning">
                                    Approval Pending
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-dim bg-success">
                                    Approved
                                </span>
                            }

                        </td>


                        <!-- ================================================= -->
                        <!-- BATCH -->
                        <!-- ================================================= -->

                        <td>

                            @if (batchAssigned)
                            {
                                <strong>
                                    @batchCode
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(batchName))
                                {
                                    <div class="small text-soft">
                                        @batchName
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="badge badge-dim bg-secondary">
                                    Not Assigned
                                </span>
                            }

                        </td>


                        <!-- ================================================= -->
                        <!-- ASSESSMENT -->
                        <!-- ================================================= -->

                        <td>
                            @if (resultUploaded)
                            {
                                <span class="badge badge-dim bg-success">
                                    Done
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-dim bg-warning">
                                    Pending
                                </span>
                            }
                        </td>
                        <td>

                            @if (!resultUploaded)
                            {
                                <span class="badge badge-dim bg-secondary">
                                    Result Pending
                                </span>
                            }
                            else if (!raiseReq)
                            {
                                <form action="/Trainer/Trainer/RaiseCertificateRequest"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-primary">

                                        <em class="icon ni ni-file-check"></em>
                                        Raise Certificate Request

                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="badge badge-dim bg-success me-1">

                                    <em class="icon ni ni-check-circle"></em>
                                    Request Raised

                                </span>

                                @if (certificateUploaded &&
                                                            !string.IsNullOrWhiteSpace(certificateFileName))
                                {
                                    <a href="@Url.Content(
                                                       "~/uploads/TrainerCertificates/"
                                                       + registrationNo
                                                       + "/"
                                                       + certificateFileName)"
                               download="@certificateFileName"
                               class="btn btn-sm btn-outline-primary">

                                        <em class="icon ni ni-download"></em>
                                        Download Certificate

                                    </a>
                                                        }
                                else
                                {
                                    <span class="badge badge-dim bg-warning ms-1">
                                        Certificate Pending
                                    </span>
                                }
                            }

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- SCREENING DETAILS -->
<!-- ========================================================= -->
@if (Model.ScreeningDate.HasValue)
{
    <div class="card card-bordered mt-4">

        <div class="card-inner">

            <h5 class="title mb-4">
                Screening Details
            </h5>

            <div class="row g-4">

                <!-- SCREENING DATE -->
                <div class="col-md-4">

                    <label class="form-label">
                        Screening Date
                    </label>

                    <div class="form-control">
                        @(Model.ScreeningDate.Value.ToString("dd-MMM-yyyy"))
                    </div>

                </div>


                <!-- SCREENING TIME -->
                <div class="col-md-4">

                    <label class="form-label">
                        Screening Time
                    </label>

                    <div class="form-control">

                        @if (Model.StartTime.HasValue)
                        {
                            @Model.StartTime.Value.ToString(@"hh\:mm")
                        }
                        else
                        {
                            <span>-</span>
                        }

                        @if (Model.EndTime.HasValue)
                        {
                            <span>
                                -
                                @Model.EndTime.Value.ToString(@"hh\:mm")
                            </span>
                        }

                    </div>

                </div>


                <!-- SCREENING MODE -->
                <div class="col-md-4">

                    <label class="form-label">
                        Screening Mode
                    </label>

                    <div class="form-control">
                        @(Model.ScreeningMode ?? "-")
                    </div>

                </div>


                <!-- ONLINE SCREENING -->
                @if (string.Equals(
                            Model.ScreeningMode,
                            "Online",
                            StringComparison.OrdinalIgnoreCase))
                {
                    <div class="col-md-12">

                        <label class="form-label">
                            Meeting Link
                        </label>

                        <div>

                            @if (!string.IsNullOrWhiteSpace(Model.MeetingLink))
                            {
                                <a href="@Model.MeetingLink"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-outline-primary">

                                    <em class="icon ni ni-external"></em>

                                    View Meeting Link

                                </a>
                            }
                            else
                            {
                                <span class="text-soft">
                                    Meeting link not available.
                                </span>
                            }

                        </div>

                    </div>
                }
                else
                {
                    <!-- OFFLINE SCREENING -->

                    <div class="col-md-12">

                        <label class="form-label">
                            Screening Location
                        </label>

                        <div class="form-control">
                            @(string.IsNullOrWhiteSpace(Model.Location)
                                                ? "-"
                                                : Model.Location)
                </div>

                    </div>
                        }


                <!-- SCREENING REMARKS -->
                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <div class="col-md-12">

                        <label class="form-label">
                            Screening Remarks
                        </label>

                        <div class="form-control">
                            @Model.Remarks
                        </div>

                    </div>
                }

            </div>

        </div>

    </div>
}