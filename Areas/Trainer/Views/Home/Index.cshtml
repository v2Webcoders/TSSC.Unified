@{
    Layout = "_Layout";
}

<div class="container py-4">

    <!-- ===================================================== -->
    <!-- WELCOME -->
    <!-- ===================================================== -->

    <div class="mb-4">

        <h1 class="fs-4 text-primary fw-bold mb-1">
            Welcome, Ravi 👋
        </h1>

        <p class="text-muted small mb-0">
            Track your trainer registration journey from here.
        </p>

    </div>


    <!-- ===================================================== -->
    <!-- APPLICATION JOURNEY -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h3 class="fs-6 text-primary fw-bold mb-4">
                Your Application — TOA-2026-00512
            </h3>


            <div class="d-flex align-items-center w-100">

                <!-- REGISTERED -->

                <div class="d-flex align-items-center flex-shrink-0">

                    <span class="rounded-circle bg-success text-white
                                 d-flex align-items-center justify-content-center
                                 fw-bold"
                          style="width:40px;height:40px;">

                        ✓

                    </span>

                    <div class="ms-3">

                        <div class="fw-semibold">
                            Registered
                        </div>

                        <div class="text-muted small">
                            20 Jul
                        </div>

                    </div>

                </div>


                <!-- LINE -->

                <div class="flex-grow-1 border-top mx-4"></div>


                <!-- SCREENING -->

                <div class="d-flex align-items-center flex-shrink-0">

                    <span class="rounded-circle bg-primary text-white
                                 d-flex align-items-center justify-content-center
                                 fw-bold"
                          style="width:40px;height:40px;">

                        2

                    </span>

                    <div class="ms-3">

                        <div class="fw-semibold text-primary">
                            Screening
                        </div>

                        <div class="text-muted small">
                            Awaiting schedule
                        </div>

                    </div>

                </div>


                <!-- LINE -->

                <div class="flex-grow-1 border-top mx-4"></div>


                <!-- PAYMENT -->

                <div class="d-flex align-items-center flex-shrink-0">

                    <span class="rounded-circle bg-light text-muted
                                 d-flex align-items-center justify-content-center
                                 fw-bold"
                          style="width:40px;height:40px;">

                        3

                    </span>

                    <div class="ms-3">

                        <div class="fw-semibold text-secondary">
                            Payment
                        </div>

                    </div>

                </div>


                <!-- LINE -->

                <div class="flex-grow-1 border-top mx-4"></div>


                <!-- CERTIFIED -->

                <div class="d-flex align-items-center flex-shrink-0">

                    <span class="rounded-circle bg-light text-muted
                                 d-flex align-items-center justify-content-center
                                 fw-bold"
                          style="width:40px;height:40px;">

                        4

                    </span>

                    <div class="ms-3">

                        <div class="fw-semibold text-secondary">
                            Certified
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- APPLICATION + WHAT'S NEXT -->
    <!-- ===================================================== -->

    <div class="row g-3">

        <!-- APPLICATION DETAILS -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h3 class="fs-6 text-primary fw-bold mb-4">
                        Application Details
                    </h3>


                    <div class="row g-4 small">

                        <div class="col-sm-6">

                            <span class="text-muted d-block mb-1">
                                Registering As
                            </span>

                            <span class="fw-semibold">
                                Trainer of Assessors (TOA)
                            </span>

                        </div>


                        <div class="col-sm-6">

                            <span class="text-muted d-block mb-1">
                                Sector
                            </span>

                            <span class="fw-semibold">
                                Optical Fibre
                            </span>

                        </div>


                        <div class="col-sm-6">

                            <span class="text-muted d-block mb-1">
                                Submitted On
                            </span>

                            <span class="fw-semibold">
                                20 Jul 2026
                            </span>

                        </div>


                        <div class="col-sm-6">

                            <span class="text-muted d-block mb-1">
                                Current Stage
                            </span>

                            <span class="fw-semibold text-warning-emphasis">
                                Screening — Awaiting Schedule
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- WHAT'S NEXT -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <h3 class="fs-6 text-primary fw-bold mb-3">
                        What's Next?
                    </h3>

                    <p class="small text-muted mb-0">

                        TSSC will schedule your screening shortly.
                        You'll receive a notification with the date,
                        time and venue or video link.

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>