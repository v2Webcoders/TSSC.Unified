@using QUIZAPP.Models
@using TSSC.Unified.Models
@model IEnumerable<JobRole>

@using Microsoft.AspNetCore.Identity
@using QUIZAPP
@inject AppdbContext Context
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";

    var status = ViewBag.Status?.ToString() ?? "Pending";
    var returnTo = ViewBag.ReturnTo?.ToString() ?? "Approval";
    string pageTitle = status switch
    {
        "Approved" => "Approved Job Roles",
        "Rejected" => "Rejected Job Roles",
        "ArchivePending" => "Pending Archive Approvals",
        "Archived" => "Archived Job Roles",
        _ => "Pending Job Approvals"
    };

    bool isEmployee = ViewBag.IsEmployee == true;
    int serial = 1;

    var currentUser = await UserManager.GetUserAsync(User);

    var roles = currentUser != null
        ? await UserManager.GetRolesAsync(currentUser)
        : new List<string>();
    var employee = currentUser != null
    ? Context.Employee.FirstOrDefault(
        x => x.ApplicationUserId == currentUser.Id)
    : null;

    bool isReportingManager = employee != null &&
        Context.Employee.Any(
            x => x.ReportingManagerId == employee.EmployeeId);
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                @pageTitle
            </h3>
        </div>

    </div>
</div>


<div class="nk-block nk-block-lg">

    <div class="card card-bordered">

        <div class="card-inner">

            <div class="table-responsive">

                <table class="datatable-init-export table table-tranx table_custom table-bordered dataTable no-footer dtr-inline collapsed">

                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>QP Code</th>
                            <th>Job Role Title</th>
                            <th>QP Version</th>
                            <th>NSQF Level</th>
                            <th>QP Hours</th>
                            <th>Valid From</th>
                            <th>Valid To</th>
                             <th>Remark</th>
                            <th>Status</th>

                            
                                <th>Action</th>
                            
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>@serial</td>

                                    <td>@item.QPCode</td>

                                    <td>@item.JobRoleTitle</td>

                                    <td>@item.QPVersion</td>

                                    <td>@item.NSQFLevel</td>

                                    <td>@item.QPHours</td>

                                    <td>
                                        @item.ValidFrom?.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @item.ValidTo?.ToString("dd-MM-yyyy")
                                    </td>
                                    <td>
                                        @item.Remark
                                    </td>
                                    <!-- STATUS -->
                                    <td>
                                        @if (item.Status == "Approved")
                                        {
                                            <span class="text-success">
                                                <span class="dot bg-success"></span>
                                                Approved
                                            </span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="text-danger">
                                                <span class="dot bg-danger"></span>
                                                Rejected
                                            </span>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <span class="text-warning">
                                                <span class="dot bg-warning"></span>
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                @item.Status
                                            </span>
                                        }
                                    </td>
                                    <!-- ACTION -->
                                    <td>

                                        <div class="btn-group" role="group">

                                            <!-- VIEW - Employee + Manager -->
                                            <a asp-area="HRMS"
                                               asp-controller="JobRoles"
                                               asp-action="Details"
                                               asp-route-id="@item.Id"
                                               asp-route-returnTo="@returnTo"
                                               asp-route-status="@ViewBag.Status"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View">

                                                <em class="icon ni ni-eye"></em>

                                            </a>


                                            <!-- ================= MANAGER ACTIONS ================= -->
                                            @if (!isEmployee)
                                            {
                                                @if (item.Status == "Pending")
                                                {
                                                    <form method="post" class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <input type="text"
                                                               name="remark"
                                                               class="form-control form-control-sm d-inline-block"
                                                               style="width: 200px;"
                                                               placeholder="Enter remark" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success"
                                                                title="Approve"
                                                                formaction="@Url.Action(
                                                                                                "Approve",
                                                                                                "JobRoles",
                                                                                                new { area = "HRMS", id = item.Id })">

                                            <em class="icon ni ni-check"></em>

                                                        </button>

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                title="Reject"
                                                                formaction="@Url.Action(
                                                                                "Reject",
                                                                                "JobRoles",
                                                                                new { area = "HRMS", id = item.Id })"
                                                onclick="return confirm('Are you sure you want to reject this Job Role?');">

                                                            <em class="icon ni ni-cross"></em>

                                                        </button>

                                                    </form>
                                                 }
                                                @* ARCHIVE APPROVAL *@
                                                @if (item.Status == "Archive Pending")
                                                {
                                                    <form method="post" class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <input type="text"
                                                               name="remark"
                                                               class="form-control form-control-sm d-inline-block"
                                                               style="width: 200px;"
                                                               placeholder="Enter remark" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success"
                                                                title="Approve Archive"
                                                                formaction="@Url.Action(
                                                                                        "ApproveArchive",
                                                                                        "JobRoles",
                                                                                        new { area = "HRMS", id = item.Id })">

                                            <em class="icon ni ni-check"></em>

                                                        </button>

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                title="Reject Archive"
                                                                formaction="@Url.Action(
                                                                        "RejectArchive",
                                                                        "JobRoles",
                                                                        new { area = "HRMS", id = item.Id })"
                                                onclick="return confirm('Are you sure you want to reject this Archive request?');">

                                                            <em class="icon ni ni-cross"></em>

                                                        </button>

                                                    </form>
                                                                        }
                                            }





                                            <!-- ================= EMPLOYEE ACTIONS ================= -->
                                            @if (isEmployee)
                                            {
                                                <!-- ================= ARCHIVE ================= -->
                                                @if (item.Status == "Approved" && item.IsActive)
                                                {
                                                    <form asp-area="HRMS"
                                                          asp-controller="JobRoles"
                                                          asp-action="Archive"
                                                          asp-route-id="@item.Id"
                                                          method="post"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-warning"
                                                                title="Archive"
                                                                onclick="return confirm('Are you sure you want to archive this Job Role?');">
                                                            <em class="icon ni ni-archive"></em>
                                                        </button>

                                                    </form>
                                                }


                                                <!-- ================= REOPEN ================= -->
                                                @if (item.Status == "Rejected" && item.IsActive)
                                                {
                                                    <form asp-area="HRMS"
                                                          asp-controller="JobRoles"
                                                          asp-action="Reopen"
                                                          asp-route-id="@item.Id"
                                                          method="post"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-warning"
                                                                title="Reopen"
                                                                onclick="return confirm('Are you sure you want to reopen this Job Role?');">

                                                            <em class="icon ni ni-reload"></em>

                                                        </button>

                                                    </form>
                                                }


                                                <!-- ================= RESTORE ================= -->
                                                @if (item.Status == "Archived" && !item.IsActive)
                                                {
                                                    <form asp-area="HRMS"
                                                          asp-controller="JobRoles"
                                                          asp-action="Restore"
                                                          asp-route-id="@item.Id"
                                                          method="post"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success"
                                                                title="Restore"
                                                                onclick="return confirm('Are you sure you want to restore this Job Role?');">

                                                            <em class="icon ni ni-reload"></em>

                                                        </button>

                                                    </form>
                                                }
                                            }
                                        </div>

                                    </td>
                                </tr>

                                serial++;
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
