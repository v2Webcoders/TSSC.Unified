@using TSSC.Unified.Models
@model IEnumerable<AttendanceRegularization>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Attendance Regularization Requests";
    int serial = 1;
}

<!-- ========================================= -->
<!-- PAGE HEADER -->
<!-- ========================================= -->

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between">

        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
               All Regularizations
            </h3>

        </div>


        <div class="nk-block-head-content">

            <div class="toggle-wrap nk-block-tools-toggle">

                <a href="#"
                   class="btn btn-icon btn-trigger toggle-expand me-n1"
                   data-target="pageMenu">

                    <em class="icon ni ni-more-v"></em>

                </a>


                <div class="toggle-expand-content"
                     data-content="pageMenu">

                    <ul class="nk-block-tools g-3">

                       @*  <li class="nk-block-tools-opt">

                            <a asp-action="MyRegularizations"
                               class="btn btn-primary">

                                <em class="icon ni ni-list"></em>

                                <span>
                                    My Regularizations
                                </span>

                            </a>

                        </li> *@

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ========================================= -->
<!-- STATUS FILTERS -->
<!-- ========================================= -->

<div class="mb-4">

    <ul class="nav nav-tabs">

        <li class="nav-item">

            <a asp-action="AllRegularizations"
               asp-route-status="Pending"
               class="nav-link @(ViewBag.Status == "Pending" ? "active" : "")">

                Pending

                <span class="badge bg-warning ms-1">
                    @ViewBag.PendingCount
                </span>

            </a>

        </li>


        <li class="nav-item">

            <a asp-action="AllRegularizations"
               asp-route-status="Approved"
               class="nav-link @(ViewBag.Status == "Approved" ? "active" : "")">

                Approved

                <span class="badge bg-success ms-1">
                    @ViewBag.ApprovedCount
                </span>

            </a>

        </li>


        <li class="nav-item">

            <a asp-action="AllRegularizations"
               asp-route-status="Rejected"
               class="nav-link @(ViewBag.Status == "Rejected" ? "active" : "")">

                Rejected

                <span class="badge bg-danger ms-1">
                    @ViewBag.RejectedCount
                </span>

            </a>

        </li>

    </ul>

</div>

<!-- ========================================= -->
<!-- REQUEST TABLE -->
<!-- ========================================= -->

<div class="nk-block nk-block-lg">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }
    <div class="card card-preview">

        <div class="card-inner">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <button type="button"
                            class="btn btn-sm btn-success"
                            id="bulkApproveBtn">
                        <em class="icon ni ni-check-circle"></em>
                        Approve Selected
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-danger"
                            id="bulkRejectBtn">
                        <em class="icon ni ni-cross-circle"></em>
                        Reject Selected
                    </button>
                    <span class="ms-2 text-muted">
                        <span id="selectedCount">0</span> selected
                    </span>
                </div>
            </div>

            <form asp-action="BulkApproveRegularization"
                  method="post"
                  id="bulkRegularizationForm">
                <div id="selectedIdsContainer"></div>
            </form>
            <form asp-action="BulkRejectRegularization"
                  method="post"
                  id="bulkRejectForm">

                <div id="selectedRejectIdsContainer"></div>

            </form>
            <div class="table-responsive">
                <table class="datatable-init-export table table-tranx table_custom table-bordered" data-auto-responsive="false">
                    <thead>
                        <tr>
                            <th width="40" data-orderable="false">
                                <input type="checkbox"
                                       id="selectAllRegularization" />
                            </th>

                            <th width="60">
                                S.No.
                            </th>

                            <th>
                                Employee
                            </th>

                            <th>
                                Attendance Date
                            </th>

                            <th>
                                Existing In
                            </th>

                            <th>
                                Existing Out
                            </th>

                            <th>
                                Requested In
                            </th>

                            <th>
                                Requested Out
                            </th>

                            <th>
                                Reason
                            </th>

                            <th>
                                Status
                            </th>

                            <th width="130">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <input type="checkbox"
                                               class="regularization-checkbox"
                                               value="@item.RegularizationId" />
                                    }
                                </td>
                                <!-- ================================= -->
                                <!-- SERIAL -->
                                <!-- ================================= -->

                                <td>
                                    @serial
                                </td>


                                <!-- ================================= -->
                                <!-- EMPLOYEE -->
                                <!-- ================================= -->

                                <td style="min-width:120px;">

                                    <strong>
                                        @(item.Employee?.FirstName) @(item.Employee?.LastName)
                                    </strong>

                                    <br />

                                    <small class="text-muted">
                                        @item.Employee?.EmployeeCode
                                    </small>

                                </td>


                                <!-- ================================= -->
                                <!-- ATTENDANCE DATE -->
                                <!-- ================================= -->

                                <td>

                                    @(item.AttendanceDate
                                        .ToString("dd-MMM-yyyy"))

                                </td>


                                <!-- ================================= -->
                                <!-- EXISTING IN -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.ExistingInTime.HasValue)
                                    {
                                        @(item.ExistingInTime?.ToString("hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- EXISTING OUT -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.ExistingOutTime.HasValue)
                                    {
                                        @(item.ExistingOutTime?.ToString("hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            Missing
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- REQUESTED IN -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.RequestedInTime.HasValue)
                                    {
                                        @(item.RequestedInTime?.ToString("hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- REQUESTED OUT -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.RequestedOutTime.HasValue)
                                    {
                                        @(item.RequestedOutTime?.ToString("hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- REASON -->
                                <!-- ================================= -->

                                <td>

                                    @(string.IsNullOrEmpty(item.Reason)
                                        ? "-"
                                        : (item.Reason.Length > 50
                                            ? item.Reason.Substring(0, 50) + "..."
                                            : item.Reason))

                                    @if (!string.IsNullOrEmpty(item.Attachment))
                                    {
                                        <br />

                                        <a href="~/uploads/attendance/@item.Attachment"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary mt-1">

                                            <em class="icon ni ni-file-text"></em>

                                            Attachment

                                        </a>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- STATUS -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge badge-dot bg-success">
                                            Approved
                                        </span>

                                        <br />

                                        <small class="text-muted">

                                            @(item.ApprovedDate?
                                                .ToString("dd-MMM-yyyy hh:mm"))

                                        </small>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge badge-dot bg-danger">
                                            Rejected
                                        </span>

                                        <br />

                                        <small class="text-muted">

                                            @(item.ApprovedDate?
                                                .ToString("dd-MMM-yyyy hh:mm"))

                                        </small>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dot bg-warning">
                                            Pending
                                        </span>

                                        <br />

                                        <small class="text-muted">

                                            Applied: @(item.CreatedDate.ToString("dd-MMM-yyyy hh:mm"))

                                        </small>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- ACTION -->
                                <!-- ================================= -->

                                <td>

                                    <div class="btn-group">

                                        @if (item.Status == "Pending")
                                        {
                                            <!-- APPROVE -->

                                            <a asp-action="ApproveRegularization"
                                               asp-route-id="@item.RegularizationId"
                                               class="btn btn-sm btn-outline-success"
                                               title="Approve"
                                               onclick="return confirm('Are you sure you want to approve this attendance regularization request?');">
                                                <em class="icon ni ni-check"></em>
                                            </a>


                                            <!-- REJECT -->

                                            <a asp-action="RejectRegularization"
                                               asp-route-id="@item.RegularizationId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Reject"
                                               onclick="return confirm('Are you sure you want to reject this attendance regularization request?');">
                                                <em class="icon ni ni-cross"></em>
                                            </a>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <!-- ALLOW MANAGER TO REJECT APPROVED REQUEST -->

                                            <a asp-action="RejectRegularization"
                                               asp-route-id="@item.RegularizationId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Reject"
                                               onclick="return confirm('This request is already approved. Do you want to change its status to Rejected?');">
                                                <em class="icon ni ni-cross"></em>
                                            </a>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <!-- ALLOW MANAGER TO APPROVE REJECTED REQUEST -->

                                            <a asp-action="ApproveRegularization"
                                               asp-route-id="@item.RegularizationId"
                                               class="btn btn-sm btn-outline-success"
                                               title="Approve"
                                               onclick="return confirm('This request is already rejected. Do you want to change its status to Approved?');">
                                                <em class="icon ni ni-check"></em>
                                            </a>
                                        }
                                    </div>

                                </td>

                            </tr>

                            serial++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@section Scripts {
    <script>

        let selectedRegularizations = new Set();


        // ==========================================
        // INDIVIDUAL CHECKBOX
        // ==========================================

        $(document).on(
            'change',
            '.regularization-checkbox',
            function () {

                const id = $(this).val();

                if ($(this).is(':checked')) {

                    selectedRegularizations.add(id);

                } else {

                    selectedRegularizations.delete(id);
                }

                updateSelectedCount();
                updateSelectAll();
            }
        );


        // ==========================================
        // SELECT ALL CURRENT PAGE
        // ==========================================

        $(document).on(
            'change',
            '#selectAllRegularization',
            function () {

                const checked = $(this).is(':checked');

                $('.regularization-checkbox').each(function () {

                    const id = $(this).val();

                    $(this).prop('checked', checked);

                    if (checked) {

                        selectedRegularizations.add(id);

                    } else {

                        selectedRegularizations.delete(id);
                    }

                });

                updateSelectedCount();
            }
        );


        // ==========================================
        // DATATABLE PAGE CHANGE
        // ==========================================

        $('.datatable-init-export').on(
            'draw.dt',
            function () {

                $('.regularization-checkbox').each(function () {

                    const id = $(this).val();

                    $(this).prop(
                        'checked',
                        selectedRegularizations.has(id)
                    );

                });

                updateSelectedCount();
                updateSelectAll();
            }
        );


        // ==========================================
        // UPDATE COUNT
        // ==========================================

        function updateSelectedCount() {

            $('#selectedCount').text(
                selectedRegularizations.size
            );
        }


        // ==========================================
        // UPDATE SELECT ALL
        // ==========================================

        function updateSelectAll() {

            const checkboxes =
                $('.regularization-checkbox');

            if (checkboxes.length === 0) {

                $('#selectAllRegularization')
                    .prop('checked', false)
                    .prop('indeterminate', false);

                return;
            }

            const checked =
                checkboxes.filter(':checked').length;

            $('#selectAllRegularization').prop(
                'checked',
                checked === checkboxes.length
            );

            $('#selectAllRegularization').prop(
                'indeterminate',
                checked > 0 &&
                checked < checkboxes.length
            );
        }


        // ==========================================
        // BULK APPROVE BUTTON
        // ==========================================

        $('#bulkApproveBtn').on('click', function () {

            console.log(
                'Selected IDs:',
                Array.from(selectedRegularizations)
            );


            // No selection
            if (selectedRegularizations.size === 0) {

                alert(
                    'Please select at least one pending regularization request.'
                );

                return;
            }


            // Confirmation
            if (!confirm(
                'Are you sure you want to approve ' +
                selectedRegularizations.size +
                ' selected regularization request(s)?'
            )) {

                return;
            }


            // Clear previous hidden inputs
            $('#selectedIdsContainer').empty();


            // Create hidden input for every selected ID
            selectedRegularizations.forEach(function (id) {

                $('#selectedIdsContainer').append(
                    $('<input>', {
                        type: 'hidden',
                        name: 'selectedIds',
                        value: id
                    })
                );

            });


            // Submit
            $('#bulkRegularizationForm').submit();

        });


         // ==========================================
        // BULK REJECT BUTTON
        // ==========================================

                $('#bulkRejectBtn').on('click', function () {

            if (selectedRegularizations.size === 0) {

                alert(
                    'Please select at least one pending regularization request.'
                );

                return;
            }

            if (!confirm(
                'Are you sure you want to reject ' +
                selectedRegularizations.size +
                ' selected regularization request(s)?'
            )) {
                return;
            }

            // Clear previous hidden inputs
            $('#selectedRejectIdsContainer').empty();


            // Add selected IDs
            selectedRegularizations.forEach(function (id) {

                $('#selectedRejectIdsContainer').append(
                    $('<input>', {
                        type: 'hidden',
                        name: 'selectedIds',
                        value: id
                    })
                );

            });


            // Submit
            $('#bulkRejectForm').submit();

        });
    </script>
}


