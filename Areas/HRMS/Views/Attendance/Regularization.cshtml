@using TSSC.Unified.Models
@model AttendanceRegularization

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	Layout = "_Layout";
	ViewData["Title"] = "";
}

<div class="nk-block-head nk-block-head-sm">
	<div class="nk-block-between">
		<div class="nk-block-head-content">
			<h3 class="nk-block-title page-title">Attendance Regularization</h3>
			<div class="nk-block-des text-soft">
				<p>Request correction for missing or incorrect attendance.</p>
			</div>
		</div><!-- .nk-block-head-content -->
		<div class="nk-block-head-content">
			<a asp-action="MyRegularizations"
			   asp-controller="Attendance"
			   class="btn btn-primary d-none d-md-inline-flex">
				<em class="icon ni ni-edit-alt"></em>&nbsp;
				My Regularizations
			</a>
		</div><!-- .nk-block-head-content -->
	</div><!-- .nk-block-between -->
</div>
<div class="nk-block nk-block-lg">
	<div class="card card-preview">
		
		<div class="card-inner">
			<div class="preview-block">
				<div class="row gy-4">
                    <form asp-action="Regularization"
                          asp-controller="Attendance"
                          asp-area="HRMS"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All"
                                 class="alert alert-danger">
                            </div>
                        }
                        <div class="row g-4">

                            <!-- ================================ -->
                            <!-- ATTENDANCE DATE -->
                            <!-- ================================ -->

                           @*  <div class="col-md-6">

                                <label asp-for="AttendanceDate"
                                       class="form-label">
                                    Attendance Date
                                </label>

                                <input asp-for="AttendanceDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="AttendanceDate"
                                      class="text-danger">
                                </span>

                            </div> *@
                            <div class="col-md-6">

                                <label class="form-label">
                                    Attendance Date
                                </label>

                                <div class="form-control bg-light">
                                    <span id="displayDate">
                                        @(Model.AttendanceDate != default(DateTime)
                                            ? Model.AttendanceDate.ToString("dd MMM yyyy")
                                            : "—")
                                    </span>
                                </div>

                                <!-- Hidden input to submit the value -->
                                <input asp-for="AttendanceDate"
                                       type="hidden" />

                                <span asp-validation-for="AttendanceDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- ================================ -->
                            <!-- EXISTING ATTENDANCE -->
                            <!-- ================================ -->

                            <div class="col-12">

                                <div class="card card-bordered">

                                    <div class="card-inner">

                                        <div class="d-flex justify-content-between align-items-center mb-3">

                                            <h6 class="title mb-0">
                                                Existing Attendance
                                            </h6>

                                            <span class="badge @(Model.ExistingInTime.HasValue && Model.ExistingOutTime.HasValue ? "bg-success" : "bg-warning")">
                                                @(Model.ExistingInTime.HasValue && Model.ExistingOutTime.HasValue ? "Complete" : "Incomplete")
                                            </span>

                                        </div>

                                        <div class="row g-3">

                                            <!-- EXISTING IN -->

                                            <div class="col-md-6">

                                                <label class="form-label text-soft">
                                                    Existing In Time
                                                </label>

                                                <div class="form-control bg-light @(!Model.ExistingInTime.HasValue ? "border-warning" : "")">
                                                    <strong>
                                                        @(Model.ExistingInTime.HasValue
                                                            ? Model.ExistingInTime.Value.ToString("dd MMM yyyy, hh:mm tt")
                                                            : "No In Time")
                                                    </strong>
                                                </div>

                                            </div>


                                            <!-- EXISTING OUT -->

                                            <div class="col-md-6">

                                                <label class="form-label text-soft">
                                                    Existing Out Time
                                                </label>

                                                <div class="form-control bg-light @(!Model.ExistingOutTime.HasValue ? "border-warning" : "")">
                                                    <strong>
                                                        @(Model.ExistingOutTime.HasValue
                                                            ? Model.ExistingOutTime.Value.ToString("dd MMM yyyy, hh:mm tt")
                                                            : "No Out Time")
                                                    </strong>
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================ -->
                            <!-- REGULARIZATION TYPE -->
                            <!-- ================================ -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Regularization Type
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="RegularizationType"
                                        id="regularizationType"
                                        class="form-select">
                                    <option value="">Select Regularization Type</option>
                                    <option value="Both">In Time & Out Time</option>
                                    <option value="In">In Time</option>
                                    <option value="Out">Out Time</option>
                                </select>

                                <span asp-validation-for="RegularizationType"
                                      class="text-danger"></span>

                            </div>


                            <!-- ================================ -->
                            <!-- REQUESTED IN -->
                            <!-- ================================ -->

                            <div class="col-md-6 regularization-field"
                                 id="requestedInContainer"
                                 style="display:none;">

                                <label asp-for="RequestedInTime"
                                       class="form-label">

                                    Requested In Time
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="RequestedInTime"
                                       type="time"
                                       class="form-control" />

                                <span asp-validation-for="RequestedInTime"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ================================ -->
                            <!-- REQUESTED OUT -->
                            <!-- ================================ -->

                            <div class="col-md-6 regularization-field"
                                 id="requestedOutContainer"
                                 style="display:none;">

                                <label asp-for="RequestedOutTime"
                                       class="form-label">

                                    Requested Out Time
                                    <span class="text-danger">*</span>

                                </label>

                                @* <input asp-for="RequestedOutTime"
                                       type="datetime-local"
                                       class="form-control" /> *@
                                <input asp-for="RequestedOutTime"
                                       type="time"
                                       class="form-control" />
                                <span asp-validation-for="RequestedOutTime"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ================================ -->
                            <!-- REASON -->
                            <!-- ================================ -->

                            <div class="col-12">

                                <label asp-for="Reason"
                                       class="form-label">

                                    Reason
                                    <span class="text-danger">*</span>

                                </label>

                                <textarea asp-for="Reason"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Explain why attendance needs to be regularized..."
                                          required></textarea>

                                <span asp-validation-for="Reason"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ================================ -->
                            <!-- ATTACHMENT -->
                            <!-- ================================ -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Supporting Document
                                </label>

                                <input type="file"
                                       name="AttachmentFile"
                                       class="form-control"
                                       accept=".pdf,.jpg,.jpeg,.png" />

                                <div class="form-note">
                                    PDF, JPG, JPEG or PNG
                                </div>

                            </div>

                        </div>


                        <!-- ================================ -->
                        <!-- INFORMATION -->
                        <!-- ================================ -->

                        <div class="alert alert-info mt-4">

                            <div class="d-flex gap-2">

                                <em class="icon ni ni-info"></em>

                                <div>
                                    Your request will be sent to your reporting manager
                                    for approval. Attendance will be updated only after approval.
                                </div>

                            </div>

                        </div>


                        <!-- ================================ -->
                        <!-- BUTTONS -->
                        <!-- ================================ -->

                        <div class="col-12 mt-4">

                            <a asp-action="MyAttendance"
                               asp-route-mode="regularization"
                               class="btn btn-light">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <em class="icon ni ni-send me-1"></em>

                                Submit Request

                            </button>

                        </div>

                    </form>
				</div>
			</div>
		</div>
	</div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const type = document.getElementById("regularizationType");

        const inContainer =
            document.getElementById("requestedInContainer");

        const outContainer =
            document.getElementById("requestedOutContainer");

        const inInput =
            document.getElementById("RequestedInTime");

        const outInput =
            document.getElementById("RequestedOutTime");


        function updateFields() {

            // Hide both initially
            inContainer.style.display = "none";
            outContainer.style.display = "none";

            inInput.required = false;
            outInput.required = false;


            // In + Out
            if (type.value === "Both") {

                inContainer.style.display = "block";
                outContainer.style.display = "block";

                inInput.required = true;
                outInput.required = true;
            }


            // In only
            else if (type.value === "In") {

                inContainer.style.display = "block";

                inInput.required = true;
            }


            // Out only
            else if (type.value === "Out") {

                outContainer.style.display = "block";

                outInput.required = true;
            }
        }


        type.addEventListener("change", updateFields);

        updateFields();

    });
</script>

