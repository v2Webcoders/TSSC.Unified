@using TSSC.Unified.Models
@using TSSC.Unified.ViewModel
@model List<TSSC.Unified.Models.EmployeeAttendance>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	Layout = "_Layout";
	ViewData["Title"] = "Employee Attendance";
}

<div class="nk-block-head">
	<div class="nk-block-between">
		<div class="nk-block-head-content">
			<h3 class="nk-block-title page-title">
				Employee Attendance
			</h3>

			<div class="nk-block-des text-soft">
				<p>
					View employee attendance and synchronize
					biometric records.
				</p>
			</div>
		</div>
	</div>
</div>

<!-- ========================================================= -->
<!-- SUCCESS / ERROR MESSAGE -->
<!-- ========================================================= -->
@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show"
		 role="alert">

		<strong>Success!</strong>
		@TempData["Success"]

		<button type="button"
				class="btn-close"
				data-bs-dismiss="alert"
				aria-label="Close">
		</button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show"
		 role="alert">

		<strong>Error!</strong>
		@TempData["Error"]

		<button type="button"
				class="btn-close"
				data-bs-dismiss="alert"
				aria-label="Close">
		</button>
	</div>
}


<!-- ========================================================= -->
<!-- BIOMETRIC SYNC CARD -->
<!-- ========================================================= -->
<!-- ========================================================= -->
<!-- BIOMETRIC SYNC CARD -->
<!-- ========================================================= -->

<div class="card mb-4">
	<div class="card-inner">

		<div class="row align-items-end g-4">

			<!-- Heading -->
			<div class="col-lg-5 col-md-12">

				<h5 class="mb-1">
					<em class="icon ni ni-update me-1"></em>
					Biometric Attendance Sync
				</h5>

				<p class="text-soft mb-0">
					Import attendance records from the biometric
					device into HRMS.
				</p>

			</div>


			<!-- Sync Form -->
			<div class="col-lg-7 col-md-12">

				<form asp-area="HRMS"
					  asp-controller="Attendance"
					  asp-action="Sync"
					  method="post">

					@Html.AntiForgeryToken()

					<div class="row g-3 align-items-end">

						<!-- From Date -->
						<div class="col-md-4">

							<label class="form-label">
								From Date
							</label>

							<input type="date"
								   name="fromDate"
								   class="form-control"
								   value="@DateTime.Today.ToString("yyyy-MM-dd")"
								   required />

						</div>


						<!-- To Date -->
						<div class="col-md-4">

							<label class="form-label">
								To Date
							</label>

							<input type="date"
								   name="toDate"
								   class="form-control"
								   value="@DateTime.Today.ToString("yyyy-MM-dd")"
								   required />

						</div>


						<!-- Sync Button -->
						<div class="col-md-4">

							<button type="submit"
									class="btn btn-primary w-100">

								<em class="icon ni ni-update me-1"></em>
								Sync Biometric

							</button>

						</div>

					</div>

				</form>

			</div>

		</div>

	</div>
</div>

<br /><br />
<!-- ========================================================= -->
<!-- ATTENDANCE TABLE -->
<!-- ========================================================= -->

<div class="card">

	<div class="card-inner">

		<div class="d-flex flex-wrap
                    justify-content-between
                    align-items-center mb-3">

			<div>
				<h5 class="card-title mb-1">
					Attendance Records
				</h5>

				<p class="text-soft mb-0">
					Employee attendance synchronized from
					biometric devices.
				</p>
			</div>

			<span class="badge bg-primary">
				@Model.Count Records
			</span>

		</div>


		@if (Model == null || !Model.Any())
		{
			<!-- ================================================= -->
			<!-- NO RECORDS -->
			<!-- ================================================= -->

			<div class="text-center py-5">

				<em class="icon ni ni-calendar-alt"
					style="font-size: 45px;
                           color: #C9CED6;">
				</em>

				<h6 class="mt-3 mb-1">
					No Attendance Records
				</h6>

				<p class="text-soft mb-0">
					No employee attendance records are available.
				</p>

			</div>
		}
		else
		{
			<!-- ================================================= -->
			<!-- TABLE -->
			<!-- ================================================= -->

			<div class="table-responsive">

				<table class="datatable-init-export table table-tranx table_custom table-bordered">

					<thead>

						<tr>

							<th>
								#
							</th>

							<th>
								Employee Code
							</th>

							<th>
								Employee
							</th>

							<th>
								Attendance Date
							</th>

							<th>
								In Time
							</th>

							<th>
								Out Time
							</th>

							<th>
								Status
							</th>

							<th>
								Source
							</th>

							<th>
								Remarks
							</th>

						</tr>

					</thead>


					<tbody>

						@{
							int serialNo = 1;
						}

						@foreach (var item in Model)
						{
							<tr>

								<!-- Serial Number -->
								<td>
									@serialNo
								</td>


								<!-- Employee Code -->
								<td>
									<span class="fw-semibold">
										@item.EmployeeCode
									</span>
								</td>


								<!-- Employee Name -->
								<td>
									@if (item.Employee != null)
									{
										@($"{item.Employee.FirstName} {item.Employee.LastName}")
									}
									else
									{
										<span class="text-muted">
											-
										</span>
									}
								</td>


								<!-- Attendance Date -->
								<td>
									@item.AttendanceDate.ToString("dd-MM-yyyy")
								</td>


								<!-- In Time -->
								<td>
									@if (item.InTime.HasValue)
									{
										<span>
											@item.InTime.Value.ToString("hh:mm tt")
										</span>
									}
									else
									{
										<span class="text-muted">
											-
										</span>
									}
								</td>


								<!-- Out Time -->
								<td>
									@if (item.OutTime.HasValue)
									{
										<span>
											@item.OutTime.Value.ToString("hh:mm tt")
										</span>
									}
									else
									{
										<span class="text-warning">
											-
										</span>
									}
								</td>


								<!-- Status -->
								<td>

									@if (item.AttendanceStatus == "Present")
									{
										<span class="badge bg-success">
											Present
										</span>
									}
									else if (item.AttendanceStatus == "Missing Punch")
									{
										<span class="badge bg-warning">
											Missing Punch
										</span>
									}
									else if (item.AttendanceStatus == "Absent")
									{
										<span class="badge bg-danger">
											Absent
										</span>
									}
									else
									{
										<span class="badge bg-secondary">
											@item.AttendanceStatus
										</span>
									}

								</td>


								<!-- Source -->
								<td>

									@if (item.AttendanceSource == "Biometric")
									{
										<span class="badge bg-primary">
											<em class="icon ni ni-scan me-1"></em>
											Biometric
										</span>
									}
									else
									{
										<span class="badge bg-secondary">
											@item.AttendanceSource
										</span>
									}

								</td>


								<!-- Remarks -->
								<td>
									@if (!string.IsNullOrWhiteSpace(item.Remarks))
									{
										<span>
											@item.Remarks
										</span>
									}
									else
									{
										<span class="text-muted">
											-
										</span>
									}
								</td>

							</tr>

							serialNo++;
						}

					</tbody>

				</table>

			</div>
		}

	</div>

</div>



