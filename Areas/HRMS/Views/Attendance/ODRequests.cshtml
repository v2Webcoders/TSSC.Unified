@using TSSC.Unified.Models
@model IEnumerable<ODRequest>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    int serial = 1;
}

<!-- ========================================= -->
<!-- PAGE HEADER -->
<!-- ========================================= -->

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between">

        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                OD Requests
            </h3>

            <div class="nk-block-des text-soft">
                <p>Review and manage OD requests submitted by your team.</p>
            </div>

        </div>


        <div class="nk-block-head-content">

            <div class="toggle-wrap nk-block-tools-toggle">

                <a href="#"
                   class="btn btn-icon btn-trigger toggle-expand me-n1"
                   data-target="pageMenu">

                    <em class="icon ni ni-more-v"></em>

                </a>

                <div class="toggle-expand-content"
                     data-content="pageMenu">

                    <ul class="nk-block-tools g-3">

                        <li class="nk-block-tools-opt">

                            <a asp-action="ODRequests"
                               class="btn btn-primary">

                                <em class="icon ni ni-reload me-1"></em>

                                <span>
                                    Refresh
                                </span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================= -->
<!-- SUCCESS / ERROR MESSAGE -->
<!-- ========================================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4"
         role="alert">

        <em class="icon ni ni-check-circle me-1"></em>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4"
         role="alert">

        <em class="icon ni ni-alert-circle me-1"></em>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ========================================= -->
<!-- REQUEST TABLE -->
<!-- ========================================= -->
<!-- ========================================= -->
<!-- STATUS FILTERS -->
<!-- ========================================= -->


<div class="mb-4">

    <ul class="nav nav-tabs">

        <!-- Pending -->
        <li class="nav-item">

            <a asp-action="ODRequests"
               asp-route-status="Pending"
               class="nav-link @(ViewBag.Status == "Pending" ? "active" : "")">

                Pending

                <span class="badge bg-warning ms-1">
                    @ViewBag.PendingCount
                </span>

            </a>

        </li>


        <!-- Approved -->
        <li class="nav-item">

            <a asp-action="ODRequests"
               asp-route-status="Approved"
               class="nav-link @(ViewBag.Status == "Approved" ? "active" : "")">

                Approved

                <span class="badge bg-success ms-1">
                    @ViewBag.ApprovedCount
                </span>

            </a>

        </li>


        <!-- Rejected -->
        <li class="nav-item">

            <a asp-action="ODRequests"
               asp-route-status="Rejected"
               class="nav-link @(ViewBag.Status == "Rejected" ? "active" : "")">

                Rejected

                <span class="badge bg-danger ms-1">
                    @ViewBag.RejectedCount
                </span>

            </a>

        </li>

    </ul>

</div>
<div class="nk-block nk-block-lg">

    <div class="card card-preview">

        <div class="card-inner">
            <form asp-action="BulkApproveManagerOD"
                  method="post"
                  id="bulkApproveODForm">

                @Html.AntiForgeryToken()

                <div class="d-flex align-items-center mb-3">

                    <button type="submit"
                            class="btn btn-success"
                            id="approveSelectedODBtn"
                            disabled>

                        <em class="icon ni ni-check"></em>
                        Approve Selected

                    </button>

                    <span class="text-muted ms-3">
                        Selected:
                        <strong id="selectedODCount">0</strong>
                    </span>

                </div>

            </form>
            <div class="table-responsive">
                


                <table class="datatable-init-export table table-tranx table_custom table-bordered" data-auto-responsive="false">

                    <thead>

                        <tr>
                            <th width="40"
                                data-orderable="false"
                                data-searchable="false">

                                <input type="checkbox"
                                       id="selectAllOD" />

                            </th>
                            <th width="60">
                                S.No.
                            </th>

                            <th>
                                Employee
                            </th>

                            <th>
                                OD Date
                            </th>

                            <th>
                                OD Type
                            </th>

                            <th>
                                From
                            </th>

                            <th>
                                To
                            </th>

                            <th>
                                Location
                            </th>

                            <th>
                                Purpose
                            </th>

                            <th>
                                Reason
                            </th>

                            <th>
                                Attachment
                            </th>

                            <th>
                                Status
                            </th>

                            <th width="130">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <input type="checkbox"
                                                   class="od-checkbox"
                                                   value="@item.ODRequestId" />
                                        }
                                    </td>
                                    <!-- ================================= -->
                                    <!-- SERIAL -->
                                    <!-- ================================= -->

                                    <td>
                                        @serial
                                    </td>


                                    <!-- ================================= -->
                                    <!-- EMPLOYEE -->
                                    <!-- ================================= -->

                                    <td>

                                        <strong>
                                            @item.Employee?.FirstName
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            @item.Employee?.EmployeeCode
                                        </small>

                                    </td>


                                    <!-- ================================= -->
                                    <!-- OD DATE -->
                                    <!-- ================================= -->

                                    <td>

                                        @(item.ODDate?.ToString("dd-MMM-yyyy"))

                                    </td>


                                    <!-- ================================= -->
                                    <!-- OD TYPE -->
                                    <!-- ================================= -->

                                    <td>

                                        @if (item.ODType == "Full Day")
                                        {
                                            <span class="badge bg-primary">
                                                Full Day
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">
                                                Partial Day
                                            </span>
                                        }

                                    </td>


                                    <!-- ================================= -->
                                    <!-- FROM TIME -->
                                    <!-- ================================= -->

                                    <td>

                                        @if (item.RequestedFromTime.HasValue)
                                        {
                                            @item.RequestedFromTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- ================================= -->
                                    <!-- TO TIME -->
                                    <!-- ================================= -->

                                    <td>

                                        @if (item.RequestedToTime.HasValue)
                                        {
                                            @item.RequestedToTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- ================================= -->
                                    <!-- LOCATION -->
                                    <!-- ================================= -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(item.Location)
                                            ? "-"
                                            : item.Location)

                                    </td>


                                    <!-- ================================= -->
                                    <!-- PURPOSE -->
                                    <!-- ================================= -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(item.Purpose)
                                            ? "-"
                                            : (item.Purpose.Length > 40
                                            ? item.Purpose.Substring(0, 40) + "..."
                                            : item.Purpose))

                                    </td>


                                    <!-- ================================= -->
                                    <!-- REASON -->
                                    <!-- ================================= -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(item.Reason)
                                            ? "-"
                                            : (item.Reason.Length > 40
                                            ? item.Reason.Substring(0, 40) + "..."
                                            : item.Reason))

                                    </td>


                                    <!-- ================================= -->
                                    <!-- ATTACHMENT -->
                                    <!-- ================================= -->

                                    <td>

                                        @if (!string.IsNullOrEmpty(item.Attachment))
                                        {
                                            <a href="~/uploads/od/@item.Attachment"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-primary">

                                                <em class="icon ni ni-file-text"></em>

                                                View

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- ================================= -->
                                    <!-- STATUS -->
                                    <!-- ================================= -->

                                    <td>

                                        @if (item.Status == "Approved")
                                        {
                                            <span class="badge badge-dot bg-success">
                                                Approved
                                            </span>

                                            @if (item.ApprovedDate.HasValue)
                                            {
                                                <br />

                                                <small class="text-muted">
                                                    @string.Format("{0:dd-MM-yyyy hh:mm tt}", item.ApprovedDate)
                                                </small>
                                            }
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge badge-dot bg-danger">
                                                Rejected
                                            </span>

                                            @if (item.ApprovedDate.HasValue)
                                            {
                                                <br />

                                                <small class="text-muted">
                                                    @string.Format("{0:dd-MM-yyyy hh:mm tt}", item.ApprovedDate)
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-dot bg-warning">
                                                Pending
                                            </span>

                                            <br />

                                            <small class="text-muted">
                                                Applied:
                                                @string.Format("{0:dd-MM-yyyy hh:mm tt}", item.CreatedDate)
                                            </small>
                                        }

                                    </td>


                                    <!-- ================================= -->
                                    <!-- ACTION -->
                                    <!-- ================================= -->

                                    <td>

                                        <div class="btn-group">

                                            @if (item.Status == "Pending")
                                            {
                                                <!-- APPROVE -->

                                                <a asp-action="ApproveOD"
                                                   asp-route-id="@item.ODRequestId"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Approve"
                                                   onclick="return confirm('Are you sure you want to approve this OD request?');">

                                                    <em class="icon ni ni-check"></em>

                                                </a>


                                                <!-- REJECT -->

                                                <a asp-action="RejectOD"
                                                   asp-route-id="@item.ODRequestId"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Reject"
                                                   onclick="return confirm('Are you sure you want to reject this OD request?');">

                                                    <em class="icon ni ni-cross"></em>

                                                </a>
                                            }

                                            else if (item.Status == "Approved")
                                            {
                                                <!-- REJECT APPROVED -->

                                                <a asp-action="RejectOD"
                                                   asp-route-id="@item.ODRequestId"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Reject"
                                                   onclick="return confirm('This OD request is already approved. Do you want to reject it?');">

                                                    <em class="icon ni ni-cross"></em>

                                                </a>
                                            }

                                            else if (item.Status == "Rejected")
                                            {
                                                <!-- APPROVE REJECTED -->

                                                <a asp-action="ApproveOD"
                                                   asp-route-id="@item.ODRequestId"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Approve"
                                                   onclick="return confirm('This OD request is already rejected. Do you want to approve it?');">

                                                    <em class="icon ni ni-check"></em>

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>

                                serial++;
                            }
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@section Scripts {
   <script>
               $(document).ready(function () {

            var selectedODRequests = new Set();


            // =====================================================
            // ROW CHECKBOX
            // =====================================================

            $(document).on('change', '.od-checkbox', function () {

                var id = $(this).val();

                if ($(this).prop('checked')) {
                    selectedODRequests.add(id);
                }
                else {
                    selectedODRequests.delete(id);
                }

                updateSelectAll();
                updateApproveButton();
            });


            // =====================================================
            // SELECT ALL - CURRENT PAGE
            // =====================================================

            $(document).on('change', '#selectAllOD', function () {

                var checked = $(this).prop('checked');

                $('.od-checkbox').each(function () {

                    var id = $(this).val();

                    $(this).prop('checked', checked);

                    if (checked) {
                        selectedODRequests.add(id);
                    }
                    else {
                        selectedODRequests.delete(id);
                    }
                });

                updateSelectAll();
                updateApproveButton();
            });


            // =====================================================
            // DATATABLE REDRAW
            // Pagination / Search / Sort
            // =====================================================

            $('.datatable-init-export').on('draw.dt', function () {

                $('.od-checkbox').each(function () {

                    var id = $(this).val();

                    $(this).prop(
                        'checked',
                        selectedODRequests.has(id)
                    );
                });

                updateSelectAll();
                updateApproveButton();
            });


            // =====================================================
            // SELECT ALL STATE
            // =====================================================

            function updateSelectAll() {

                var total =
                    $('.od-checkbox').length;

                var checked =
                    $('.od-checkbox:checked').length;

                var selectAll =
                    $('#selectAllOD');

                if (total === 0) {

                    selectAll.prop('checked', false);
                    selectAll.prop('indeterminate', false);

                    return;
                }

                if (checked === total) {

                    selectAll.prop('checked', true);
                    selectAll.prop('indeterminate', false);

                }
                else if (checked > 0) {

                    selectAll.prop('checked', false);
                    selectAll.prop('indeterminate', true);

                }
                else {

                    selectAll.prop('checked', false);
                    selectAll.prop('indeterminate', false);
                }
            }


            // =====================================================
            // APPROVE BUTTON
            // =====================================================

            function updateApproveButton() {

                var count =
                    selectedODRequests.size;

                $('#approveSelectedODBtn')
                    .prop('disabled', count === 0);

                $('#selectedODCount')
                    .text(count);
            }


            // =====================================================
            // FORM SUBMIT
            // =====================================================

            $('#bulkApproveODForm').on('submit', function (e) {

                if (selectedODRequests.size === 0) {

                    e.preventDefault();

                    alert(
                        'Please select at least one OD request.'
                    );

                    return;
                }

                if (!confirm(
                    'Are you sure you want to approve ' +
                    selectedODRequests.size +
                    ' selected OD request(s)?'
                )) {

                    e.preventDefault();

                    return;
                }


                // Remove old hidden inputs
                $('.selected-od-hidden').remove();


                // Add all selected IDs
                selectedODRequests.forEach(function (id) {

                    $('<input>', {
                        type: 'hidden',
                        name: 'selectedIds',
                        value: id,
                        class: 'selected-od-hidden'
                    }).appendTo('#bulkApproveODForm');

                });

            });


            // =====================================================
            // INITIAL STATE
            // =====================================================

            updateSelectAll();
            updateApproveButton();

        });
   </script>
}