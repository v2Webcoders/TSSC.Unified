@using TSSC.Unified.Models
@model IEnumerable<AttendanceRegularization>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Attendance Regularization Requests";
    int serial = 1;
}

<!-- ========================================= -->
<!-- PAGE HEADER -->
<!-- ========================================= -->

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between">

        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                Attendance Regularization Requests
            </h3>

        </div>


        <div class="nk-block-head-content">

            <div class="toggle-wrap nk-block-tools-toggle">

                <a href="#"
                   class="btn btn-icon btn-trigger toggle-expand me-n1"
                   data-target="pageMenu">

                    <em class="icon ni ni-more-v"></em>

                </a>


                <div class="toggle-expand-content"
                     data-content="pageMenu">

                    <ul class="nk-block-tools g-3">

                        <li class="nk-block-tools-opt">

                            <a asp-action="MyRegularizations"
                               class="btn btn-primary">

                                <em class="icon ni ni-list"></em>

                                <span>
                                    My Regularizations
                                </span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>
<div class="mb-4">

    <ul class="nav nav-tabs">

        <!-- Pending -->
        <li class="nav-item">

            <a asp-action="RegularizationRequests"
               asp-route-status="Pending"
               class="nav-link @(ViewBag.Status == "Pending" ? "active" : "")">

                Pending

                <span class="badge bg-warning ms-1">
                    @ViewBag.PendingCount
                </span>

            </a>

        </li>


        <!-- Approved -->
        <li class="nav-item">

            <a asp-action="RegularizationRequests"
               asp-route-status="Approved"
               class="nav-link @(ViewBag.Status == "Approved" ? "active" : "")">

                Approved

                <span class="badge bg-success ms-1">
                    @ViewBag.ApprovedCount
                </span>

            </a>

        </li>


        <!-- Rejected -->
        <li class="nav-item">

            <a asp-action="RegularizationRequests"
               asp-route-status="Rejected"
               class="nav-link @(ViewBag.Status == "Rejected" ? "active" : "")">

                Rejected

                <span class="badge bg-danger ms-1">
                    @ViewBag.RejectedCount
                </span>

            </a>

        </li>

    </ul>

</div>
<!-- ========================================= -->
<!-- REQUEST TABLE -->
<!-- ========================================= -->

<div class="nk-block nk-block-lg">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }
    <div class="card card-preview">

        <div class="card-inner">
            <form asp-action="BulkApproveManagerRegularization"
                  method="post"
                  id="bulkApproveForm">

                @Html.AntiForgeryToken()

                <div class="d-flex align-items-center mb-3">

                    <button type="submit"
                            class="btn btn-success"
                            id="approveSelectedBtn"
                            disabled>

                        <em class="icon ni ni-check"></em>
                        Approve Selected

                    </button>

                    <span class="text-muted ms-3">
                        Selected:
                        <strong id="selectedCount">0</strong>
                    </span>

                </div>

            </form>
            <div class="table-responsive">

                <table class="datatable-init-export table table-tranx table_custom table-bordered">

                    <thead>

                        <tr>
                            <th width="40" data-orderable="false">
                                <input type="checkbox"
                                       id="selectAllRegularization" />
                            <th width="60">
                                S.No.
                            </th>

                            <th>
                                Employee
                            </th>

                            <th>
                                Attendance Date
                            </th>

                            <th>
                                Existing In
                            </th>

                            <th>
                                Existing Out
                            </th>

                            <th>
                                Requested In
                            </th>

                            <th>
                                Requested Out
                            </th>

                            <th>
                                Reason
                            </th>

                            <th>
                                Status
                            </th>

                            <th width="130">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>

                                    @if (item.Status == "Pending")
                                    {
                                        <input type="checkbox"
                                               class="regularization-checkbox"
                                               value="@item.RegularizationId" />
                                    }

                                </td>
                                <!-- ================================= -->
                                <!-- SERIAL -->
                                <!-- ================================= -->

                                <td>
                                    @serial
                                </td>


                                <!-- ================================= -->
                                <!-- EMPLOYEE -->
                                <!-- ================================= -->

                                <td>

                                    <strong>
                                        @item.Employee?.FirstName
                                    </strong>

                                    <br />

                                    <small class="text-muted">
                                        @item.Employee?.EmployeeCode
                                    </small>

                                </td>


                                <!-- ================================= -->
                                <!-- ATTENDANCE DATE -->
                                <!-- ================================= -->

                                <td>

                                    @(item.AttendanceDate
                                        .ToString("dd-MMM-yyyy"))

                                </td>


                                <!-- ================================= -->
                                <!-- EXISTING IN -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.ExistingInTime.HasValue)
                                    {
                                        @(item.ExistingInTime?.ToString("hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- EXISTING OUT -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.ExistingOutTime.HasValue)
                                    {
                                        @(item.ExistingOutTime?.ToString("hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            Missing
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- REQUESTED IN -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.RequestedInTime.HasValue)
                                    {
                                        @(item.RequestedInTime?.ToString("hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- REQUESTED OUT -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.RequestedOutTime.HasValue)
                                    {
                                        @(item.RequestedOutTime?.ToString("hh:mm tt") ?? "-")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- REASON -->
                                <!-- ================================= -->

                                <td>

                                    @(string.IsNullOrEmpty(item.Reason)
                                        ? "-"
                                        : (item.Reason.Length > 50
                                            ? item.Reason.Substring(0, 50) + "..."
                                            : item.Reason))

                                    @if (!string.IsNullOrEmpty(item.Attachment))
                                    {
                                        <br />

                                        <a href="~/uploads/attendance/@item.Attachment"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary mt-1">

                                            <em class="icon ni ni-file-text"></em>

                                            Attachment

                                        </a>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- STATUS -->
                                <!-- ================================= -->

                                <td>

                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge badge-dot bg-success">
                                            Approved
                                        </span>

                                        <br />

                                        <small class="text-muted">

                                            @(item.ApprovedDate?
                                                .ToString("dd-MMM-yyyy hh:mm"))

                                        </small>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge badge-dot bg-danger">
                                            Rejected
                                        </span>

                                        <br />

                                        <small class="text-muted">

                                            @(item.ApprovedDate?
                                                .ToString("dd-MMM-yyyy hh:mm"))

                                        </small>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dot bg-warning">
                                            Pending
                                        </span>

                                        <br />

                                        <small class="text-muted">

                                            Applied:
                                            @(item.CreatedDate
                                                .ToString("dd-MMM-yyyy hh:mm"))

                                        </small>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- ACTION -->
                                <!-- ================================= -->

                                <td>

                                    <div class="btn-group">

                                        @if (item.Status == "Pending")
                                        {
                                            <!-- APPROVE -->

                                            <a asp-action="ManagerApproveRegularization"
                                               asp-route-id="@item.RegularizationId"
                                               class="btn btn-sm btn-outline-success"
                                               title="Approve"
                                               onclick="return confirm('Are you sure you want to approve this attendance regularization request?');">
                                                <em class="icon ni ni-check"></em>
                                            </a>


                                            <!-- REJECT -->

                                            <a asp-action="ManagerRejectRegularization"
                                               asp-route-id="@item.RegularizationId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Reject"
                                               onclick="return confirm('Are you sure you want to reject this attendance regularization request?');">
                                                <em class="icon ni ni-cross"></em>
                                            </a>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <!-- ALLOW MANAGER TO REJECT APPROVED REQUEST -->

                                            <a asp-action="ManagerRejectRegularization"
                                               asp-route-id="@item.RegularizationId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Reject"
                                               onclick="return confirm('This request is already approved. Do you want to change its status to Rejected?');">
                                                <em class="icon ni ni-cross"></em>
                                            </a>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <!-- ALLOW MANAGER TO APPROVE REJECTED REQUEST -->

                                            <a asp-action="ManagerApproveRegularization"
                                               asp-route-id="@item.RegularizationId"
                                               class="btn btn-sm btn-outline-success"
                                               title="Approve"
                                               onclick="return confirm('This request is already rejected. Do you want to change its status to Approved?');">
                                                <em class="icon ni ni-check"></em>
                                            </a>
                                        }
                                    </div>

                                </td>

                            </tr>

                            serial++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts{
    <script>
        $(document).ready(function () {

            var selectedRegularizations = new Set();


            // =========================================================
            // Individual checkbox
            // =========================================================
            $(document).on(
                'change',
                '.regularization-checkbox',
                function () {

                    var id = $(this).val();

                    if ($(this).is(':checked')) {
                        selectedRegularizations.add(id);
                    }
                    else {
                        selectedRegularizations.delete(id);
                    }

                    updateSelectAll();
                    updateApproveButton();
                });


            // =========================================================
            // Header Select All - Current Page
            // =========================================================
            $(document).on(
                'change',
                '#selectAllRegularization',
                function () {

                    var checked =
                        $(this).is(':checked');

                    $('.regularization-checkbox').each(function () {

                        var id = $(this).val();

                        if (checked) {
                            selectedRegularizations.add(id);
                        }
                        else {
                            selectedRegularizations.delete(id);
                        }

                        $(this).prop(
                            'checked',
                            checked
                        );
                    });

                    updateSelectAll();
                    updateApproveButton();
                });


            // =========================================================
            // Restore checkbox state after DataTable
            // pagination / search / sorting
            // =========================================================
            $('.datatable-init-export').on(
                'draw.dt',
                function () {

                    $('.regularization-checkbox').each(function () {

                        var id = $(this).val();

                        $(this).prop(
                            'checked',
                            selectedRegularizations.has(id)
                        );

                    });

                    updateSelectAll();
                    updateApproveButton();
                });


            // =========================================================
            // Select All state
            // =========================================================
            function updateSelectAll() {

                var total =
                    $('.regularization-checkbox').length;

                var checked =
                    $('.regularization-checkbox:checked').length;

                $('#selectAllRegularization').prop(
                    'checked',
                    total > 0 && total === checked
                );

                $('#selectAllRegularization').prop(
                    'indeterminate',
                    checked > 0 && checked < total
                );
            }


            // =========================================================
            // Approve button
            // =========================================================
            function updateApproveButton() {

                var count =
                    selectedRegularizations.size;

                $('#approveSelectedBtn')
                    .prop(
                        'disabled',
                        count === 0
                    );

                $('#selectedCount')
                    .text(count);
            }


            // =========================================================
            // Submit
            // =========================================================
            $('#bulkApproveForm').on(
                'submit',
                function (e) {

                    if (
                        selectedRegularizations.size === 0
                    ) {

                        e.preventDefault();

                        alert(
                            'Please select at least one regularization request.'
                        );

                        return;
                    }


                    if (!confirm(
                        'Are you sure you want to approve ' +
                        selectedRegularizations.size +
                        ' selected regularization request(s)?'
                    )) {

                        e.preventDefault();

                        return;
                    }


                    // Remove old hidden inputs
                    $('.selected-hidden').remove();


                    // Add ALL selected IDs
                    selectedRegularizations.forEach(
                        function (id) {

                            $('<input>', {

                                type: 'hidden',

                                name: 'selectedIds',

                                value: id,

                                class: 'selected-hidden'

                            }).appendTo(
                                '#bulkApproveForm'
                            );

                        }
                    );

                });


            // =========================================================
            // Initial state
            // =========================================================
            updateSelectAll();
            updateApproveButton();

        });
    </script>
}
