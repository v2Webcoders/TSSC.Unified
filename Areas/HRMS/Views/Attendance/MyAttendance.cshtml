@using TSSC.Unified.Models
@using TSSC.Unified.ViewModel
@model List<TSSC.Unified.Models.EmployeeAttendance>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "View Attendance";

    int year = ViewBag.Year;
    int month = ViewBag.Month;

    string monthName = ViewBag.MonthName;

    var attendanceList = Model
        .OrderBy(x => x.AttendanceDate)
        .ToList();

    var firstDay =
        new DateTime(year, month, 1);

    int daysInMonth =
        DateTime.DaysInMonth(year, month);

    // Sunday = 0
    int firstDayOffset =
        (int)firstDay.DayOfWeek;

    var previousMonth =
        firstDay.AddMonths(-1);

    var nextMonth =
        firstDay.AddMonths(1);
    var leaveList = ViewBag.LeaveList as List<LeaveRequest>
                 ?? new List<LeaveRequest>();
    var holidayList = ViewBag.HolidayList as List<Holiday>
          ?? new List<Holiday>();
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/calendar.css" />
}

