    <div class="col-12"> <div class="py-2 px-3 border-start border-4 border-danger bg-light rounded-1 mb-3"> <div class="d-flex align-items-center gap-3"> <em class="icon ni ni-info text-primary fs-6 flex-shrink-0"></em> <div class="small lh-sm"> <span class="text-body text-danger fw-500"> <strong>Click on a date</strong> to regularize attendance. </span> </div> </div> </div> </div> 
                <!-- ================================================= -->
                <!-- CALENDAR -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm">
    <div class="card-inner p-0">

        <!-- ==============================
             CALENDAR HEADER
        =============================== -->
        <div class="attendance-calendar-header">

            <a asp-action="MyAttendance"
               asp-route-year="@previousMonth.Year"
               asp-route-month="@previousMonth.Month"
               class="calendar-nav">

                <em class="icon ni ni-chevron-left"></em>

            </a>

            <div class="calendar-month-title">
                @monthName
            </div>

            <a asp-action="MyAttendance"
               asp-route-year="@nextMonth.Year"
               asp-route-month="@nextMonth.Month"
               class="calendar-nav">

                <em class="icon ni ni-chevron-right"></em>

            </a>

        </div>


        


        <!-- ==============================
             WEEK DAYS
        =============================== -->
        <div class="calendar-weekdays">

            <div>Sun</div>
            <div>Mon</div>
            <div>Tue</div>
            <div>Wed</div>
            <div>Thu</div>
            <div>Fri</div>
            <div>Sat</div>

        </div>


        <!-- ==============================
             CALENDAR
        =============================== -->
        <div class="attendance-calendar">

            @for (int i = 0; i < firstDayOffset; i++)
            {
                <div class="calendar-day empty"></div>
            }


            @for (int day = 1; day <= daysInMonth; day++)
            {
                var currentDate = new DateTime(year, month, day);

                var record = attendanceList.FirstOrDefault(x =>
                    x.AttendanceDate.Date == currentDate.Date);

                var leaveRecord = leaveList.FirstOrDefault(x =>
                    x.FromDate.Date <= currentDate.Date &&
                    x.ToDate.Date >= currentDate.Date);

                bool isToday =
                    currentDate.Date == DateTime.Today;

                string statusClass = "no-record";
                string statusText = "No Record";


                var holidayRecord = holidayList.FirstOrDefault(x =>
                    x.HolidayDate.Date == currentDate.Date);


                bool isHalfDay =
                    record != null &&
                    record.AttendanceStatus == "Half Day";


                /* =========================================
                   EXISTING STATUS LOGIC
                ========================================= */

                if (holidayRecord != null)
                {
                    statusClass = "holiday";
                    statusText = "Holiday: " + holidayRecord.HolidayName;
                }
                else if (leaveRecord != null && !isHalfDay)
                {
                    statusClass = "leave";
                    statusText = "Leave";
                }
                else if (currentDate.Date > DateTime.Today)
                {
                    statusClass = "future";
                    statusText = "";
                }
                else if (record != null)
                {
                    if (record.AttendanceStatus == "Present")
                    {
                        statusClass = "present";

                        if (currentDate.DayOfWeek == DayOfWeek.Saturday)
                            statusText = "Work from Home";
                        else
                            statusText = "Present";
                    }
                    else if (record.AttendanceStatus == "Late")
                    {
                        statusClass = "late";

                        if (currentDate.DayOfWeek == DayOfWeek.Saturday)
                            statusText = "Work from Home";
                        else
                            statusText = "Late";
                    }
                    else if (record.AttendanceStatus == "Half Day")
                    {
                        statusClass = "present";
                        statusText = "Half Day";
                    }
                    else if (record.AttendanceStatus ==
                             "Present - Out Punch Missing")
                    {
                        statusClass = "missing";
                        statusText = "Out Punch Missing";
                    }
                    else if (record.AttendanceStatus == "Leave")
                    {
                        statusClass = "leave";
                        statusText = "Leave";
                    }
                    else
                    {
                        statusClass = "other";
                        statusText = record.AttendanceStatus;
                    }
                }
                else
                {
                    if (currentDate.DayOfWeek == DayOfWeek.Sunday)
                    {
                        statusClass = "sunday";
                        statusText = "Sunday";
                    }
                    else
                    {
                        statusClass = "absent";
                        statusText = "Absent";
                    }
                }


                <!-- ==============================
                     DAY CELL
                     IMPORTANT:
                     statusClass is NOT applied here.
                     This keeps the cell WHITE.
                =============================== -->

                <div class="calendar-day @(isToday ? "today" : "")"
                     data-bs-toggle="modal"
                     data-bs-target="#attendanceModal"
                     data-date="@currentDate.ToString("yyyy-MM-dd")"
                     data-in="@record?.InTime?.ToString("hh:mm tt")"
                     data-out="@record?.OutTime?.ToString("hh:mm tt")"
                     data-status="@statusText"
                     data-record-id="@record?.AttendanceId">


                    <!-- DAY NUMBER -->

                    <div class="day-number">
                        @day
                    </div>


                    <!-- ==============================
                         HOLIDAY
                    =============================== -->

                    @if (holidayRecord != null)
                    {
                        <div class="attendance-status holiday">

                            <div class="holiday-label">
                                Holiday
                            </div>

                            <div class="holiday-name">
                                @holidayRecord.HolidayName
                            </div>

                        </div>
                    }


                    <!-- ==============================
                         LEAVE
                    =============================== -->

                    @if (leaveRecord != null)
                    {
                        <div class="attendance-status leave">

                            <div class="leave-label">

                                @if (isHalfDay)
                                {
                                    <strong>Half Leave</strong>
                                }
                                else
                                {
                                    <strong>Full Leave</strong>
                                }

                            </div>

                            <div class="leave-date">

                                @if (isHalfDay)
                                {
                                    <span>
                                        @leaveRecord.FromDate.ToString("dd MMM")
                                        -
                                        @leaveRecord.ToDate.ToString("dd MMM")
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @leaveRecord.FromDate.ToString("dd MMM yyyy")
                                        -
                                        @leaveRecord.ToDate.ToString("dd MMM yyyy")
                                    </span>
                                }

                            </div>

                        </div>
                    }


                    <!-- ==============================
                         ATTENDANCE RECORD
                    =============================== -->

                    @if (record != null)
                    {
                        <div class="attendance-status @statusClass">

                            <div class="attendance-status-label">

                                @(record.AttendanceDate.DayOfWeek ==
                                    DayOfWeek.Saturday
                                    ? "Work from Home"
                                    : statusText)

                            </div>


                            <!-- TIME -->

                            @if (record.InTime.HasValue ||
                                 record.OutTime.HasValue)
                            {
                                <div class="attendance-time">

                                    @if (record.InTime.HasValue)
                                    {
                                        <span>
                                            @record.InTime.Value.ToString("hh:mm tt")
                                        </span>
                                    }

                                    @if (record.InTime.HasValue &&
                                         record.OutTime.HasValue)
                                    {
                                        <span class="time-separator">
                                            –
                                        </span>
                                    }

                                    @if (record.OutTime.HasValue)
                                    {
                                        <span>
                                            @record.OutTime.Value.ToString("hh:mm tt")
                                        </span>
                                    }

                                </div>
                            }


                            <!-- ==============================
                                 ATTENDANCE SOURCE
                            =============================== -->

                            @if (!string.IsNullOrWhiteSpace(
                                record.AttendanceSource))
                            {
                                var source =
                                    record.AttendanceSource.Trim();


                                if (source.Equals(
                                    "Manual",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="attendance-source-badge"
                                          title="Manual Attendance&#10;Location: @record.CheckInLocation">
                                        M
                                    </span>
                                }
                                else if (source.Equals(
                                    "Biometric",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="attendance-source-badge"
                                          title="Biometric Attendance">
                                        B
                                    </span>
                                }
                                else if (source.Equals(
                                    "Regularized",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="attendance-source-badge"
                                          title="Regularized Attendance">
                                        R
                                    </span>
                                }
                                else
                                {
                                    <span class="attendance-source-badge"
                                          title="@source">
                                        @source.Substring(0, 1).ToUpper()
                                    </span>
                                }
                            }

                        </div>
                    }
                    else
                    {
                        <!-- ==============================
                             NO ATTENDANCE RECORD
                        =============================== -->
                        @if (!string.IsNullOrWhiteSpace(statusText))
                        {
                            if (statusClass == "sunday")
                            {
                                <div class="attendance-status holiday">

                                    <div class="holiday-label">
                                        Sunday
                                    </div>

                                </div>
                            }
                            else if (statusClass == "absent")
                            {
                                <div class="attendance-status absent">
                                    Absent
                                </div>
                            }
                        }
                    }

                </div>
            }

        </div>

    </div>
</div>

            </div>

        </div>

    </div>

</div>


