@using QUIZAPP.ViewModel
@model TSSC.Unified.ViewModel.CEODashboardVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "~/Areas/HRMS/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "CEO DASHBOARD";
    var workforce = Model.Workforce;
    var total = workforce.TotalEmployees;

    decimal GetPercentage(int value) =>
        total > 0 ? (decimal)value / total * 100 : 0;

    var onTimeWidth = GetPercentage(workforce.OnTime);
    var delayedWidth = GetPercentage(workforce.Delayed);
    var onDutyWidth = GetPercentage(workforce.OnDuty);
    var onLeaveWidth = GetPercentage(workforce.OnLeave);
    var absentWidth = GetPercentage(workforce.Absent);
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/dashboard.css" asp-append-version="true" />
}


<div class="container-fluid m-0 p-0">
    <div class="row">
        <div id="dash-root">
            <div id="wrap">
                <div id="app">
                    
                    <div id="scrim"></div>
                    <div id="main">
                        
                        <main class="content" id="top">
                            <div class="page view " id="v-dash" data-crumb="CEO Dashboard">
                                <div data-fy="2026-27">
                                    <div data-date="2026-11-05">
                                        <div class="hero">
                                            <div>
                                                <div class="eyebrow">Executive overview</div>
                                                <h1 class="text-white" style="color:white !important;">CEO Dashboard</h1>
                                                <p>
                                                    Workforce, approvals, KPIs, training and department access in one place.
                                                </p>
                                            </div>
                                        </div>
                                        <section>
                                            <div class="sh">
                                                <div>
                                                    <h2>① HR · Workforce</h2>
                                                    <p>
                                                        Headcount, leave and notices for
                                                        <b>@DateTime.Today.ToString("ddd, d MMM yyyy")</b>
                                                    </p>
                                                </div>
                                                <div class="shr"></div>
                                            </div>

                                            <div class="wsum">

                                                <div class="wgrid">

                                                    <!-- TOTAL EMPLOYEES -->
                                                    <div class="wc w-total">
                                                        <span class="l">Total employees</span>
                                                        <span class="n">@workforce.TotalEmployees</span>
                                                    </div>

                                                    <!-- PRESENT -->
                                                    <div class="wc w-pres" role="group">

                                                        <span class="l">
                                                            <i class="dot"
                                                               style="background:var(--green)"></i>
                                                            Present
                                                        </span>

                                                        <span class="n">@workforce.Present</span>

                                                        <span class="s">
                                                            <b>@workforce.PresentPercentage.ToString("0")</b>%
                                                            of employees
                                                        </span>

                                                        <span class="subs">
                                                            <span class="sc sc-ok">
                                                                <b>@workforce.OnTime</b> On time
                                                            </span>

                                                            <span class="sc sc-late">
                                                                <b>@workforce.Delayed</b> Delay
                                                            </span>
                                                        </span>
                                                    </div>

                                                    <!-- ON DUTY -->
                                                    <div class="wc">
                                                        <span class="l">
                                                            <i class="dot"
                                                               style="background:var(--royal)"></i>
                                                            On duty (OD)
                                                        </span>

                                                        <span class="n">@workforce.OnDuty</span>

                                                        <span class="s">Working remotely</span>
                                                    </div>

                                                    <!-- ON LEAVE -->
                                                    <div class="wc w-leave">
                                                        <span class="l">
                                                            <i class="dot"
                                                               style="background:var(--purple)"></i>
                                                            On leave
                                                        </span>

                                                        <span class="n">@workforce.OnLeave</span>

                                                        <span class="s">Approved leave today</span>
                                                    </div>

                                                    <!-- ABSENT -->
                                                    <div class="wc">
                                                        <span class="l">
                                                            <i class="dot"
                                                               style="background:var(--red)"></i>
                                                            Absent
                                                        </span>

                                                        <span class="n">@workforce.Absent</span>

                                                        <span class="s">Not marked</span>
                                                    </div>

                                                </div>

                                                <!-- ATTENDANCE SPLIT BAR -->
                                                <div class="wbar" aria-label="Attendance split">

                                                    <i class="s1"
                                                       title="On time: @workforce.OnTime"
                                                       style="width:@onTimeWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                                    </i>

                                                    <i class="s2"
                                                       title="Late: @workforce.Delayed"
                                                       style="width:@delayedWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                                    </i>

                                                    <i class="s3"
                                                       title="On duty: @workforce.OnDuty"
                                                       style="width:@onDutyWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                                    </i>

                                                    <i class="s5"
                                                       title="On leave: @workforce.OnLeave"
                                                       style="width:@onLeaveWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                                    </i>

                                                    <i class="s4"
                                                       title="Absent: @workforce.Absent"
                                                       style="width:@absentWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                                    </i>

                                                </div>

                                                <div class="segnote">
                                                    Present includes on-time and delayed employees.
                                                    OD (working remotely) and On leave are counted
                                                    separately from Absent.
                                                </div>

                                            </div>
                                        </section>
                                    </div>
