@using QUIZAPP.ViewModel
@model DashboardViewModel

@{
	Layout = "~/Areas/HRMS/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "HRMS DASHBOARD";
}
<style>
    /* Accent bar for KPI cards — deliberately NOT using the `border` property,
           so it never collides with DashLite's own card-bordered hover/box-shadow styling. */
    .kpi-card .kpi-accent {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        display: block;
        pointer-events: none; /* never intercepts hover/click on the card itself */
    }
</style>
@section Styles {
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true" />
}
<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between g-3">
            <div class="nk-block-head-content">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-4 mb-5">
                    <div>
                        <h1 class="fs-4 text-primary fw-bold mb-1">  Welcome, @ViewBag.EmployeeName 👋</h1>
                        <div class="mt-0 mb-6 pb-4">

                            <div class="d-flex flex-wrap align-items-center gap-3">

                                <!-- Date -->
                                <div class="d-flex align-items-center">
                                    <em class="icon ni ni-calendar-alt text-primary me-2"></em>
                                    <span class="fw-semibold">
                                        @DateTime.Today.ToString("dddd, dd MMMM yyyy")
                                    </span>
                                </div>

                                <!-- Status -->
                                <span class="@(ViewBag.TodayInTime != null ? "text-success" : "text-warning")">
                                    <em class="icon ni ni-check-circle"></em>
                                </span>

                                <!-- In Time -->
                                <span class="text-dark">
                                    <strong>In:</strong>
                                    <span class="fw-semibold text-success">
                                        @(ViewBag.TodayInTime != null
                                            ? ((DateTime)ViewBag.TodayInTime).ToString("hh:mm tt")
                                            : "--")
                                    </span>
                                </span>

                                <!-- Out Time -->
                                <span class="text-dark">
                                    <strong>Out:</strong>
                                    <span class="fw-semibold text-primary">
                                        @(ViewBag.TodayOutTime != null
                                            ? ((DateTime)ViewBag.TodayOutTime).ToString("hh:mm tt")
                                            : "--")
                                    </span>
                                </span>

                            </div>

                        </div>
                    </div>
                    <a class="btn btn-secondary text-white" href="attendance.html">Mark Today's Attendance</a>
                </div>
                @* <h3 class="nk-block-title page-title d-flex align-items-center gap-2">
                    <em class="icon ni ni-monitor text-primary"></em>
                    Dashboard
                </h3>
                <div class="nk-block-des text-soft">
                    <div class="mt-0 mb-6 pb-4">

                        <div class="d-flex flex-wrap align-items-center gap-3">

                            <!-- Date -->
                            <div class="d-flex align-items-center">
                                <em class="icon ni ni-calendar-alt text-primary me-2"></em>
                                <span class="fw-semibold">
                                    @DateTime.Today.ToString("dddd, dd MMMM yyyy")
                                </span>
                            </div>

                            <!-- Status -->
                            <span class="@(ViewBag.TodayInTime != null ? "text-success" : "text-warning")">
                                <em class="icon ni ni-check-circle"></em>
                            </span>

                            <!-- In Time -->
                            <span class="text-dark">
                                <strong>In:</strong>
                                <span class="fw-semibold text-success">
                                    @(ViewBag.TodayInTime != null
                                        ? ((DateTime)ViewBag.TodayInTime).ToString("hh:mm tt")
                                        : "--")
                                </span>
                            </span>

                            <!-- Out Time -->
                            <span class="text-dark">
                                <strong>Out:</strong>
                                <span class="fw-semibold text-primary">
                                    @(ViewBag.TodayOutTime != null
                                        ? ((DateTime)ViewBag.TodayOutTime).ToString("hh:mm tt")
                                        : "--")
                                </span>
                            </span>

                        </div>

                    </div>
                </div> *@
            </div>
            <div class="nk-block-head-content">
                <a href="#" class="btn btn-primary">
                    <em class="icon ni ni-download-cloud"></em>
                    <span>Download Report</span>
                </a>
            </div>
        </div>
    </div><!-- .nk-block-head -->

    <div class="nk-block mt-4">

        <div class="row g-gs">
            <div class="col-sm-6 col-lg-3">
                <div class="card card-bordered kpi-card" style="position:relative;overflow:hidden;">
                    <span class="kpi-accent" style="background-color:#6576ff;"></span>
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title">
                                <h6 class="title">Total Employees</h6>
                            </div>
                            <div class="card-tools">
                                <em class="icon-circle icon-circle-lg bg-primary-dim">
                                    <em class="icon ni ni-users text-primary"></em>
                                </em>
                            </div>
                        </div>
                        <div class="align-end flex-sm-wrap g-2">
                            <div class="nk-sale-data">
                                <span class="amount">1,284</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- .col -->

            <div class="col-sm-6 col-lg-3">
                <div class="card card-bordered kpi-card" style="position:relative;overflow:hidden;">
                    <span class="kpi-accent" style="background-color:#1ee0ac;"></span>
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title">
                                <h6 class="title">Attendance Today</h6>
                            </div>
                            <div class="card-tools">
                                <em class="icon-circle icon-circle-lg bg-success-dim">
                                    <em class="icon ni ni-clock text-success"></em>
                                </em>
                            </div>
                        </div>
                        <div class="align-end flex-sm-wrap g-2">
                            <div class="nk-sale-data">
                                <span class="amount">96.8%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- .col -->

            <div class="col-sm-6 col-lg-3">
                <div class="card card-bordered kpi-card" style="position:relative;overflow:hidden;">
                    <span class="kpi-accent" style="background-color:#f4bd0e;"></span>
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title">
                                <h6 class="title">Employees on Leave</h6>
                            </div>
                            <div class="card-tools">
                                <em class="icon-circle icon-circle-lg bg-warning-dim">
                                    <em class="icon ni ni-calendar-alt text-warning"></em>
                                </em>
                            </div>
                        </div>
                        <div class="align-end flex-sm-wrap g-2">
                            <div class="nk-sale-data">
                                <span class="amount">18</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- .col -->

            <div class="col-sm-6 col-lg-3">
                <div class="card card-bordered kpi-card" style="position:relative;overflow:hidden;">
                    <span class="kpi-accent" style="background-color:#09c2de;"></span>
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title">
                                <h6 class="title">Pending Leave Requests</h6>
                            </div>
                            <div class="card-tools">
                                <em class="icon-circle icon-circle-lg bg-info-dim">
                                    <em class="icon ni ni-calendar-check text-info"></em>
                                </em>
                            </div>
                        </div>
                        <div class="align-end flex-sm-wrap g-2">
                            <div class="nk-sale-data">
                                <span class="amount">4</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- .col -->
        </div><!-- .row -->
    </div><!-- .nk-block -->

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-lg-8">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-3">
                            <div class="card-title">
                                <h6 class="title">Attendance Overview</h6>
                            </div>
                        </div>
                        <div style="height:280px;">
                            <canvas id="attendanceChart"></canvas>
                        </div>
                    </div>
                </div>
            </div><!-- .col -->

            <div class="col-lg-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-3">
                            <div class="card-title">
                                <h6 class="title">Employee Distribution</h6>
                            </div>
                        </div>
                        <div style="height:280px;">
                            <canvas id="empChart"></canvas>
                        </div>
                    </div>
                </div>
            </div><!-- .col -->
        </div><!-- .row -->
    </div><!-- .nk-block -->

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-lg-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-2">
                            <div class="card-title">
                                <h6 class="title">New Employees</h6>
                            </div>
                        </div>
                        <ul class="nk-activity">
                            <li class="nk-activity-item">
                                <div class="nk-activity-data">
                                    <div class="label">Rahul Sharma</div>
                                </div>
                            </li>
                            <li class="nk-activity-item">
                                <div class="nk-activity-data">
                                    <div class="label">Priya Singh</div>
                                </div>
                            </li>
                            <li class="nk-activity-item">
                                <div class="nk-activity-data">
                                    <div class="label">Amit Verma</div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div><!-- .col -->

            <div class="col-lg-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-2">
                            <div class="card-title">
                                <h6 class="title">Pending Leave Requests</h6>
                            </div>
                        </div>
                        <ul class="nk-activity">
                            <li class="nk-activity-item">
                                <div class="nk-activity-data d-flex justify-content-between align-items-center w-100">
                                    <div class="label">Rahul Sharma <span class="text-soft">— Annual</span></div>
                                    <span class="badge badge-dim bg-warning-dim text-warning">Pending</span>
                                </div>
                            </li>
                            <li class="nk-activity-item">
                                <div class="nk-activity-data d-flex justify-content-between align-items-center w-100">
                                    <div class="label">Priya Singh <span class="text-soft">— Medical</span></div>
                                    <span class="badge badge-dim bg-warning-dim text-warning">Pending</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div><!-- .col -->

            <div class="col-lg-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-2">
                            <div class="card-title">
                                <h6 class="title">Today's Birthdays</h6>
                            </div>
                        </div>
                        <ul class="nk-activity">
                            <li class="nk-activity-item">
                                <div class="nk-activity-data">
                                    <div class="label">Neha Gupta</div>
                                </div>
                            </li>
                            <li class="nk-activity-item">
                                <div class="nk-activity-data">
                                    <div class="label">Rohit Sharma</div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div><!-- .col -->
        </div><!-- .row -->
    </div><!-- .nk-block -->

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-lg-8">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-2">
                            <div class="card-title">
                                <h6 class="title">Recent HR Activities</h6>
                            </div>
                        </div>
                        <table class="table table-orders">
                            <thead class="tb-odr-head">
                                <tr class="tb-odr-item">
                                    <th class="tb-odr-info">Activity</th>
                                    <th class="tb-odr-total">Time</th>
                                    <th class="tb-odr-action">Status</th>
                                </tr>
                            </thead>
                            <tbody class="tb-odr-body">
                                <tr class="tb-odr-item">
                                    <td class="tb-odr-info">Employee Added</td>
                                    <td class="tb-odr-total">10:00 AM</td>
                                    <td class="tb-odr-action"><span class="badge badge-dim bg-info-dim text-info">New</span></td>
                                </tr>
                                <tr class="tb-odr-item">
                                    <td class="tb-odr-info">Leave Approved</td>
                                    <td class="tb-odr-total">11:15 AM</td>
                                    <td class="tb-odr-action"><span class="badge badge-dim bg-success-dim text-success">Approved</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div><!-- .col -->

            <div class="col-lg-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-2">
                            <div class="card-title">
                                <h6 class="title">Quick Actions</h6>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <a href="/HRMS/Employee/Create" class="btn btn-primary w-100">Add Employee</a>
                            </div>
                            <div class="col-6">
                                <a href="/HRMS/Attendance/ViewAll" class="btn w-100" style="background-color:#1ee0ac;border-color:#1ee0ac;color:#fff;">Attendance</a>
                            </div>
                            <div class="col-6">
                                <a href="/HRMS/Approvals/Pending" class="btn w-100" style="background-color:#f4bd0e;border-color:#f4bd0e;color:#fff;">Approvals</a>
                            </div>
                            <div class="col-6">
                                <a href="/HRMS/Employee/EmployeeList" class="btn w-100" style="background-color:#09c2de;border-color:#09c2de;color:#fff;">Employee List</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- .col -->
        </div><!-- .row -->
    </div><!-- .nk-block -->
</div><!-- .nk-content-body -->

<script>
    // Uses Chart.js — already bundled with the DashLite theme, no extra include needed.
    document.addEventListener("DOMContentLoaded", function () {
        var attendanceCtx = document.getElementById("attendanceChart");
        if (attendanceCtx) {
            new Chart(attendanceCtx, {
                type: "line",
                data: {
                    labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"],
                    datasets: [{
                        label: "Attendance %",
                        data: [94, 95, 93, 97, 96.8, 90],
                        borderColor: "#6576ff",
                        backgroundColor: "rgba(101,118,255,0.08)",
                        tension: 0.35,
                        fill: true,
                        pointRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: false, min: 80, max: 100 } }
                }
            });
        }

        var empCtx = document.getElementById("empChart");
        if (empCtx) {
            new Chart(empCtx, {
                type: "doughnut",
                data: {
                    labels: ["Training", "Operations", "Finance", "IT", "Other"],
                    datasets: [{
                        data: [35, 25, 15, 15, 10],
                        backgroundColor: ["#6576ff", "#1ee0ac", "#f4bd0e", "#ff63a5", "#dee2ea"]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: "bottom" } }
                }
            });
        }
    });
</script>





