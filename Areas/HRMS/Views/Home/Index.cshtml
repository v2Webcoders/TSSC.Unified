@using QUIZAPP.ViewModel
@model TSSC.Unified.ViewModel.HRDashboardVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "~/Areas/HRMS/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "HRMS DASHBOARD";
}
<style>
    /* Accent bar for KPI cards — deliberately NOT using the `border` property,
           so it never collides with DashLite's own card-bordered hover/box-shadow styling. */
    .kpi-card .kpi-accent {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        display: block;
        pointer-events: none; /* never intercepts hover/click on the card itself */
    }
</style>
@section Styles {
    <link rel="stylesheet" href="~/assets/css/EmployeeDashboard.css" asp-append-version="true" />
}


<div class="container-fluid">
    <div class="row">

        <main class="col-md-12 col-lg-12 p-4">

            <!-- Dashboard Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-4 mb-5">

                <div>

                    <h1 class="fs-4 text-primary fw-bold mb-1">
                        Welcome, @Model.EmployeeName 👋
                    </h1>

                    <div class="mt-0 mb-4">

                        <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">

                            <!-- Date -->
                            <span class="d-flex align-items-center">

                                <em class="icon ni ni-calendar-alt me-1"></em>

                                @DateTime.Today.ToString("dddd, dd MMMM yyyy")

                            </span>

                            <span class="text-light">•</span>


                            <!-- Status -->
                            @if (Model.TodayInTime.HasValue)
                            {
                                <span class="d-flex align-items-center text-success">

                                    <em class="icon ni ni-check-circle me-1"></em>

                                    Present

                                </span>
                            }
                            else
                            {
                                <span class="d-flex align-items-center text-warning">

                                    <em class="icon ni ni-clock me-1"></em>

                                    Not marked

                                </span>
                            }


                            <span class="text-light">•</span>


                            <!-- In -->
                            <span>

                                In:
                                @(Model.TodayInTime.HasValue
                                    ? Model.TodayInTime.Value.ToString("hh:mm tt")
                                    : "--")

                            </span>


                            <span class="text-light">•</span>


                            <!-- Out -->
                            <span>

                                Out:
                                @(Model.TodayOutTime.HasValue
                                    ? Model.TodayOutTime.Value.ToString("hh:mm tt")
                                    : "--")

                            </span>

                        </div>

                    </div>

                </div>


                <!-- Manage Employees -->
                <a asp-controller="Employee"
                   asp-action="EmployeeList"
                   class="btn btn-primary">

                    <em class="icon ni ni-users me-1"></em>

                    Manage Employees

                </a>

            </div>


            <!-- HR KPI Cards -->
            <div class="row g-3 mb-4">


                <!-- Total Employees -->
                <div class="col-6 col-lg-3">

                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-primary-subtle text-primary mb-2">
                                Workforce
                            </span>

                            <div class="stat-num">
                                @Model.TotalEmployees
                            </div>

                            <div class="small text-muted">
                                Total employees
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Present Today -->
                <div class="col-6 col-lg-3">

                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-success-subtle text-success mb-2">
                                Present
                            </span>

                            <div class="stat-num">
                                @Model.PresentToday
                            </div>

                            <div class="small text-muted">
                                Employees present today
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Employees on Leave -->
                <div class="col-6 col-lg-3">

                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-warning-subtle text-warning-emphasis mb-2">
                                On Leave
                            </span>

                            <div class="stat-num">
                                @Model.EmployeesOnLeave
                            </div>

                            <div class="small text-muted">
                                Employees on leave today
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Pending Requests -->
                <div class="col-6 col-lg-3">

                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-danger-subtle text-danger mb-2">
                                Action Required
                            </span>

                            <div class="stat-num">
                                @Model.PendingLeaveRequests
                            </div>

                            <div class="small text-muted">
                                Leave requests pending approval
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Birthday Notifications -->

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-inner">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>
                            
                            <h3 class="fs-6 text-primary fw-bold mb-1">
                                <em class="icon ni ni-gift me-1 text-primary"></em>
                                Birthday Notifications
                            </h3>

                            <p class="text-muted small mb-0">
                                Today's and upcoming employee birthdays
                            </p>
                        </div>

                        <span class="badge bg-primary-subtle text-primary">
                            Next 7 Days
                        </span>

                    </div>

                    @if (Model.Birthdays != null && Model.Birthdays.Any())
                    {
                        <div class="row g-3">

                            @foreach (var birthday in Model.Birthdays)
                            {
                                bool isToday =
                                birthday.DOB.Month == DateTime.Today.Month &&
                                birthday.DOB.Day == DateTime.Today.Day;

                                <div class="col-md-6 col-lg-3">

                                    <div class="border rounded p-3 h-100">

                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrEmpty(birthday.PhotoPath))
                                            {
                                                <img src="@birthday.PhotoPath"
                                                     alt="@birthday.EmployeeName"
                                                     class="rounded-circle me-3"
                                                     style="width:55px;height:55px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary-subtle
                                                text-primary
                                                d-flex align-items-center
                                                justify-content-center me-3"
                                                     style="width:55px;height:55px;">

                                                    <em class="icon ni ni-user"></em>

                                                </div>
                                            }

                                            <div>

                                                <h6 class="mb-1">
                                                    @birthday.EmployeeName
                                                </h6>

                                                @if (isToday)
                                                {
                                                    <span class="badge bg-success">
                                                        🎂 Birthday Today
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">
                                                        <em class="icon ni ni-calendar me-1"></em>
                                                        @birthday.DOB.ToString("dd MMM")
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">

                            <em class="icon ni ni-gift"
                                style="font-size:40px;">
                            </em>

                            <h6 class="mt-3">
                                No Upcoming Birthdays
                            </h6>

                            <p class="small mb-0">
                                There are no employee birthdays in the next 7 days.
                            </p>

                        </div>
                    }

                </div>
            </div>



            <!-- HR Dashboard Content -->
            <div class="row g-3">


                <!-- Recent Leave Requests -->
                <div class="col-lg-8">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <h3 class="fs-6 text-primary fw-bold mb-0">
                                    Recent Leave Requests
                                </h3>

                                <a asp-controller="LeaveManagement"
                                   asp-action="MyLeaves"
                                   class="btn btn-sm btn-outline-primary">

                                    View All

                                </a>

                            </div>


                            <div class="table-responsive">

                                <table class="table table-sm align-middle mb-0">

                                    <thead>

                                        <tr class="text-muted small text-uppercase">

                                            <th>
                                                Employee
                                            </th>

                                            <th>
                                                Leave Type
                                            </th>

                                            <th>
                                                Dates
                                            </th>

                                            <th>
                                                Status
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        @if (Model.RecentLeaveRequests != null &&
                                             Model.RecentLeaveRequests.Any())
                                        {
                                            foreach (var item in Model.RecentLeaveRequests)
                                            {
                                                <tr>

                                                    <!-- Employee -->
                                                    <td>

                                                        <strong>
                                                            @item.EmployeeName
                                                        </strong>

                                                    </td>


                                                    <!-- Leave Type -->
                                                    <td>

                                                        @item.LeaveType

                                                    </td>


                                                    <!-- Dates -->
                                                    <td>

                                                        @item.FromDate.ToString("dd MMM yyyy")

                                                        @if (item.ToDate != item.FromDate)
                                                        {
                                                            <span>
                                                                -
                                                                @item.ToDate.ToString("dd MMM yyyy")
                                                            </span>
                                                        }

                                                    </td>


                                                    <!-- Status -->
                                                    <td>

                                                        @if (item.Status == "Pending")
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning-emphasis">
                                                                Pending
                                                            </span>
                                                        }
                                                        else if (item.Status == "Approved")
                                                        {
                                                            <span class="badge bg-success-subtle text-success">
                                                                Approved
                                                            </span>
                                                        }
                                                        else if (item.Status == "Rejected")
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger">
                                                                Rejected
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-muted">
                                                                @item.Status
                                                            </span>
                                                        }

                                                    </td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>

                                                <td colspan="4"
                                                    class="text-center text-muted py-4">

                                                    No recent leave requests found.

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Quick Actions -->
                <div class="col-lg-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body d-grid">

                            <h3 class="fs-6 text-primary fw-bold mb-2">
                                Quick Actions
                            </h3>


                            <a asp-controller="Employee"
                               asp-action="EmployeeList"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-users me-1"></em>

                                Employee Management

                            </a>


                            <a asp-controller="LeaveManagement"
                               asp-action="MyLeaves"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-calendar-check me-1"></em>

                                Manage Leave Requests

                            </a>


                            <a asp-controller="LeaveAdjustment"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-plus me-1"></em>

                                Adjust Leave Balance

                            </a>


                            <a asp-controller="HRPolicy"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-file-docs me-1"></em>

                                Manage HR Policies

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </main>

    </div>
</div>
<script>
    // Highlight active sidebar link
    document.addEventListener('DOMContentLoaded', () => {
      const path = location.pathname.split('/').pop() || 'dashboard.html';
      document.querySelectorAll('.sidebar a[data-page]').forEach(a => {
        if (a.getAttribute('data-page') === path) a.classList.add('active');
      });
    });

    // Bootstrap-style validation + fake submit -> redirect to confirmation page
    function handleFormSubmit(formId, redirectUrl, refPrefix) {
      const form = document.getElementById(formId);
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!form.checkValidity()) {
          form.classList.add('was-validated');
          return;
        }
        const ref = refPrefix + '-' + Math.floor(100000 + Math.random() * 900000);
        sessionStorage.setItem('lastRef', ref);
        sessionStorage.setItem('lastSubmitTime', new Date().toLocaleString('en-IN', {
          day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
        }));
        window.location.href = redirectUrl;
      }, false);
    }

    function fillReference(refLabel) {
      const refEl = document.getElementById('refNumber');
      const timeEl = document.getElementById('refTime');
      if (refEl) refEl.textContent = sessionStorage.getItem('lastRef') || (refLabel + '-482913');
      if (timeEl) timeEl.textContent = sessionStorage.getItem('lastSubmitTime') || new Date().toLocaleString('en-IN');
    }

    function handleLoginSubmit(formId, redirectUrl) {
      const form = document.getElementById(formId);
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!form.checkValidity()) {
          form.classList.add('was-validated');
          return;
        }
        window.location.href = redirectUrl;
      }, false);
    }

</script>





