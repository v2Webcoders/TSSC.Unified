@using QUIZAPP.ViewModel
@model DashboardViewModel

@{
	Layout = "~/Areas/HRMS/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "HRMS DASHBOARD";
}
<style>
    /* Accent bar for KPI cards — deliberately NOT using the `border` property,
           so it never collides with DashLite's own card-bordered hover/box-shadow styling. */
    .kpi-card .kpi-accent {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        display: block;
        pointer-events: none; /* never intercepts hover/click on the card itself */
    }
</style>
@section Styles {
    <link rel="stylesheet" href="~/assets/css/EmployeeDashboard.css" asp-append-version="true" />
}
<div class="container-fluid">
	<div class="row">
		@* <aside class="sidebar col-md-3 col-lg-2 p-3">
				<ul class="nav flex-column">
					<div class="nav-group-label">Main</div>
					<li class="nav-item"><a class="nav-link" href="dashboard.html" data-page="dashboard.html">🏠 Dashboard</a></li>
					<div class="nav-group-label">Attendance</div>
					<li class="nav-item"><a class="nav-link" href="attendance.html" data-page="attendance.html">🕘 Mark Attendance</a></li>
					<li class="nav-item"><a class="nav-link" href="regularization.html" data-page="regularization.html">↻ Regularization</a></li>
					<div class="nav-group-label">Requests</div>
					<li class="nav-item"><a class="nav-link" href="leave-request.html" data-page="leave-request.html">🗓 Leave Request</a></li>
					<li class="nav-item"><a class="nav-link" href="od-request.html" data-page="od-request.html">🧭 OD Request</a></li>
					<div class="nav-group-label">Resources</div>
					<li class="nav-item"><a class="nav-link" href="hr-policy.html" data-page="hr-policy.html">📄 HR Policy Docs</a></li>
				</ul>
			</aside> *@

        <main class="col-md-12 col-lg-12 p-4">

            <!-- Dashboard Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-4 mb-5">

                <div>
                    <h1 class="fs-4 text-primary fw-bold mb-1">
                        Welcome, @ViewBag.EmployeeName 👋
                    </h1>
                    <div class="mt-0 mb-4">
                        <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">

                            <!-- Date -->
                            <span class="d-flex align-items-center">
                                <em class="icon ni ni-calendar-alt me-1"></em>
                                @DateTime.Today.ToString("dddd, dd MMMM yyyy")
                            </span>

                            <span class="text-light">•</span>

                            <!-- Status -->
                            @if (ViewBag.TodayInTime != null)
                            {
                                <span class="d-flex align-items-center text-success">
                                    <em class="icon ni ni-check-circle me-1"></em> Present
                                </span>
                            }
                            else
                            {
                                <span class="d-flex align-items-center text-warning">
                                    <em class="icon ni ni-clock me-1"></em> Not marked
                                </span>
                            }

                            <span class="text-light">•</span>

                            <!-- In / Out -->
                            <span>
                                In: @(ViewBag.TodayInTime != null ? ((DateTime)ViewBag.TodayInTime).ToString("hh:mm tt") : "--")
                            </span>

                            <span class="text-light">•</span>

                            <span>
                                Out: @(ViewBag.TodayOutTime != null ? ((DateTime)ViewBag.TodayOutTime).ToString("hh:mm tt") : "--")
                            </span>

                        </div>
                    </div>
                    @* <div class="mt-0 mb-6 pb-4">
                        <div class="d-flex flex-wrap align-items-center gap-3">

                            <!-- Date -->
                            <div class="d-flex align-items-center">
                                <em class="icon ni ni-calendar-alt text-primary me-2"></em>

                                <span class="fw-semibold">
                                    @DateTime.Today.ToString("dddd, dd MMMM yyyy")
                                </span>
                            </div>

                            <!-- Attendance -->
                            <span class="text-success">
                                <em class="icon ni ni-check-circle"></em>
                                <span class="fw-semibold ms-1">Attendance Active</span>
                            </span>

                        </div>
                    </div> *@
                </div>

                <a asp-controller="Employee"
                   asp-action="EmployeeList"
                   class="btn btn-primary">
                    <em class="icon ni ni-users me-1"></em>
                    Manage Employees
                </a>

            </div>


            <!-- HR KPI Cards -->
            <div class="row g-3 mb-4">

                <!-- Total Employees -->
                <div class="col-6 col-lg-3">
                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-primary-subtle text-primary mb-2">
                                Workforce
                            </span>

                            <div class="stat-num">
                                @ViewBag.TotalEmployees
                            </div>

                            <div class="small text-muted">
                                Total employees
                            </div>

                        </div>

                    </div>
                </div>


                <!-- Present Today -->
                <div class="col-6 col-lg-3">
                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-success-subtle text-success mb-2">
                                Present
                            </span>

                            <div class="stat-num">
                                @ViewBag.PresentToday
                            </div>

                            <div class="small text-muted">
                                Employees present today
                            </div>

                        </div>

                    </div>
                </div>


                <!-- Employees on Leave -->
                <div class="col-6 col-lg-3">
                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-warning-subtle text-warning-emphasis mb-2">
                                On Leave
                            </span>

                            <div class="stat-num">
                                @ViewBag.EmployeesOnLeave
                            </div>

                            <div class="small text-muted">
                                Employees on leave today
                            </div>

                        </div>

                    </div>
                </div>


                <!-- Pending Requests -->
                <div class="col-6 col-lg-3">
                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-danger-subtle text-danger mb-2">
                                Action Required
                            </span>

                            <div class="stat-num">
                                @ViewBag.PendingLeaveRequests
                            </div>

                            <div class="small text-muted">
                                Leave requests pending approval
                            </div>

                        </div>

                    </div>
                </div>

            </div>


            <!-- HR Dashboard Content -->
            <div class="row g-3">

                <!-- Recent Leave Requests -->
                <div class="col-lg-8">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <h3 class="fs-6 text-primary fw-bold mb-0">
                                    Recent Leave Requests
                                </h3>

                                <a asp-controller="LeaveManagement"
                                   asp-action="MyLeaves"
                                   class="btn btn-sm btn-outline-primary">
                                    View All
                                </a>

                            </div>

                            <div class="table-responsive">

                                <table class="table table-sm align-middle mb-0">

                                    <thead>
                                        <tr class="text-muted small text-uppercase">
                                            <th>Employee</th>
                                            <th>Leave Type</th>
                                            <th>Dates</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        <tr>
                                            <td>
                                                <strong>Ravi Kumar</strong>
                                            </td>

                                            <td>
                                                Casual Leave
                                            </td>

                                            <td>
                                                08 Aug 2026
                                            </td>

                                            <td>
                                                <span class="badge bg-warning-subtle text-warning-emphasis">
                                                    Pending
                                                </span>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>
                                                <strong>Manoj Kumar</strong>
                                            </td>

                                            <td>
                                                Sick Leave
                                            </td>

                                            <td>
                                                06 Aug 2026
                                            </td>

                                            <td>
                                                <span class="badge bg-success-subtle text-success">
                                                    Approved
                                                </span>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>
                                                <strong>Priya Sharma</strong>
                                            </td>

                                            <td>
                                                Earned Leave
                                            </td>

                                            <td>
                                                04 Aug 2026
                                            </td>

                                            <td>
                                                <span class="badge bg-success-subtle text-success">
                                                    Approved
                                                </span>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>
                                                <strong>Amit Singh</strong>
                                            </td>

                                            <td>
                                                Casual Leave
                                            </td>

                                            <td>
                                                02 Aug 2026
                                            </td>

                                            <td>
                                                <span class="badge bg-danger-subtle text-danger">
                                                    Rejected
                                                </span>
                                            </td>
                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Quick Actions -->
                <div class="col-lg-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body d-grid">

                            <h3 class="fs-6 text-primary fw-bold mb-2">
                                Quick Actions
                            </h3>

                            <a asp-controller="Employee"
                               asp-action="EmployeeList"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-users me-1"></em>
                                Employee Management

                            </a>

                            <a asp-controller="LeaveManagement"
                               asp-action="MyLeaves"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-calendar-check me-1"></em>
                                Manage Leave Requests

                            </a>

                            <a asp-controller="LeaveAdjustment"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-plus me-1"></em>
                                Adjust Leave Balance

                            </a>

                            <a asp-controller="HRPolicy"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-file-docs me-1"></em>
                                Manage HR Policies

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </main>
	</div>
</div>
<script>
    // Highlight active sidebar link
    document.addEventListener('DOMContentLoaded', () => {
      const path = location.pathname.split('/').pop() || 'dashboard.html';
      document.querySelectorAll('.sidebar a[data-page]').forEach(a => {
        if (a.getAttribute('data-page') === path) a.classList.add('active');
      });
    });

    // Bootstrap-style validation + fake submit -> redirect to confirmation page
    function handleFormSubmit(formId, redirectUrl, refPrefix) {
      const form = document.getElementById(formId);
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!form.checkValidity()) {
          form.classList.add('was-validated');
          return;
        }
        const ref = refPrefix + '-' + Math.floor(100000 + Math.random() * 900000);
        sessionStorage.setItem('lastRef', ref);
        sessionStorage.setItem('lastSubmitTime', new Date().toLocaleString('en-IN', {
          day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
        }));
        window.location.href = redirectUrl;
      }, false);
    }

    function fillReference(refLabel) {
      const refEl = document.getElementById('refNumber');
      const timeEl = document.getElementById('refTime');
      if (refEl) refEl.textContent = sessionStorage.getItem('lastRef') || (refLabel + '-482913');
      if (timeEl) timeEl.textContent = sessionStorage.getItem('lastSubmitTime') || new Date().toLocaleString('en-IN');
    }

    function handleLoginSubmit(formId, redirectUrl) {
      const form = document.getElementById(formId);
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!form.checkValidity()) {
          form.classList.add('was-validated');
          return;
        }
        window.location.href = redirectUrl;
      }, false);
    }

</script>





