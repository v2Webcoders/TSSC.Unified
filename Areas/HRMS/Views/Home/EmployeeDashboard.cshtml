@using QUIZAPP.ViewModel
@model TSSC.Unified.ViewModel.HRDashboardVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "~/Areas/HRMS/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "HRMS DASHBOARD";
}
@section Styles {
	<link rel="stylesheet" href="~/assets/css/EmployeeDashboard.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true" />
}


	

<div class="container-fluid">
    <div class="row">

        <main class="col-md-12 col-lg-12 p-4">

            <div class="d-flex flex-wrap justify-content-between align-items-start gap-4 mb-5">

                <div>

                    <h1 class="fs-4 text-primary fw-bold mb-1">
                        Welcome, @Model.EmployeeName 👋
                    </h1>

                    <div class="mt-0 mb-4">

                        <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">

                            <!-- Date -->
                            <span class="d-flex align-items-center">

                                <em class="icon ni ni-calendar-alt me-1"></em>

                                @DateTime.Today.ToString("dddd, dd MMMM yyyy")

                            </span>

                            <span class="text-light">•</span>


                            <!-- Status -->
                            @if (Model.TodayInTime.HasValue)
                            {
                                <span class="d-flex align-items-center text-success">

                                    <em class="icon ni ni-check-circle me-1"></em>

                                    Present

                                </span>
                            }
                            else
                            {
                                <span class="d-flex align-items-center text-warning">

                                    <em class="icon ni ni-clock me-1"></em>

                                    Not marked

                                </span>
                            }


                            <span class="text-light">•</span>


                            <!-- In -->
                            <span>
                                In:
                                @(Model.TodayInTime.HasValue
                                    ? Model.TodayInTime.Value.ToString("hh:mm tt")
                                    : "--")
                            </span>


                            <span class="text-light">•</span>


                            <!-- Out -->
                            <span>
                                Out:
                                @(Model.TodayOutTime.HasValue
                                    ? Model.TodayOutTime.Value.ToString("hh:mm tt")
                                    : "--")
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            @if (Model.DOB.HasValue)
            {
                var dob = Model.DOB.Value;

                bool isBirthdayToday =
                dob.Month == DateTime.Today.Month &&
                dob.Day == DateTime.Today.Day;

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="rounded-circle bg-primary-subtle
                            text-primary
                            d-flex align-items-center
                            justify-content-center me-3"
                                 style="width:50px;height:50px;">

                                <em class="icon ni ni-gift fs-5"></em>

                            </div>

                            <div>

                                @if (isBirthdayToday)
                                {
                                    <h6 class="mb-1 text-primary">
                                        🎂 Happy Birthday, @Model.EmployeeName!
                                    </h6>

                                    <p class="text-muted small mb-0">
                                        Wishing you a wonderful year ahead.
                                    </p>
                                }
                                else
                                {
                                    <h6 class="mb-1">
                                        🎂 Your Birthday
                                    </h6>

                                    <p class="text-muted small mb-0">
                                        @dob.ToString("dd MMMM")
                                    </p>
                                }

                            </div>

                        </div>

                    </div>
                </div>
            }
            <!-- =========================================
                 EMPLOYEE KPI CARDS
            ========================================== -->

            <div class="row g-3 mb-4">


                <!-- Present Days -->
                <div class="col-6 col-lg-3">

                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-success-subtle text-success mb-2">
                                Attendance
                            </span>

                            <div class="stat-num" data-bs-toggle="tooltip"
                                 data-bs-placement="top"
                                 title="@Model.PresentDaysThisMonth days present out of @Model.WorkingDaysThisMonth working days this month">
                         
                                @Model.PresentDaysThisMonth
                                
                                    / @Model.WorkingDaysThisMonth
                               
                            </div>

                            <div class="small text-muted">
                                Days Present / Working Days — This Month
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Pending Requests -->
                <div class="col-6 col-lg-3">

                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-warning-subtle text-warning-emphasis mb-2">
                                Pending
                            </span>

                            <div class="stat-num">
                                @Model.PendingRequests
                            </div>

                            <div class="small text-muted">
                               Leave Requests awaiting approval
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Leave Balance -->
                <div class="col-6 col-lg-3">

                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-primary-subtle text-primary mb-2">
                                Balance
                            </span>

                            <div class="stat-num">
                                @Model.LeaveBalance
                            </div>

                            <div class="small text-muted">
                                Leave days remaining
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Attendance Regularization -->
                <div class="col-6 col-lg-3">

                    <div class="card card-stat h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-danger-subtle text-danger mb-2">
                                Action
                            </span>

                            <div class="stat-num">
                                @Model.AttendanceToRegularize
                            </div>

                            <div class="small text-muted">
                                Attendance to regularize
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================================
                 RECENT REQUESTS + QUICK ACTIONS
            ========================================== -->

            <div class="row g-3">


                <!-- Recent Requests -->
                <div class="col-lg-8">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body">

                            <h3 class="fs-6 text-primary fw-bold mb-3">
                                Recent Requests
                            </h3>


                            <div class="table-responsive">

                                <table class="table table-sm align-middle mb-0">

                                    <thead>

                                        <tr class="text-muted small text-uppercase">

                                            <th>
                                                Type
                                            </th>

                                            <th>
                                                Date
                                            </th>

                                            <th>
                                                Status
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        @if (Model.RecentRequests != null &&
                                        Model.RecentRequests.Any())
                                        {
                                            foreach (var item in Model.RecentRequests)
                                            {
                                                <tr>

                                                    <td>
                                                        @item.RequestType
                                                    </td>

                                                    <td>
                                                        @item.RequestDate.ToString("dd MMM yyyy")
                                                    </td>

                                                    <td>

                                                        @if (item.Status == "Pending")
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning-emphasis">
                                                                Pending
                                                            </span>
                                                        }
                                                        else if (item.Status == "Approved")
                                                        {
                                                            <span class="badge bg-success-subtle text-success">
                                                                Approved
                                                            </span>
                                                        }
                                                        else if (item.Status == "Rejected")
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger">
                                                                Rejected
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-muted">
                                                                @item.Status
                                                            </span>
                                                        }

                                                    </td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>

                                                <td colspan="3"
                                                    class="text-center text-muted py-4">

                                                    No recent requests found.

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Quick Actions -->
                <div class="col-lg-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body d-grid">

                            <h3 class="fs-6 text-primary fw-bold mb-2">
                                Quick Actions
                            </h3>

                            <!-- Mark Attendance -->
                            <a asp-controller="Employee"
                               asp-action="MarkAttendance"
                               class="btn btn-primary">

                                <em class="icon ni ni-check-circle me-1"></em>

                                Mark Attendance

                            </a>

                            <a asp-controller="Attendance"
                               asp-action="MyAttendance"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-reload me-1"></em>

                                Regularize Attendance

                            </a>


                            <a asp-controller="LeaveRequest"
                               asp-action="Create"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-calendar-check me-1"></em>

                                Apply for Leave

                            </a>


                            <a asp-controller="Attendance"
                               asp-action="ApplyOD"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-map-pin me-1"></em>

                                Apply for OD

                            </a>


                            @* <a asp-controller="HRPolicy"
                               asp-action="EmployeePolicies"
                               class="btn btn-outline-primary">

                                <em class="icon ni ni-file-docs me-1"></em>

                                View HR Policies

                            </a> *@

                        </div>

                    </div>

                </div>

            </div>

        </main>

    </div>
</div>

