<script>
	// Highlight active sidebar link
	document.addEventListener('DOMContentLoaded', () => {
	  const path = location.pathname.split('/').pop() || 'dashboard.html';
	  document.querySelectorAll('.sidebar a[data-page]').forEach(a => {
		if (a.getAttribute('data-page') === path) a.classList.add('active');
	  });
	});

	// Bootstrap-style validation + fake submit -> redirect to confirmation page
	function handleFormSubmit(formId, redirectUrl, refPrefix) {
	  const form = document.getElementById(formId);
	  if (!form) return;
	  form.addEventListener('submit', (e) => {
		e.preventDefault();
		e.stopPropagation();
		if (!form.checkValidity()) {
		  form.classList.add('was-validated');
		  return;
		}
		const ref = refPrefix + '-' + Math.floor(100000 + Math.random() * 900000);
		sessionStorage.setItem('lastRef', ref);
		sessionStorage.setItem('lastSubmitTime', new Date().toLocaleString('en-IN', {
		  day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
		}));
		window.location.href = redirectUrl;
	  }, false);
	}

	function fillReference(refLabel) {
	  const refEl = document.getElementById('refNumber');
	  const timeEl = document.getElementById('refTime');
	  if (refEl) refEl.textContent = sessionStorage.getItem('lastRef') || (refLabel + '-482913');
	  if (timeEl) timeEl.textContent = sessionStorage.getItem('lastSubmitTime') || new Date().toLocaleString('en-IN');
	}

	function handleLoginSubmit(formId, redirectUrl) {
	  const form = document.getElementById(formId);
	  if (!form) return;
	  form.addEventListener('submit', (e) => {
		e.preventDefault();
		e.stopPropagation();
		if (!form.checkValidity()) {
		  form.classList.add('was-validated');
		  return;
		}
		window.location.href = redirectUrl;
	  }, false);
	}

</script>