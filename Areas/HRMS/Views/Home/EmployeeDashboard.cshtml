							<div class="card-body">
								<span class="badge bg-warning-subtle text-warning-emphasis mb-2">Pending</span>
								<div class="stat-num">2</div>
								<div class="small text-muted">Requests awaiting approval</div>
							</div>
						</div>
					</div>
					<div class="col-6 col-lg-3">
						<div class="card card-stat h-100 border-0 shadow-sm">
							<div class="card-body">
								<span class="badge bg-primary-subtle text-primary mb-2">Balance</span>
								<div class="stat-num">14</div>
								<div class="small text-muted">Leave days remaining</div>
							</div>
						</div>
					</div>
					<div class="col-6 col-lg-3">
						<div class="card card-stat h-100 border-0 shadow-sm">
							<div class="card-body">
								<span class="badge bg-danger-subtle text-danger mb-2">Action</span>
								<div class="stat-num">1</div>
								<div class="small text-muted">Attendance to regularize</div>
							</div>
						</div>
					</div>
				</div>

				<div class="row g-3">
					<div class="col-lg-8">
						<div class="card border-0 shadow-sm h-100">
							<div class="card-body">
								<h3 class="fs-6 text-primary fw-bold mb-3">Recent Requests</h3>
								<table class="table table-sm align-middle mb-0">
									<thead><tr class="text-muted small text-uppercase"><th>Type</th><th>Date</th><th>Status</th></tr></thead>
									<tbody>
										<tr><td>Leave Request</td><td>22 Jul 2026</td><td><span class="badge bg-warning-subtle text-warning-emphasis">Pending</span></td></tr>
										<tr><td>OD Request</td><td>18 Jul 2026</td><td><span class="badge bg-success-subtle text-success">Approved</span></td></tr>
										<tr><td>Regularization</td><td>14 Jul 2026</td><td><span class="badge bg-success-subtle text-success">Approved</span></td></tr>
										<tr><td>Leave Request</td><td>02 Jul 2026</td><td><span class="badge bg-danger-subtle text-danger">Rejected</span></td></tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
					<div class="col-lg-4">
						<div class="card border-0 shadow-sm h-100">


							<div class="card-body d-grid ">

								<h3 class="fs-6 text-primary fw-bold mb-2">Quick Actions</h3>
								<a class="btn btn-outline-primary" href="regularization.html">↻ Regularize Attendance</a>
								<a class="btn btn-outline-primary" href="leave-request.html">🗓 Apply for Leave</a>
								<a class="btn btn-outline-primary" href="od-request.html">🧭 Apply for OD</a>
								<a class="btn btn-outline-primary" href="hr-policy.html">📄 View HR Policies</a>
							</div>
						</div>
					</div>
				</div>
			</main>
