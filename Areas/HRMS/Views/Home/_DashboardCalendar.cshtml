<link href="~/assets/css/calendarwidget.css" rel="stylesheet" />

<div class="dashboard-calendar-widget">
    <!-- Header -->
    <div class="calendar-header">
        <button class="calendar-nav-btn prev" id="prevMonth">
            <em class="icon ni ni-chevron-left"></em>
        </button>
        <h6 class="calendar-title" id="calendarTitle">December 2026</h6>
        <button class="calendar-nav-btn next" id="nextMonth">
            <em class="icon ni ni-chevron-right"></em>
        </button>
    </div>

    <!-- Weekday Labels -->
    <div class="calendar-weekdays">
        <span class="weekday">Sun</span>
        <span class="weekday">Mon</span>
        <span class="weekday">Tue</span>
        <span class="weekday">Wed</span>
        <span class="weekday">Thu</span>
        <span class="weekday">Fri</span>
        <span class="weekday">Sat</span>
    </div>

    <!-- Calendar Days -->
    <div class="calendar-days" id="calendarDays"></div>

    <!-- Today Button -->
    <div class="calendar-footer">
        <button class="btn-today" id="todayBtn">Today</button>
    </div>
</div>

