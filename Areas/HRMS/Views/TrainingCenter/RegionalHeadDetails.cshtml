                    </div>

                </div>

                <hr />

                <!-- FACILITIES AND SCHEMES -->
                <div class="nk-block-head mt-4">
                    <h5 class="title">
                        <span style="border-left:5px solid #D9622F;padding-left:12px;">
                            <em class="icon ni ni-list-check me-1"></em>
                            Facilities &amp; Schemes
                        </span>
                    </h5>
                </div>

                <div class="row gy-3">

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Self Funded</label>
                            <div class="form-control bg-light">@BoolVal(Model.SelfFunded)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">NSDC</label>
                            <div class="form-control bg-light">@BoolVal(Model.NSDC)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">STAR</label>
                            <div class="form-control bg-light">@BoolVal(Model.STAR)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">MoRD</label>
                            <div class="form-control bg-light">@BoolVal(Model.MoRD)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">State Government Schemes</label>
                            <div class="form-control bg-light">@BoolVal(Model.StateGovernmentSchemes)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Other Central Government Schemes</label>
                            <div class="form-control bg-light">@BoolVal(Model.OtherCentralGovernmentSchemes)</div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label">Center Description</label>
                            <div class="form-control bg-light"
                                 style="min-height:80px;white-space:pre-wrap;height:auto;">
                                @Val(Model.CenterDescription)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label">Equipment Details</label>
                            <div class="form-control bg-light"
                                 style="min-height:70px;white-space:pre-wrap;height:auto;">
                                @Val(Model.EquipmentDetails)
                            </div>
                        </div>
                    </div>

                </div>

                <hr />

                <!-- DOCUMENTS / PHOTOS -->
                <div class="nk-block-head mt-4">
                    <h5 class="title">
                        <span style="border-left:5px solid #D9622F;padding-left:12px;">
                            <em class="icon ni ni-file-img me-1"></em>
                            Center Photos &amp; Documents
                        </span>
                    </h5>
                </div>

                <div class="row gy-3">

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Approach Road Photo</label>
                            <div class="form-control bg-light d-flex align-items-center">
                                @if (!string.IsNullOrWhiteSpace(approachRoadPhoto))
                                {
                                    <a href="@PhotoUrl(approachRoadPhoto)" target="_blank"
                                       rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                        <em class="icon ni ni-eye"></em> View Photo
                                    </a>
                                }
                                else
                                {
                                    <span>Not uploaded</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Outside Classroom Photo</label>
                            <div class="form-control bg-light d-flex align-items-center">
                                @if (!string.IsNullOrWhiteSpace(outsideClassroomPhoto))
                                {
                                    <a href="@PhotoUrl(outsideClassroomPhoto)" target="_blank"
                                       rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                        <em class="icon ni ni-eye"></em> View Photo
                                    </a>
                                }
                                else
                                {
                                    <span>Not uploaded</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Inside Classroom Photo</label>
                            <div class="form-control bg-light d-flex align-items-center">
                                @if (!string.IsNullOrWhiteSpace(insideClassroomPhoto))
                                {
                                    <a href="@PhotoUrl(insideClassroomPhoto)" target="_blank"
                                       rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                        <em class="icon ni ni-eye"></em> View Photo
                                    </a>
                                }
                                else
                                {
                                    <span>Not uploaded</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Lab Photo</label>
                            <div class="form-control bg-light d-flex align-items-center">
                                @if (!string.IsNullOrWhiteSpace(labPhoto))
                                {
                                    <a href="@PhotoUrl(labPhoto)" target="_blank"
                                       rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                        <em class="icon ni ni-eye"></em> View Photo
                                    </a>
                                }
                                else
                                {
                                    <span>Not uploaded</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">CCTV Photo</label>
                            <div class="form-control bg-light d-flex align-items-center">
                                @if (!string.IsNullOrWhiteSpace(cctvPhoto))
                                {
                                    <a href="@PhotoUrl(cctvPhoto)" target="_blank"
                                       rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                        <em class="icon ni ni-eye"></em> View Photo
                                    </a>
                                }
                                else
                                {
                                    <span>Not uploaded</span>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <hr />


               

                <!-- REGIONAL HEAD VIEW: READ-ONLY INSPECTION INFORMATION -->
                <div class="nk-block-head mt-4">
                    <h5 class="title">
                        <span style="border-left:5px solid #D9622F;padding-left:12px;">
                            <em class="icon ni ni-calendar me-1"></em>
                            Inspection Information
                        </span>
                    </h5>
                </div>

                <div class="row gy-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Inspection Status</label>
                            <div class="form-control bg-light">
                                @Val(Model.InspectionStatus ?? "Not Scheduled")
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Inspection Date &amp; Time</label>
                            <div class="form-control bg-light">
                                @DateTimeVal(Model.InspectionDate)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Created Date</label>
                            <div class="form-control bg-light">
                                @DateVal(Model.InspectionCreatedDate)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Inspection Mode</label>
                            <div class="form-control bg-light">
                                @Val(Model.InspectionMode)
                            </div>
                        </div>
                    </div>

                    @if (Model.InspectionMode == "Online" && !string.IsNullOrWhiteSpace(Model.InspectionLink))
                    {
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">Inspection Link</label>
                                <div class="form-control bg-light">
                                    @if (Uri.TryCreate(Model.InspectionLink, UriKind.Absolute, out var meetingUri) &&
                                                                    (meetingUri.Scheme == Uri.UriSchemeHttps || meetingUri.Scheme == Uri.UriSchemeHttp))
                                    {
                                        <a href="@meetingUri.AbsoluteUri" target="_blank" rel="noopener noreferrer">
                                            Join Inspection
                                        </a>
                                    }
                                    else
                                    {
                                        <span>Invalid inspection link</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label">Inspection Remarks</label>
                            <div class="form-control bg-light"
                                 style="min-height:70px;white-space:pre-wrap;height:auto;">
                                @Val(ViewBag.RegionalInspectionRemarks as string)
                            </div>
                        </div>
                    </div>
                    @if (ViewBag.CurrentApprovalRole?.ToString() == "VerticalHead"){
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Regional Head Status</label>
                            <div class="form-control bg-light">
                                @Val(ViewBag.RegionalHeadStatus as string)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label">Regional Head Remarks</label>
                            <div class="form-control bg-light"
                                 style="min-height:70px;white-space:pre-wrap;height:auto;">
                                @Val(ViewBag.RegionalHeadRemarks as string)
                            </div>
                        </div>
                    </div>
                    }
                </div>


                <!-- REGIONAL HEAD ACTION SECTION -->
                @if (ViewBag.CurrentApprovalRole?.ToString() == "RegionalHead"
                                && ViewBag.RegionalHeadStatus?.ToString() == "Pending")
                {
                    <form asp-area="HRMS"
                          asp-controller="TrainingCenter"
                          asp-action="RegionalHeadUpdateStatus"
                          method="post">

                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="card card-bordered">
                            <div class="card-inner">
                                <div class="form-group">
                                    <label class="form-label">
                                        Regional Remarks <span class="text-danger">*</span>
                                    </label>

                                    <textarea name="regionalHeadRemarks"
                                          class="form-control"
                                          rows="3"
                                          maxlength="1000"
                                          placeholder="Enter regional remarks..."
                                          required></textarea>
                                </div>

                                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4 pb-3">
                                    <button type="submit" name="status"
                                            value="On Hold" class="btn btn-info">
                                        On Hold
                                    </button>

                                    <button type="submit" name="status"
                                            value="Rejected" class="btn btn-danger">
                                        Reject
                                    </button>

                                    <button type="submit" name="status"
                                            value="Approved" class="btn btn-success">
                                        Send to Vertical Head
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                }
                @if (ViewBag.IsVerticalHeadWorkflow == true
                                && ViewBag.VerticalHeadStatus?.ToString() == "Pending")
                {
                    <!-- VERTICAL HEAD ACTION SECTION -->
                    <div class="card card-bordered mt-4">
                        <div class="card-inner">
                            <h5 class="title mb-3">Vertical Head Review</h5>

                            <form asp-area="HRMS"
                                  asp-controller="TrainingCenter"
                                  asp-action="VerticalHeadUpdateStatus"
                                  method="post">

                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />

                                <div class="form-group">
                                    <label class="form-label">
                                        Vertical Head Remarks
                                        <span class="text-danger">*</span>
                                    </label>

                                    <textarea name="verticalHeadRemarks"
                                          class="form-control"
                                          rows="3"
                                          maxlength="1000"
                                          required
                                          placeholder="Enter Vertical Head remarks..."></textarea>
                                </div>

                                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4 pb-3">
                                    <button type="submit"
                                            name="status"
                                            value="On Hold"
                                            class="btn btn-info">
                                        On Hold
                                    </button>

                                    <button type="submit"
                                            name="status"
                                            value="Rejected"
                                            class="btn btn-danger">
                                        Reject
                                    </button>

                                    <button type="submit"
                                            name="status"
                                            value="Approved"
                                            class="btn btn-success">
                                        Send to Business Head
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
                @if (ViewBag.BusinessHeadWorkflow == true
                                && ViewBag.VerticalHeadStatus?.ToString() == "Approved"
                                && (ViewBag.BusinessHeadStatus?.ToString() == "Pending"
                                || ViewBag.BusinessHeadStatus?.ToString() == "On Hold"))
                {
                    <form asp-area="HRMS"
                          asp-controller="TrainingCenter"
                          asp-action="BusinessHeadUpdateStatus"
                          method="post">

                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="card card-bordered mt-4">
                            <div class="card-inner">

                                <h5 class="title mb-3">Business Head Review</h5>

                                <div class="form-group">
                                    <label class="form-label">
                                        Business Head Remarks
                                        <span class="text-danger">*</span>
                                    </label>

                                    <textarea name="businessHeadRemarks"
                                          class="form-control"
                                          rows="3"
                                          maxlength="1000"
                                          placeholder="Enter Business Head remarks..."
                                          required></textarea>
                                </div>

                                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4 pb-3">

                                    <button type="submit"
                                            name="status"
                                            value="On Hold"
                                            class="btn btn-info">
                                        On Hold
                                    </button>

                                    <button type="submit"
                                            name="status"
                                            value="Rejected"
                                            class="btn btn-danger">
                                        Reject
                                    </button>

                                    <button type="submit"
                                            name="status"
                                            value="Approved"
                                            class="btn btn-success">
                                        Send to CEO
                                    </button>

                                </div>
                            </div>
                        </div>
                    </form>
                }

                else
                {
                    <div class="card card-bordered mt-4">
                        <div class="card-inner">
                            <h5 class="title mb-3">Approval Status & Remarks</h5>

                            <!-- REGIONAL HEAD -->
                            <div class="form-group">
                                <label class="form-label">Regional Head Status</label>
                                <input type="text"
                                       class="form-control"
                                       value="@(ViewBag.RegionalHeadStatus ?? "Not Updated")"
                                       readonly />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                                    ViewBag.RegionalHeadRemarks?.ToString()))
                            {
                                <div class="form-group mt-3">
                                    <label class="form-label">Regional Head Remarks</label>
                                    <textarea class="form-control"
                                      rows="3"
                                      readonly>@ViewBag.RegionalHeadRemarks</textarea>
                                </div>
                            }

                            <hr class="my-4" />

                            <!-- VERTICAL HEAD -->
                            <div class="form-group">
                                <label class="form-label">Vertical Head Status</label>
                                <input type="text"
                                       class="form-control"
                                       value="@(ViewBag.VerticalHeadStatus ?? "Not Updated")"
                                       readonly />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                                    ViewBag.VerticalHeadRemarks?.ToString()))
                            {
                                <div class="form-group mt-3">
                                    <label class="form-label">Vertical Head Remarks</label>
                                    <textarea class="form-control"
                                      rows="3"
                                      readonly>@ViewBag.VerticalHeadRemarks</textarea>
                                </div>
                            }

                            <hr class="my-4" />

                            <!-- BUSINESS HEAD -->
                            <div class="form-group">
                                <label class="form-label">Business Head Status</label>
                                <input type="text"
                                       class="form-control"
                                       value="@(ViewBag.BusinessHeadStatus ?? "Not Updated")"
                                       readonly />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                                    ViewBag.BusinessHeadRemarks?.ToString()))
                            {
                                <div class="form-group mt-3">
                                    <label class="form-label">Business Head Remarks</label>
                                    <textarea class="form-control"
                                      rows="3"
                                      readonly>@ViewBag.BusinessHeadRemarks</textarea>
                                </div>
                            }
                        </div>
                    </div>
                }



                <div class="d-flex justify-content-end mt-4">
                    <a asp-area="HRMS"
                       asp-controller="TrainingCenter"
                       asp-action="RegionalHeadInspection"
                       asp-route-tab="@(ViewBag.ActiveTab ?? "Pending")"
                       class="btn btn-light">
                        <em class="icon ni ni-arrow-left"></em>
                        <span>Back to List</span>
                    </a>
                </div>


            </div>
        </div>
    </div>
</div>
