                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">SPOC Email</label>
                            <div class="form-control bg-light text-break">@Val(Model.TrainingCenterSPOCEmail)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">SPOC Contact Number</label>
                            <div class="form-control bg-light">@Val(Model.SPOCContactNumber)</div>
