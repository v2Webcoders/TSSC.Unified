                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Finance Status</label>
                            <div class="form-control bg-light">@Val(Model.FinanceStatus)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Center Status</label>
                            <div class="form-control bg-light">@Val(Model.Status)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Company Seal</label>
                            <div class="form-control bg-light d-flex align-items-center">
                                @if (!string.IsNullOrWhiteSpace(companySeal))
                                {
                                    <a href="@PhotoUrl(companySeal)"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-outline-primary">
                                        <em class="icon ni ni-eye"></em>
                                        View Seal
                                    </a>
                                }
                                else
                                {
                                    <span>Not uploaded</span>
                                }
                            </div>
