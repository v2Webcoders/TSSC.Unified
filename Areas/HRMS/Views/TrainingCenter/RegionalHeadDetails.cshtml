                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">QP Hours</label>
                            <div class="form-control bg-light">
                                @(Model.QPHours.HasValue? Model.QPHours.Value.ToString("0.##") : "—")
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Center Type</label>
                            <div class="form-control bg-light">@Val(Model.CenterType)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Ownership Type</label>
                            <div class="form-control bg-light">@Val(Model.CenterOwnershipType)</div>
                        </div>
                    </div>

                    <div class="col-md-4">
