@model TSSC.Unified.ViewModel.TrainingCenterViewModel

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Training Center Details";

    string approachRoadPhoto = ViewBag.ApproachRoadPhotoPath as string ?? "";
    string outsideClassroomPhoto = ViewBag.OutsideClassroomPhotoPath as string ?? "";
    string insideClassroomPhoto = ViewBag.InsideClassroomPhotoPath as string ?? "";
    string labPhoto = ViewBag.LabPhotoPath as string ?? "";
    string cctvPhoto = ViewBag.CCTVPhotoPath as string ?? "";
    string companySeal = ViewBag.CompanySealPath as string ?? "";

    bool isScheduled = string.Equals(
        Model.InspectionStatus,
        "Scheduled",
        StringComparison.OrdinalIgnoreCase);
}

@functions {
    string Val(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    string BoolVal(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "—";

        if (bool.TryParse(value, out bool result))
            return result ? "Yes" : "No";

        return value.Trim();
    }

    string DateVal(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd-MM-yyyy") : "—";

    string DateTimeVal(DateTime? value) =>
        value.HasValue
            ? value.Value.ToString("dd-MM-yyyy hh:mm tt")
            : "Not Scheduled";

    string PhotoUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return string.Empty;

        if (Uri.TryCreate(path, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp ||
                uri.Scheme == Uri.UriSchemeHttps))
        {
            return path;
        }

        return Url.Content("~/" + path.TrimStart('~', '/'));
    }
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">Training Center Details</h3>
        </div>

        <div class="nk-block-head-content">
            <a asp-area="HRMS"
               asp-controller="TrainingCenter"
               asp-action="InspectionList"
               class="btn btn-primary">
                <em class="icon ni ni-arrow-left"></em>
                <span>Inspection List</span>
            </a>
        </div>
    </div>
</div>

<div class="nk-block nk-block-lg">

