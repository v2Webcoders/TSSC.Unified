            </div>

            <div class="row gy-3">

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Approach Road Photo</label>
                        <div class="form-control bg-light d-flex align-items-center">
                            @if (!string.IsNullOrWhiteSpace(approachRoadPhoto))
                            {
                                <a href="@PhotoUrl(approachRoadPhoto)" target="_blank"
                                   rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                    <em class="icon ni ni-eye"></em> View Photo
                                </a>
                            }
                            else
                            {
                                <span>Not uploaded</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Outside Classroom Photo</label>
                        <div class="form-control bg-light d-flex align-items-center">
                            @if (!string.IsNullOrWhiteSpace(outsideClassroomPhoto))
                            {
                                <a href="@PhotoUrl(outsideClassroomPhoto)" target="_blank"
                                   rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                    <em class="icon ni ni-eye"></em> View Photo
                                </a>
                            }
                            else
                            {
                                <span>Not uploaded</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Inside Classroom Photo</label>
                        <div class="form-control bg-light d-flex align-items-center">
                            @if (!string.IsNullOrWhiteSpace(insideClassroomPhoto))
                            {
                                <a href="@PhotoUrl(insideClassroomPhoto)" target="_blank"
                                   rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                    <em class="icon ni ni-eye"></em> View Photo
                                </a>
                            }
                            else
                            {
                                <span>Not uploaded</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Lab Photo</label>
                        <div class="form-control bg-light d-flex align-items-center">
                            @if (!string.IsNullOrWhiteSpace(labPhoto))
                            {
                                <a href="@PhotoUrl(labPhoto)" target="_blank"
                                   rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                    <em class="icon ni ni-eye"></em> View Photo
                                </a>
                            }
                            else
                            {
                                <span>Not uploaded</span>
                            }
