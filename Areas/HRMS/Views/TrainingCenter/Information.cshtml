                        <div class="form-control bg-light d-flex align-items-center">
                            @if (!string.IsNullOrWhiteSpace(cctvPhoto))
                            {
                                <a href="@PhotoUrl(cctvPhoto)" target="_blank"
                                   rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                    <em class="icon ni ni-eye"></em> View Photo
                                </a>
                            }
                            else
                            {
                                <span>Not uploaded</span>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <hr />


                <!-- INSPECTION INFORMATION -->
                <div class="nk-block-head mt-4">
                    <h5 class="title">
                        <span style="border-left:5px solid #D9622F;padding-left:12px;">
                            <em class="icon ni ni-calendar me-1"></em>
                            Inspection Information
                        </span>
                    </h5>
                </div>

                <div class="row gy-3">

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Inspection Status</label>
                            <div class="form-control bg-light">
                                @Val(Model.InspectionStatus ?? "Not Scheduled")
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Inspection Date &amp; Time</label>
                            <div class="form-control bg-light">
                                @DateTimeVal(Model.InspectionDate)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Created Date</label>
                            <div class="form-control bg-light">
                                @DateVal(Model.InspectionCreatedDate)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Inspection Mode</label>
                            <div class="form-control bg-light">
                                @Val(Model.InspectionMode)
                            </div>
                        </div>
                    </div>

                    @if (Model.InspectionMode == "Online" &&
                                        !string.IsNullOrWhiteSpace(Model.InspectionLink))
                    {
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">Inspection Link</label>
                                <div class="form-control bg-light">
                                    @if (Uri.TryCreate(Model.InspectionLink,
                                                                    UriKind.Absolute, out var meetingUri) &&
                                                                    (meetingUri.Scheme == Uri.UriSchemeHttps ||
                                                                    meetingUri.Scheme == Uri.UriSchemeHttp))
                                    {
                                        <a href="@meetingUri.AbsoluteUri"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            Join Inspection
                                        </a>
                                    }
                                    else
                                    {
                                        <span>Invalid inspection link</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @* <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label">Inspection Remarks</label>
                            <div class="form-control bg-light"
                                 style="min-height:70px;white-space:pre-wrap;height:auto;">
                                @Val(Model.InspectionRemarks)
                            </div>
                        </div>
                    </div>*@

                </div>



                <!-- ACTION BUTTONS -->
                <div class="row mt-4">
                    <div class="col-md-12">

                        @if (string.IsNullOrWhiteSpace(Model.InspectionStatus)
                                                || Model.InspectionStatus.Equals(
                                                "Pending",
                                                StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="d-flex justify-content-end">
                                <button type="button"
                                        id="toggleInspectionForm"
                                        class="btn btn-primary">
                                    <em class="icon ni ni-calendar"></em>
                                    Schedule for Inspection
                                </button>
                            </div>
                        }

                        @if (string.Equals(
                                                Model.InspectionStatus,
                                                "Scheduled",
                                                StringComparison.OrdinalIgnoreCase))
                            {
                                <form asp-area="HRMS"
                                      asp-controller="TrainingCenter"
                                      asp-action="UpdateInspectionStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />

                                    <div class="form-group">
                                        <label class="form-label">
                                            Inspection Remarks
                                            <span class="text-danger">*</span>
                                        </label>

                                        <textarea id="inspectionRemarks"
                                          name="inspectionRemarks"
                                          class="form-control"
                                          rows="3"
                                          maxlength="1000"
                                          placeholder="Enter inspection remarks..."
                                          required></textarea>
                                    </div>

                                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4 pb-3">

                                        <button type="submit"
                                                name="actionType"
                                                value="OnHold"
                                                class="btn btn-info">
                                            On Hold
                                        </button>

                                        <button type="submit"
                                                name="actionType"
                                                value="Reject"
                                                class="btn btn-danger">
                                            Reject
                                        </button>

                                        <button type="button"
                                                id="btnSendToRegional"
                                                class="btn btn-success">
                                            Send to Regional Head
                                        </button>

                                    </div>
                                </form>
                            }


                        <div class="d-flex justify-content-end mt-4">
                            <a asp-area="HRMS"
                               asp-controller="TrainingCenter"
                               asp-action="InspectionList"
                               class="btn btn-light">
                                <em class="icon ni ni-arrow-left"></em>
                                Back to List
                            </a>
                        </div>

                    </div>
                </div>


                <!-- REGIONAL HEAD SELECTION CARD -->
                <div id="regionalHeadCard"
                     class="card card-bordered mt-4"
                     style="display:none;">

                    <div class="card-inner">

                        <form asp-area="HRMS"
                              asp-controller="TrainingCenter"
                              asp-action="SendToRegionalHead"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <input type="hidden"
                                   id="regionalInspectionRemarks"
                                   name="inspectionRemarks" />

                            <div class="form-group">
                                <label class="form-label fw-bold">
                                    Select Regional Head
                                    <span class="text-danger">*</span>
                                </label>

                                <select id="regionalHeadId"
                                        name="regionalHeadEmployeeId"
                                        class="form-select"
                                        required>
                                    <option value="">Select Regional Head</option>

                                    @if (ViewBag.RegionalHeads != null)
                                    {
                                        foreach (var head in ViewBag.RegionalHeads)
                                        {
                                            <option value="@head.EmployeeId">
                                                @(head.Name + " (" + head.Email + ")")
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-5 pt-3">

                                <button type="button"
                                        id="cancelRegionalHead"
                                        class="btn btn-info">
                                    Cancel
                                </button>

                                <button type="submit"
                                        id="confirmRegionalHead"
                                        class="btn btn-success">
                                    Send
                                </button>

                            </div>

                        </form>
                    </div>
                </div>



                <!-- INLINE SCHEDULE FORM -->
                <div id="inspectionFormContainer"
                     class="card card-bordered mt-4"
                     style="display:none;">

                    <div class="card-inner">

                        <div class="nk-block-head">
                            <h5 class="title"
                                style="border-left:5px solid #D9622F;padding-left:12px;">
                                @(isScheduled
                                                                ? "Update Inspection Schedule"
                                                                : "Schedule New Inspection")
                            </h5>
                        </div>

                        <form asp-area="HRMS"
                              asp-controller="TrainingCenter"
                              asp-action="ScheduleInspection"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="row gy-3">

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Inspection Date &amp; Time
                                        <span class="text-danger">*</span>
                                    </label>

                                    <input type="datetime-local"
                                           id="inspectionDate"
                                           name="inspectionDate"
                                           class="form-control"
                                           value="@(Model.InspectionDate.HasValue
                                                          ? Model.InspectionDate.Value.ToString("yyyy-MM-ddTHH:mm")
                                                          : "")"
                                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                           required />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Inspection Mode
                                        <span class="text-danger">*</span>
                                    </label>

                                    <select name="inspectionMode"
                                            id="inspectionMode"
                                            class="form-select"
                                            required>
                                        <option value="">Select Mode</option>
                                        <option value="Online"
                                                selected="@(Model.InspectionMode == "Online")">
                                            Online
                                        </option>
                                        <option value="Offline"
                                                selected="@(Model.InspectionMode == "Offline")">
                                            Offline
                                        </option>
                                    </select>
                                </div>

                                <div class="col-md-4"
                                     id="inspectionLinkContainer">
                                    <label class="form-label">
                                        Inspection Link
                                        <span id="inspectionLinkRequired"
                                              class="text-danger">*</span>
                                    </label>

                                    <input type="url"
                                           name="inspectionLink"
                                           id="inspectionLink"
                                           class="form-control"
                                           maxlength="1000"
                                           value="@Model.InspectionLink"
                                           placeholder="https://meet.google.com/..." />

                                    <small class="text-soft">
                                        Required for Online inspection only.
                                    </small>
                                </div>

                            </div>

                            <div class="mt-4 d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-success">
                                    <em class="icon ni ni-check-circle"></em>
                                    Save Inspection
                                </button>

                                <button type="button"
                                        id="cancelInspectionForm"
                                        class="btn btn-light">
                                    Cancel
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

                <script>
                document.addEventListener("DOMContentLoaded", function () {
                const toggleButton = document.getElementById("toggleInspectionForm");
                const cancelButton = document.getElementById("cancelInspectionForm");
                const formContainer = document.getElementById("inspectionFormContainer");
                const modeSelect = document.getElementById("inspectionMode");
                const linkInput = document.getElementById("inspectionLink");
                const linkContainer = document.getElementById("inspectionLinkContainer");
                const requiredMark = document.getElementById("inspectionLinkRequired");

                if (!toggleButton || !formContainer) {
                console.error("Inspection schedule button or form is missing.");
                return;
                }

                toggleButton.addEventListener("click", function () {
                formContainer.style.display = "block";

                if (modeSelect && linkInput && linkContainer && requiredMark) {
                updateLinkField();
                }

                formContainer.scrollIntoView({
                behavior: "smooth",
                block: "start"
                });
                });

                if (cancelButton) {
                cancelButton.addEventListener("click", function () {
                formContainer.style.display = "none";
                });
                }

                function updateLinkField() {
                const isOnline = modeSelect.value === "Online";

                linkContainer.style.display = isOnline ? "" : "none";
                linkInput.required = isOnline;
                linkInput.disabled = !isOnline;
                requiredMark.style.display = isOnline ? "" : "none";

                if (!isOnline) {
                linkInput.value = "";
                }
                }

                if (modeSelect && linkInput && linkContainer && requiredMark) {
                modeSelect.addEventListener("change", updateLinkField);
                updateLinkField();
                }
                });


                </script>
                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const sendButton = document.getElementById("btnSendToRegional");
                        const card = document.getElementById("regionalHeadCard");
                        const cancelButton = document.getElementById("cancelRegionalHead");
                        const confirmButton = document.getElementById("confirmRegionalHead");
                        const regionalHeadSelect = document.getElementById("regionalHeadId");

                        if (!sendButton || !card) return;

                        sendButton.addEventListener("click", function () {
                            card.style.display = "block";
                            card.scrollIntoView({ behavior: "smooth", block: "center" });
                        });

                        cancelButton?.addEventListener("click", function () {
                            card.style.display = "none";
                        });

                        confirmButton?.addEventListener("click", function () {
                            if (!regionalHeadSelect.value) {
                                alert("Please select a Regional Head.");
                                return;
                            }

                            alert("Regional Head selected. Next, we will connect the Send action.");
                        });
                    });
                </script>
                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const sendButton = document.getElementById("btnSendToRegional");
                        const card = document.getElementById("regionalHeadCard");
                        const cancelButton = document.getElementById("cancelRegionalHead");
                        const remarksInput = document.getElementById("inspectionRemarks");
                        const regionalRemarks = document.getElementById("regionalInspectionRemarks");

                        if (sendButton && card) {
                            sendButton.addEventListener("click", function () {
                                if (!remarksInput || !remarksInput.value.trim()) {
                                    alert("Please enter inspection remarks.");
                                    remarksInput?.focus();
                                    return;
                                }

                                regionalRemarks.value = remarksInput.value.trim();
                                card.style.display = "block";
                                card.scrollIntoView({ behavior: "smooth", block: "center" });
                            });
                        }

                        if (cancelButton && card) {
                            cancelButton.addEventListener("click", function () {
                                card.style.display = "none";
                            });
                        }
                    });
                </script>
        </div>
        </div>
    </div>
</div>
