@model IEnumerable<TSSC.Unified.ViewModel.TrainingCenterViewModel>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Regional Head Training Center Inspection";

    int serial = 1;
    string activeTab = ViewBag.ActiveTab?.ToString() ?? "Pending";
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Training Center Inspection List
            </h3>
            <div class="nk-block-des text-soft">
                <p>View and manage your assigned training center inspections.</p>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="example-alert w-100 mb-3">
        <div class="alert alert-success alert-icon">
            <em class="icon ni ni-check-circle"></em>
            <strong>@TempData["Success"]</strong>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="example-alert w-100 mb-3">
        <div class="alert alert-danger alert-icon">
            <em class="icon ni ni-cross-circle"></em>
            <strong>@TempData["Error"]</strong>
        </div>
    </div>
}

<div class="card card-bordered">
    <div class="card-inner">

        <div class="nk-block-head-content mb-3">
            <h5 class="title">Training Center Details</h5>
        </div>

        <div class="table-responsive">
            <table class="datatable-init-export table table-tranx table_custom table-bordered">

                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Training Center Name</th>
                        <th>Center Code</th>
                        <th>Scheme</th>
                        <th>Job Role</th>
                        <th>Address</th>
                        <th>Payment Status</th>
                        <th>Inspection Date</th>
                        <th>Inspection Status</th>
                        <th>Regional Head Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@serial</td>

                                <td>
                                    <strong>@item.TrainingCenterName</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.TrainingCenterCode)
                                                                ? "-"
                                                                : item.TrainingCenterCode)
                                                                                      </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.SchemeName)
                                                                ? "-"
                                                                : item.SchemeName)
                                                                              </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.JobRoleTitle)
                                                                ? "-"
                                                                : item.JobRoleTitle)
                                                                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.CompleteAddress)
                                                                ? "-"
                                                                : item.CompleteAddress)
                        </td>

                                <td>
                            @if (item.PaymentStatus == "Success")
                                    {
                                        <span class="badge badge-dim bg-success">
                                            @item.PaymentStatus
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dim bg-warning">
                                            @(item.PaymentStatus ?? "Pending")
                                        </span>
                                    }
                        </td>

                        <td>
                            @(item.InspectionDate?.ToString("dd-MM-yyyy hh:mm tt")
                                                        ?? "Not Scheduled")
                        </td>

                                <td>
                            @if (item.InspectionStatus == "Scheduled")
                                    {
                                        <span class="badge badge-dim bg-info">
                                            Scheduled
                                        </span>
                                    }
                                    else if (item.InspectionStatus == "Rejected")
                                    {
                                        <span class="badge badge-dim bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else if (item.InspectionStatus == "On Hold"
                                    || item.InspectionStatus == "OnHold")
                                    {
                                        <span class="badge badge-dim bg-warning">
                                            On Hold
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dim bg-secondary">
                                            @(item.InspectionStatus ?? "Pending")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.RegionalHeadStatus == "Approved")
                                    {
                                        <span class="badge badge-dim bg-success">Approved</span>
                                    }
                                    else if (item.RegionalHeadStatus == "Rejected")
                                    {
                                        <span class="badge badge-dim bg-danger">Rejected</span>
                                    }
                                    else if (item.RegionalHeadStatus == "On Hold")
                                    {
                                        <span class="badge badge-dim bg-warning">On Hold</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dim bg-warning">
                                            @(item.RegionalHeadStatus ?? "Pending")
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-area="HRMS"
                                       asp-controller="TrainingCenter"
                                       asp-action="RegionalHeadDetails"
                                       asp-route-id="@item.Id"
                                       asp-route-tab="@ViewBag.ActiveTab"
                                       class="btn btn-sm btn-outline-primary"
                                       title="View Training Center Information">

                                        <em class="icon ni ni-eye"></em>
                                    </a>
                                </td>
                            </tr>

                            serial++;
                        }
                    }
                    
                </tbody>

            </table>
        </div>

    </div>
</div>
