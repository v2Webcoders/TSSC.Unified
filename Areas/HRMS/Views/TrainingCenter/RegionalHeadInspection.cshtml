@model IEnumerable<TSSC.Unified.ViewModel.TrainingCenterViewModel>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Regional Head Training Center Inspection";

    int serial = 1;
    string activeTab = ViewBag.ActiveTab?.ToString() ?? "Pending";
}
<style>
    .approval-progress {
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        min-width: 190px;
        padding: 0 5px;
    }

    /* Line passes exactly through the center of circles */
    .approval-line {
        position: absolute;
        top: 14px;
        left: 18px;
        right: 18px;
        height: 2px;
        background: #d9dee7;
        z-index: 0;
    }

    .approval-step {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: transparent;
    }

    .approval-circle {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        background: #fff;
        border: 2px solid #d9dee7;
    }

        .approval-circle.approved {
            background: #e7f7ee;
            border-color: #28a745;
            color: #28a745;
        }

        .approval-circle.rejected {
            background: #fdeaea;
            border-color: #dc3545;
            color: #dc3545;
        }

        .approval-circle.pending {
            background: #fff8e1;
            border-color: #f0ad00;
            color: #f0ad00;
        }

    .approval-step small {
        margin-top: 5px;
        font-size: 10px;
        font-weight: 600;
        color: #8091a5;
    }
</style>
<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Training Center Inspection List
            </h3>
            <div class="nk-block-des text-soft">
                <p>View and manage your assigned training center inspections.</p>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="example-alert w-100 mb-3">
        <div class="alert alert-success alert-icon">
            <em class="icon ni ni-check-circle"></em>
            <strong>@TempData["Success"]</strong>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="example-alert w-100 mb-3">
        <div class="alert alert-danger alert-icon">
            <em class="icon ni ni-cross-circle"></em>
            <strong>@TempData["Error"]</strong>
        </div>
    </div>
}

<div class="card card-bordered">
    <div class="card-inner">

        <div class="nk-block-head-content mb-3">
            <h5 class="title">Training Center Details</h5>
        </div>

        <div class="table-responsive">
            <table class="datatable-init-export table table-tranx table_custom table-bordered">

                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Progress</th>
                        <th>Training Center Name</th>
                        <th>Center Code</th>
                        <th>Scheme</th>
                        <th>Job Role</th>
                        <th>Address</th>
                        <th>Payment Status</th>
                        <th>Inspection Date</th>
                        <th>Inspection Status</th>
                        <th>Regional Head Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@serial</td>

                                <td>
                                    <div class="approval-progress">
                                        <div class="approval-line"></div>

                                        <!-- 1. Finance -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.FinanceStatus == "Approved" ? "approved" : item.FinanceStatus == "Rejected" ? "rejected" : item.FinanceStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="Finance - @(item.FinanceStatus == "Approved" ? "Approved" : item.FinanceStatus == "Rejected" ? "Rejected" : item.FinanceStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.FinanceStatus == "Approved" ? "✓" : item.FinanceStatus == "Rejected" ? "✕" : item.FinanceStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>Finance</small>
                                        </div>

                                        <!-- 2. Regional Head -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.RegionalHeadStatus == "Approved" ? "approved" : item.RegionalHeadStatus == "Rejected" ? "rejected" : item.RegionalHeadStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="Regional Head - @(item.RegionalHeadStatus == "Approved" ? "Approved" : item.RegionalHeadStatus == "Rejected" ? "Rejected" : item.RegionalHeadStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.RegionalHeadStatus == "Approved" ? "✓" : item.RegionalHeadStatus == "Rejected" ? "✕" : item.RegionalHeadStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>RH</small>
                                        </div>

                                        <!-- 3. Vertical Head -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.VerticalHeadStatus == "Approved" ? "approved" : item.VerticalHeadStatus == "Rejected" ? "rejected" : item.VerticalHeadStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="Vertical Head - @(item.VerticalHeadStatus == "Approved" ? "Approved" : item.VerticalHeadStatus == "Rejected" ? "Rejected" : item.VerticalHeadStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.VerticalHeadStatus == "Approved" ? "✓" : item.VerticalHeadStatus == "Rejected" ? "✕" : item.VerticalHeadStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>VH</small>
                                        </div>

                                        <!-- 4. Business Head -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.BusinessHeadStatus == "Approved" ? "approved" : item.BusinessHeadStatus == "Rejected" ? "rejected" : item.BusinessHeadStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="Business Head - @(item.BusinessHeadStatus == "Approved" ? "Approved" : item.BusinessHeadStatus == "Rejected" ? "Rejected" : item.BusinessHeadStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.BusinessHeadStatus == "Approved" ? "✓" : item.BusinessHeadStatus == "Rejected" ? "✕" : item.BusinessHeadStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>BH</small>
                                        </div>

                                        <!-- 5. CEO -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.CEOStatus == "Approved" ? "approved" : item.CEOStatus == "Rejected" ? "rejected" : item.CEOStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="CEO - @(item.CEOStatus == "Approved" ? "Approved" : item.CEOStatus == "Rejected" ? "Rejected" : item.CEOStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.CEOStatus == "Approved" ? "✓" : item.CEOStatus == "Rejected" ? "✕" : item.CEOStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>CEO</small>
                                        </div>

                                    </div>
                                </td>
                                <td>
                                    <strong>@item.TrainingCenterName</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.TrainingCenterCode)
                                                                ? "-"
                                                                : item.TrainingCenterCode)
                                                                                      </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.SchemeName)
                                                                ? "-"
                                                                : item.SchemeName)
                                                                              </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.JobRoleTitle)
                                                                ? "-"
                                                                : item.JobRoleTitle)
                                                                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.CompleteAddress)
                                                                ? "-"
                                                                : item.CompleteAddress)
                        </td>

                                <td>
                            @if (item.PaymentStatus == "Success")
                                    {
                                        <span class="badge badge-dim bg-success">
                                            @item.PaymentStatus
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dim bg-warning">
                                            @(item.PaymentStatus ?? "Pending")
                                        </span>
                                    }
                        </td>

                        <td>
                            @(item.InspectionDate?.ToString("dd-MM-yyyy hh:mm tt")
                                                        ?? "Not Scheduled")
                        </td>

                                <td>
                            @if (item.InspectionStatus == "Scheduled")
                                    {
                                        <span class="badge badge-dim bg-info">
                                            Scheduled
                                        </span>
                                    }
                                    else if (item.InspectionStatus == "Rejected")
                                    {
                                        <span class="badge badge-dim bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else if (item.InspectionStatus == "On Hold"
                                    || item.InspectionStatus == "OnHold")
                                    {
                                        <span class="badge badge-dim bg-warning">
                                            On Hold
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dim bg-secondary">
                                            @(item.InspectionStatus ?? "Pending")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.RegionalHeadStatus == "Approved")
                                    {
                                        <span class="badge badge-dim bg-success">Approved</span>
                                    }
                                    else if (item.RegionalHeadStatus == "Rejected")
                                    {
                                        <span class="badge badge-dim bg-danger">Rejected</span>
                                    }
                                    else if (item.RegionalHeadStatus == "On Hold")
                                    {
                                        <span class="badge badge-dim bg-warning">On Hold</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dim bg-warning">
                                            @(item.RegionalHeadStatus ?? "Pending")
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-area="HRMS"
                                       asp-controller="TrainingCenter"
                                       asp-action="RegionalHeadDetails"
                                       asp-route-id="@item.Id"
                                       asp-route-tab="@ViewBag.ActiveTab"
                                       class="btn btn-sm btn-outline-primary"
                                       title="View Training Center Information">

                                        <em class="icon ni ni-eye"></em>
                                    </a>
                                </td>
                            </tr>

                            serial++;
                        }
                    }
                    
                </tbody>

            </table>
        </div>

    </div>
</div>
