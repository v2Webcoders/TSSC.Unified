@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using Microsoft.AspNetCore.Identity
@using QUIZAPP
@using TSSC.Unified.Models
@inject AppdbContext Context
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager

@{
	var currentUser = await UserManager.GetUserAsync(User);

	var roles = currentUser != null
		? await UserManager.GetRolesAsync(currentUser)
		: new List<string>();

	var employee = currentUser != null
		? Context.Employee.FirstOrDefault(
			x => x.ApplicationUserId == currentUser.Id)
		: null;

	bool isHR = roles.Contains("HR");

	bool isReportingManager = employee != null &&
		Context.Employee.Any(
			x => x.ReportingManagerId == employee.EmployeeId);
	var isFinanceEmployee = currentUser != null
	&& employee != null
	&& employee.DepartmentId == 25 && employee.DesignationId != 50;

	//for employeeletter received
	var applicationUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

	var employeeIdd = Context.Employee
		.Where(x => x.ApplicationUserId.ToString() == applicationUserId && x.IsActive)
		.Select(x => x.EmployeeId)
		.FirstOrDefault();

	var hasHandoverLetter = employeeIdd > 0 &&
		Context.LetterRegister.Any(x =>
			x.Handover == employeeIdd &&
			x.IsActive);

	var isFinanceHead = currentUser != null
		&& employee != null
		&& employee.DesignationId == 50;
	//for reimbursement system
	// =====================================
	// REIMBURSEMENT SIDE MENU
	// =====================================
	var isCEO = currentUser != null
		&& employee != null
		&& employee.DepartmentId == 22;
	bool showReimbursementApproverMenu = false;

	if (employee != null)
	{
		var employeeId = employee.EmployeeId;

		// =====================================
		// APPROVER 2
		// Directly menu show
		// =====================================

		var isApprover2 = Context.Reimbursements.Any(x =>
			x.IsActive &&
			x.Approver2Id == employeeId
		);


		// =====================================
		// APPROVER 3
		// Menu तभी show होगा जब Approver2 Approved हो
		// =====================================

		var isApprover3 = Context.Reimbursements.Any(x =>
			x.IsActive &&
			x.Approver3Id == employeeId &&
			x.Approver2Status == "Approved"
		);


		// =====================================
		// APPROVER 4
		// Menu तभी show होगा जब Approver2 और
		// Approver3 दोनों Approved हों
		// =====================================

		var isApprover4 = Context.Reimbursements.Any(x =>
			x.IsActive &&
			x.Approver4Id == employeeId &&
			x.Approver2Status == "Approved" &&
			x.Approver3Status == "Approved"
		);
		// =====================================
		// APPROVER 5
		// Menu तभी show होगा जब Approver2,3,4 Approved हों
		// =====================================

		var isApprover5 = Context.Reimbursements.Any(x =>
			x.IsActive &&
			x.Approver5Id == employeeId &&
			x.Approver2Status == "Approved" &&
			x.Approver3Status == "Approved" &&
			x.Approver4Status == "Approved"
		);
		// =====================================
		// APPROVER 6
		// Menu तभी show होगा जब Approver2,3,4,5  Approved हों
		// =====================================

		var isApprover6 = Context.Reimbursements.Any(x =>
			x.IsActive &&
			x.Approver6Id == employeeId &&
			x.Approver2Status == "Approved" &&
			x.Approver3Status == "Approved" &&
			x.Approver4Status == "Approved" &&
			x.Approver5Status == "Approved"
		);

		//=====================================
		// CEO APPROVER
		// Menu तभी show होगा जब Approver2,
		// Approver3 ,  Approver4 ,5,6 Approved हों
		// =====================================

		var isCeoApprover = Context.Reimbursements.Any(x =>
			x.IsActive &&
			x.Approver6Id == employeeId &&
			x.Approver2Status == "Approved" &&
			x.Approver3Status == "Approved" &&
			x.Approver4Status == "Approved" &&
			x.Approver5Status == "Approved" &&
				x.Approver6Status == "Approved"
		);
		// किसी भी condition के true होने पर
		// तीनों menu show होंगे

		showReimbursementApproverMenu =
			isApprover2 ||
			isApprover3 ||
			isApprover4 ||
			isApprover5 ||
			isApprover6 ||
			isCEO ||
		isCeoApprover;
	}
}

