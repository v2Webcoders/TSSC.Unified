		@* Reimbursements — Management (actual expense claims, 5-stage chain) *@
		var reimbursementStages = new List<(bool Show, string Action, string ApprovedStatus, string RejectedStatus)>
	{
	(isReportingManager, "ManagerReimbursement", "Manager Approved", "Rejected"),
	(isFinanceEmployee, "FinanceReimbursement", "Finance Approved", "Finance Rejected"),
	(isHR, "HRReimbursement", "HR Approved", "HR Rejected"),
	(isFinanceHead, "FinanceHeadReimbursement", "Finance Head Approved", "Finance Head Rejected"),
	(isCEO, "CEOReimbursement", "CEO Approved", "CEO Rejected"),
	};
		var activeStage = reimbursementStages.FirstOrDefault(s => s.Show);

		@if (activeStage.Action != null)
		{
			<li class="nk-menu-item has-sub">
				<a href="#" class="nk-menu-link nk-menu-toggle">
					<span class="nk-menu-icon"><em class="icon ni ni-check-circle-cut"></em></span>
					<span class="nk-menu-text">Reimbursements</span>
				</a>
				<ul class="nk-menu-sub">
					<li class="nk-menu-item">
						<a asp-area="HRMS" asp-controller="Reimbursement" asp-action="@activeStage.Action" asp-route-status="Pending" class="nk-menu-link">
							<span class="nk-menu-text">Reimbursement Request</span>
						</a>
					</li>
					<li class="nk-menu-item">
						<a asp-area="HRMS" asp-controller="Reimbursement" asp-action="@activeStage.Action" asp-route-status="@activeStage.ApprovedStatus" class="nk-menu-link">
							<span class="nk-menu-text">Approved Reimbursement</span>
						</a>
					</li>
					<li class="nk-menu-item">
						<a asp-area="HRMS" asp-controller="Reimbursement" asp-action="@activeStage.Action" asp-route-status="@activeStage.RejectedStatus" class="nk-menu-link">
							<span class="nk-menu-text">Reject Reimbursement</span>
						</a>
					</li>
				</ul>
			</li>
		}
