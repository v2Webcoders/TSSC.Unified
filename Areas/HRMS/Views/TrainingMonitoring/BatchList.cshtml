@using TSSC.Unified.ViewModel
@model IEnumerable<BatchIndexVM>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "_layout";
	ViewData["Title"] = "Training Batches";
}

<div class="nk-content">
	<div class="container-fluid">
		<div class="nk-content-inner">
			<div class="nk-content-body">

				<div class="nk-block-head nk-block-head-sm">
					<div class="nk-block-between">
						<div class="nk-block-head-content">
							<h3 class="nk-block-title page-title">
								Training Batches
							</h3>
							<div class="nk-block-des text-soft">
								<p>View training batches and schedule screening.</p>
							</div>
						</div>
					</div>
				</div>
				@if (TempData["Success"] != null)
				{
					<div class="alert alert-success alert-icon">
						<em class="icon ni ni-check-circle"></em>
						@TempData["Success"]
					</div>
				}
				@if (TempData["SuccessMessage"] != null)
				{
					<div class="alert alert-success alert-icon">
						<em class="icon ni ni-check-circle"></em>
						@TempData["SuccessMessage"]
					</div>
				}

				@if (TempData["WarningMessage"] != null)
				{
					<div class="alert alert-warning alert-icon">
						<em class="icon ni ni-alert-circle"></em>
						@TempData["WarningMessage"]
					</div>
				}

				<div class="nk-block">
					<div class="card card-bordered card-stretch">
						<div class="card-inner-group">
							<div class="card-inner">
								<div class="table-responsive">
									<table class="datatable-init-export table table-tranx table_custom table-bordered"
										   data-auto-responsive="false">
										<thead class="tb-tnx-head">
											<tr class="tb-tnx-item">
												<th>#</th>
												<th>Batch ID</th>
												<th>Scheme</th>
												<th>Project</th>
												<th>Training Center</th>
												<th>Job Role</th>
												<th>Trainer</th>
												<th>Candidates</th>
												<th>Start Date</th>
												<th>End Date</th>
												<th>Status</th>
												<th>Created On</th>
												<th>Screening</th>
												<th style="min-width:150px;">Monitoring Report</th>
												<th>Action</th>
											</tr>
										</thead>
										<tbody>
											@if (Model != null && Model.Any())
											{
												var index = 1;

												foreach (var batch in Model)
												{
													<tr>
														<td>@index</td>
														<td>
															<strong>@batch.BatchId</strong>
														</td>
														<td style="min-width:150px;">@batch.SchemeName</td>
														<td>@batch.ProjectName</td>
														<td>@batch.CenterName</td>
														<td>@batch.JobRoleName</td>
														<td>@batch.TrainerName</td>
														<td>@batch.CandidateCount</td>
														<td>@batch.StartDate.ToString("dd-MMM-yyyy")</td>
														<td>@batch.EndDate.ToString("dd-MMM-yyyy")</td>
														<td>
															<span class="badge badge-dim bg-info">
																@batch.Status
															</span>
														</td>
														<td>@batch.CreatedOn.ToString("dd-MMM-yyyy")</td>


														<td style="width:180px; min-width:180px; vertical-align:top;">
															<div class="d-flex flex-column align-items-start" style="gap:4px;">

																@if (!string.Equals(
																											batch.MonitoringStatus?.Trim(),
																											"Completed",
																											StringComparison.OrdinalIgnoreCase))
																{
																	<a asp-area="HRMS"
																	   asp-controller="TrainingMonitoring"
																	   asp-action="ScheduleScreening"
																	   asp-route-batchId="@batch.Id"
																	   class="btn btn-sm @(string.Equals(
                   batch.MonitoringStatus?.Trim(),
                   "Scheduled",
                   StringComparison.OrdinalIgnoreCase)
                   ? "btn-warning" : "btn-primary")"
																	   style="padding:4px 7px; white-space:normal; line-height:1.3;">

																		<em class="icon ni @(string.Equals(
                    batch.MonitoringStatus?.Trim(),
                    "Scheduled",
                    StringComparison.OrdinalIgnoreCase)
                    ? "ni-edit" : "ni-calendar-check")"></em>

																		@(string.Equals(
																															batch.MonitoringStatus?.Trim(),
																															"Scheduled",
																															StringComparison.OrdinalIgnoreCase)
																															? "Edit Screening" : "Schedule Screening")
																	</a>
																}

																@if (batch.MonitoringDateTime.HasValue)
																{
																	<div style="background:#f1f5f9; border:1px solid #d8dee8;
                        border-radius:4px; padding:4px 6px; width:100%;
                        font-size:11px; line-height:1.4; color:#1B2A4A;">

																		<div>
																			<em class="icon ni ni-calendar"></em>
																			<strong>
																				@batch.MonitoringDateTime.Value.ToString("dd MMM yyyy")
																			</strong>
																		</div>

																		<div>
																			<em class="icon ni ni-clock"></em>
																			@batch.MonitoringDateTime.Value.ToString("hh:mm tt")
																		</div>
																	</div>
																}
																
															</div>
														</td>

														<td style="width:160px; min-width:160px; vertical-align:top;">
															<div class="d-flex flex-column align-items-start" style="gap:6px;">

																@if (batch.MonitoringId.HasValue &&
																											string.Equals(
																											batch.MonitoringStatus?.Trim(),
																											"Scheduled",
																											StringComparison.OrdinalIgnoreCase))
																{
																	<a asp-area="HRMS"
																	   asp-controller="TrainingMonitoring"
																	   asp-action="SubmitReport"
																	   asp-route-monitoringId="@batch.MonitoringId.Value"
																	   class="btn btn-sm btn-success"
																	   style="padding:4px 7px; white-space:normal;">

																		<em class="icon ni ni-clipboard-check"></em>
																		Submit Report
																	</a>
																}
																else if (string.Equals(
																batch.MonitoringStatus?.Trim(),
																"Completed",
																StringComparison.OrdinalIgnoreCase))
																{
																	<span class="badge bg-success">
																		<em class="icon ni ni-check-circle"></em>
																		Report Submitted
																	</span>

																	@if (batch.MonitoringId.HasValue)
																	{
																		<a asp-area="HRMS"
																		   asp-controller="TrainingMonitoring"
																		   asp-action="ViewReport"
																		   asp-route-monitoringId="@batch.MonitoringId.Value"
																		   class="btn btn-sm btn-outline-primary"
																		   style="padding:4px 7px;">

																			<em class="icon ni ni-eye"></em>
																			View Report
																		</a>
																	}
																}
																else
																{
																	<span class="text-muted" style="font-size:12px;">
																		Not submitted
																	</span>
																}
															</div>
														</td>

														<td>
															<div class="d-flex flex-column align-items-start" style="gap:5px;">

																<a asp-area="HRMS"
																   asp-controller="TrainingMonitoring"
																   asp-action="Details"
																   asp-route-id="@batch.Id"
																   class="btn btn-sm btn-outline-primary">
																	<em class="icon ni ni-eye"></em> View
																</a>





																@if (string.Equals(
																											batch.Status?.Trim(),
																											"Pending",
																											StringComparison.OrdinalIgnoreCase))
																{
																	<div class="d-flex flex-column" style="gap:5px;">

																		<form asp-area="HRMS"
																			  asp-controller="TrainingMonitoring"
																			  asp-action="ApproveBatch"
																			  method="post">
																			@Html.AntiForgeryToken()

																			<input type="hidden"
																				   name="batchId"
																				   value="@batch.Id" />

																			<button type="submit"
																					class="btn btn-sm btn-success"
																					onclick="return confirm('Are you sure you want to approve this batch?');">
																				<em class="icon ni ni-check"></em> Approve
																			</button>
																		</form>

																		<button type="button"
																				class="btn btn-sm btn-danger"
																				data-bs-toggle="modal"
																				data-bs-target="#rejectBatchModal"
																				data-batch-id="@batch.Id"
																				data-batch-number="@batch.BatchId">
																			<em class="icon ni ni-cross"></em> Reject
																		</button>
																	</div>
																}
																else
																{
																	<span class="badge @(string.Equals(
            batch.Status?.Trim(),
            "Approved",
            StringComparison.OrdinalIgnoreCase)
            ? "bg-success"
            : string.Equals(batch.Status?.Trim(), "Rejected",
                StringComparison.OrdinalIgnoreCase)
                ? "bg-danger"
                : "bg-secondary")">
																		@batch.Status
																	</span>
																}
															</div>
														</td>


													</tr>

													index++;
												}
											}
											else
											{
												<tr>
													<td colspan="13" class="text-center">
														No training batches found.
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="rejectBatchModal" tabindex="-1"
	 aria-labelledby="rejectBatchModalLabel" aria-hidden="true">

	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">

			<form asp-area="HRMS"
				  asp-controller="TrainingMonitoring"
				  asp-action="RejectBatch"
				  method="post">

				@Html.AntiForgeryToken()

				<div class="modal-header">
					<h5 class="modal-title" id="rejectBatchModalLabel">
						Reject Batch
					</h5>

					<button type="button" class="btn-close"
							data-bs-dismiss="modal"
							aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<input type="hidden" id="rejectBatchId" name="batchId" />

					<p class="mb-2">
						Batch: <strong id="rejectBatchNumber"></strong>
					</p>

					<label for="approvalRemarks" class="form-label">
						Rejection Remarks <span class="text-danger">*</span>
					</label>

					<textarea id="approvalRemarks"
							  name="remarks"
							  class="form-control"
							  rows="4"
							  maxlength="1000"
							  required
							  placeholder="Enter the reason for rejecting this batch..."></textarea>
				</div>

				<div class="modal-footer">
					<button type="button" class="btn btn-outline-light"
							data-bs-dismiss="modal">
						Cancel
					</button>

					<button type="submit" class="btn btn-danger">
						Confirm Rejection
					</button>
				</div>

			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const rejectModal = document.getElementById("rejectBatchModal");

			if (!rejectModal) return;

			rejectModal.addEventListener("show.bs.modal", function (event) {
				const button = event.relatedTarget;

				if (!button) return;

				document.getElementById("rejectBatchId").value =
					button.getAttribute("data-batch-id") || "";

				document.getElementById("rejectBatchNumber").textContent =
					button.getAttribute("data-batch-number") || "";

				document.getElementById("approvalRemarks").value = "";
			});
		});
	</script>
}