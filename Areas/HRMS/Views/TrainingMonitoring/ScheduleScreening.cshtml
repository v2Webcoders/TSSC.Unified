@using TSSC.Unified.ViewModel
@model BatchMonitoringVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Schedule Screening";
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">

                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">
                                Schedule Screening
                            </h3>
                            <p class="text-soft">
                                Schedule monitoring for this training batch.
                            </p>
                        </div>

                        <div class="nk-block-head-content">
                            <a asp-area="HRMS"
                               asp-controller="TrainingMonitoring"
                               asp-action="BatchList"
                               class="btn btn-outline-light">
                                <em class="icon ni ni-arrow-left"></em>
                                Back to Training Batches
                            </a>
                        </div>
                    </div>
                </div>

                <div class="nk-block">
                    <div class="card card-bordered">
                        <div class="card-inner">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"></div>

                            <div class="form-group mb-4">
                                <label class="form-label">Batch ID</label>
                                <div class="form-control bg-light">
                                    @Model.BatchNumber
                                </div>
                            </div>

                            <form asp-area="HRMS"
                                  asp-controller="TrainingMonitoring"
                                  asp-action="ScheduleScreening"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input asp-for="BatchId" type="hidden" />

                                <div class="form-group">
                                    <label asp-for="MonitoringDateTime"
                                           class="form-label"></label>

                                    <input asp-for="MonitoringDateTime"
                                           type="datetime-local"
                                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                                           class="form-control" />

                                    <span asp-validation-for="MonitoringDateTime"
                                          class="text-danger"></span>
                                </div>

                                <div class="mt-4 d-flex justify-content-end gap-2">
                                    <a asp-area="HRMS"
                                       asp-controller="TrainingMonitoring"
                                       asp-action="BatchList"
                                       class="btn btn-outline-light">
                                        Cancel
                                    </a>

                                    <button type="submit" class="btn btn-success">
                                        <em class="icon ni ni-calendar-check"></em>
                                        Schedule Screening
                                    </button>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

