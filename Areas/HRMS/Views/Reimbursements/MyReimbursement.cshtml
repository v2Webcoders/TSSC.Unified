@model List<TSSC.Unified.ViewModel.ReimbursementsVM>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
    @if (TempData["msg"] != null)
    {
        <div class="example-alert w-100">
            <div class="alert alert-success alert-icon">
                <em class="icon ni ni-check-circle"></em>
                <strong>@TempData["msg"]</strong>
            </div>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="example-alert w-100">
            <div class="alert alert-danger alert-icon">
                <em class="icon ni ni-cross-circle"></em>
                <strong>@TempData["error"]</strong>
            </div>
        </div>
    }
}

<!-- Page Header -->
<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                My Approval List
            </h3>
        </div>

        <div class="nk-block-head-content">
            <a asp-action="CreateReimbursement"
               asp-controller="Reimbursements"
               asp-area="HRMS"
               class="btn btn-primary">

                <em class="icon ni ni-plus"></em>
                Apply for Approval

            </a>
        </div>

    </div>
</div>


<!-- Reimbursement List -->
<div class="nk-block nk-block-lg">

    <div class="card card-preview">

        <div class="card-inner">

            <div class="table-responsive">

                <table class="datatable-init-export table table-tranx table_custom table-bordered">

                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Request Type</th>
                            <th>Expense Category</th>
                            <th>Amount</th>
                            <th>Expense Date</th>
                            <th>Vendor</th>
                            <th>Payment Mode</th>
                            <th>Supporting Document</th>
                            <th>Invoice / Bill</th>
                            <th>Status</th>
                            <th>Approvers</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- S.No -->
                                <td>
                                    @serial
                                </td>

                                <!-- Request Type -->
                                <td>
                                    @item.RequestType
                                </td>

                                <!-- Expense Category -->
                                <td>
                                    @item.ExpenseCategory
                                </td>

                                <!-- Amount -->
                                <td>
                                    ₹ @item.ExpenseAmount.ToString("N2")
                                </td>

                                <!-- Expense Date -->
                                <td>
                                    @item.ExpenseDate.ToString("dd-MMM-yyyy")
                                </td>

                                <!-- Vendor -->
                                <td>
                                    @(string.IsNullOrEmpty(item.VendorName)
                                                                    ? "-"
                                                                    : item.VendorName)
                            </td>

                                <!-- Payment Mode -->
                                <td>
                                    @item.PaymentMode
                                </td>

                                <!-- Supporting Document -->
                                <td>
                                @if (!string.IsNullOrEmpty(item.SupportingDocument))
                                    {
                                        <a href="@Url.Content(item.SupportingDocument)"
                                           target="_blank"
                                           class="btn btn-sm btn-info">

                                            <em class="icon ni ni-file"></em>
                                            View File

                                        </a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <!-- Invoice / Bill -->
                                <td>
                                    @if (!string.IsNullOrEmpty(item.InvoiceBill))
                                    {
                                        <a href="@Url.Content(item.InvoiceBill)"
                                           target="_blank"
                                           class="btn btn-sm btn-info">

                                            <em class="icon ni ni-file"></em>
                                            View Bill

                                        </a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <!-- Status -->
                                <td>

                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            @item.Status
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            @item.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <!-- Approvers -->
                                <td>

                                    @if (!string.IsNullOrEmpty(item.Approver1Name))
                                    {
                                        <div class="mb-1">
                                            <strong>1.</strong>
                                            @item.Approver1Name

                                            <br />

                                            @if (item.Approver1Status == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.Approver1Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    @item.Approver1Status
                                                </span>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(item.Approver2Name))
                                    {
                                        <div class="mb-1">
                                            <strong>2.</strong>
                                            @item.Approver2Name

                                            <br />

                                            @if (item.Approver2Status == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.Approver2Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    @item.Approver2Status
                                                </span>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(item.Approver3Name))
                                    {
                                        <div class="mb-1">
                                            <strong>3.</strong>
                                            @item.Approver3Name

                                            <br />

                                            @if (item.Approver3Status == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.Approver3Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    @item.Approver3Status
                                                </span>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(item.Approver4Name))
                                    {
                                        <div class="mb-1">
                                            <strong>4.</strong>
                                            @item.Approver4Name

                                            <br />

                                            @if (item.Approver4Status == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.Approver4Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    @item.Approver4Status
                                                </span>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Approver5Name))
                                    {
                                        <div class="mb-1">
                                            <strong>5.</strong>
                                            @item.Approver5Name

                                            <br />

                                            @if (item.Approver5Status == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.Approver5Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    @item.Approver5Status
                                                </span>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Approver6Name))
                                    {
                                        <div class="mb-1">
                                            <strong>6.</strong>
                                            @item.Approver6Name

                                            <br />

                                            @if (item.Approver6Status == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.Approver6Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    @item.Approver6Status
                                                </span>
                                            }
                                        </div>
                                    }
                                    @if (string.IsNullOrEmpty(item.Approver1Name)
                                                                    && string.IsNullOrEmpty(item.Approver2Name)
                                                                    && string.IsNullOrEmpty(item.Approver3Name)
                                                                    && string.IsNullOrEmpty(item.Approver4Name)
                                                                    && string.IsNullOrEmpty(item.Approver5Name)
                                                                    && string.IsNullOrEmpty(item.Approver6Name))
                                    {
                                        <span>-</span>
                                    }

                                </td>

                                <!-- Action -->
                                <td>
                                    <div class="btn-group">

                                        <!-- Edit -->
                                        @if (item.Approver1Status =="Pending" && item.Approver2Status=="Pending"
                                        && item.Approver3Status =="Pending" && item.Approver4Status=="Pending"
                                        && item.Approver5Status =="Pending" && item.Approver6Status=="Pending")
                                        {
                                            <a asp-action="CreateReimbursement"
                                            asp-controller="Reimbursements"
                                            asp-area="HRMS"
                                            asp-route-id="@item.ReimbursementId"
                                            class="btn btn-sm btn-outline-warning"
                                            title="Edit">

                                                <em class="icon ni ni-edit"></em>

                                            </a>
                                        }
                                        <!-- Delete -->
                                                 @if (item.Approver1Status == "Pending" && item.Approver2Status == "Pending"
                                                 && item.Approver3Status == "Pending" && item.Approver4Status == "Pending"
                                                 && item.Approver5Status == "Pending" && item.Approver6Status == "Pending")
                                        {
                                            <form asp-action="DeleteReimbursement"
                                            asp-controller="Reimbursements"
                                              asp-area="HRMS"
                                              asp-route-id="@item.ReimbursementId"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Are you sure you want to delete this reimbursement?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">

                                                <em class="icon ni ni-trash"></em>

                                            </button>

                                        </form>}

                                    </div>
                                </td>

                            </tr>

                            serial++;
                        }

                    </tbody>

                </table>

                @if (Model == null || !Model.Any())
                {
                    <div class="text-center py-4">
                        <em class="icon ni ni-info fs-2x"></em>

                        <p class="mt-2 mb-0">
                            No approval found.
                        </p>
                    </div>
                }

            </div>

        </div>

    </div>

</div>