@using TSSC.Unified.ViewModel

@model LeaveAdjustmentVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	Layout = "_Layout";
}

<div class="nk-block-head">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Adjust / Credit Leaves
            </h3>
        </div>

        <div class="nk-block-head-content">
            <a asp-action="Index"
               class="btn btn-primary">
                <em class="icon ni ni-list"></em>
                <span> Adjustment History</span>
            </a>
        </div>

    </div>
</div>

<div class="card card-bordered">

    <div class="card-inner">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row g-4">

                <!-- Employee -->
                <div class="col-md-6">

                    <label class="form-label">
                        Employee
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="EmployeeId"
                            id="EmployeeId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Employees, "EmployeeId", "EmployeeDisplayName"))">

                        <option value="">Select Employee</option>

                    </select>

                    <span asp-validation-for="EmployeeId"
                          class="text-danger"></span>

                </div>


                <!-- Leave Type -->
                <div class="col-md-6">

                    <label class="form-label">
                        Leave Type
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="LeaveTypeId"
                            id="LeaveTypeId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.LeaveTypes, "LeaveTypeId", "LeaveTypeName"))">

                        <option value="">Select Leave Type</option>

                    </select>

                    <span asp-validation-for="LeaveTypeId"
                          class="text-danger"></span>

                </div>


                <!-- Current Balance -->
                <div class="col-md-6">

                    <label class="form-label">
                        Current Balance
                    </label>

                    <input asp-for="CurrentBalance"
                           id="CurrentBalance"
                           class="form-control"
                           readonly
                           value="0" />

                    <small class="text-muted">
                        Current available balance for the selected leave type.
                    </small>

                </div>


                <!-- Adjustment Type -->
                <div class="col-md-6">

                    <label class="form-label">
                        Adjustment Type
                        <span class="text-danger">*</span>
                    </label>

                    <div class="mt-2">

                        <div class="custom-control custom-radio">

                            <input asp-for="AdjustmentType"
                                   type="radio"
                                   value="Credit"
                                   id="Credit"
                                   class="custom-control-input" />

                            <label class="custom-control-label"
                                   for="Credit">
                                Credit Leave
                            </label>

                        </div>

                        <div class="custom-control custom-radio mt-2">

                            <input asp-for="AdjustmentType"
                                   type="radio"
                                   value="Deduct"
                                   id="Deduct"
                                   class="custom-control-input" />

                            <label class="custom-control-label"
                                   for="Deduct">
                                Deduct Leave
                            </label>

                        </div>

                    </div>

                    <span asp-validation-for="AdjustmentType"
                          class="text-danger"></span>

                </div>


                <!-- Days -->
                <div class="col-md-6">

                    <label class="form-label">
                        No. of Days
                        <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Days"
                           class="form-control"
                           type="number"
                           min="0.5"
                           step="0.5"
                           placeholder="Enter number of days" />

                    <span asp-validation-for="Days"
                          class="text-danger"></span>

                </div>


                <!-- Reason -->
                <div class="col-md-12">

                    <label class="form-label">
                        Reason
                        <span class="text-danger">*</span>
                    </label>

                    <textarea asp-for="Reason"
                              rows="4"
                              class="form-control"
                              placeholder="Enter reason for leave adjustment"></textarea>

                    <span asp-validation-for="Reason"
                          class="text-danger"></span>

                </div>

            </div>

            <hr />

            <div class="text-end">

                <button type="submit"
                        class="btn btn-primary">

                    <em class="icon ni ni-save"></em>
                    Save Adjustment

                </button>

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <script>
        $(document).ready(function () {

            $('#EmployeeId, #LeaveTypeId').change(function () {

                var employeeId = $('#EmployeeId').val();
                var leaveTypeId = $('#LeaveTypeId').val();

                if (!employeeId || !leaveTypeId) {
                    $('#CurrentBalance').val('0');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetCurrentBalance", "LeaveAdjustment")',
                    type: 'GET',
                    data: {
                        employeeId: employeeId,
                        leaveTypeId: leaveTypeId
                    },
                    success: function (response) {

                        if (response.success) {
                            $('#CurrentBalance').val(response.currentBalance);
                        }
                        else {
                            $('#CurrentBalance').val('0');
                        }
                    },
                    error: function () {
                        $('#CurrentBalance').val('0');
                    }
                });

            });

        });
    </script>
}