@model IEnumerable<TSSC.Unified.ViewModel.TrainerRegistrationViewModel>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Finance Payment Approval
            </h3>
        </div>

    </div>
</div>

<div class="card card-bordered">
    <div class="card-inner">

        <table class="datatable-init-export table table-tranx table_custom table-bordered dataTable no-footer dtr-inline collapsed">

            <thead>
                <tr>
                    <th>S.No.</th>
                    <th>Name</th>
                    <th>Job Role</th>
                    <th>Paid On</th>
                    <th>Payment Method</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @serial
                            </td>

                            <td>
                                @item.CandidateName
                            </td>

                            <td>
                                @item.JobRoleName
                            </td>

                            <td>
                                @(item.PaymentDate?.ToString("dd-MM-yyyy") ?? "-")
                            </td>

                            <td>
                                @* Temporary until PaymentMethod column is added *@
                                UPI
                            </td>

                            <td>
                                @if (ViewBag.ActiveTab == "Pending")
                                {
                                    <form method="post"
                                          action="/HRMS/Trainer/ApprovePayment"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('Are you sure you want to approve this payment?');">

                                            <em class="icon ni ni-check"></em>
                                            Approve

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="badge badge-dim bg-success">
                                        Approved
                                    </span>
                                }
                            </td>

                        </tr>

                        serial++;
                    }
                }

            </tbody>

        </table>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center text-muted py-4">
                No payment is pending for Finance approval.
            </div>
        }

    </div>
</div>