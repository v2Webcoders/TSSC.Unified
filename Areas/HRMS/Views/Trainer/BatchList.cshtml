@model IEnumerable<TSSC.Unified.Models.BatchMaster>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Batch List
            </h3>
        </div>

        <div class="nk-block-head-content">
            <div class="toggle-wrap nk-block-tools-toggle">

                <a href="#"
                   class="btn btn-icon btn-trigger toggle-expand me-n1"
                   data-target="pageMenu">
                    <em class="icon ni ni-more-v"></em>
                </a>

                <div class="toggle-expand-content"
                     data-content="pageMenu">

                    <ul class="nk-block-tools g-3">
                        <li class="nk-block-tools-opt">

                            <a asp-area="HRMS"
                               asp-controller="Trainer"
                               asp-action="CreateBatch"
                               class="btn btn-primary">

                                <em class="icon ni ni-plus"></em>

                                <span>
                                    Create Batch
                                </span>

                            </a>

                        </li>
                    </ul>

                </div>
            </div>
        </div>

    </div>
</div>


@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <strong>Success!</strong>
        @TempData["msg"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <strong>Error!</strong>
        @TempData["error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="card card-bordered">
    <div class="card-inner">

        <div class="table-responsive">

            <table class="datatable-init-export table table-tranx table_custom table-bordered">

                <thead>
                    <tr>

                        <th>
                            S.No.
                        </th>

                        <th>
                            Batch Code
                        </th>

                        <th>
                            Batch Name
                        </th>

                        <th>
                            Job Role
                        </th>

                        <th>
                            TP
                        </th>

                        <th>
                            Start Date
                        </th>

                        <th>
                            End Date
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @serial
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.BatchCode))
                                    {
                                        @item.BatchCode
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td>
                                    <strong>
                                        @item.BatchName
                                    </strong>
                                </td>

                                <td>
                                    @(item.JobRole?.JobRoleTitle ?? "-")
                                </td>

                                <td>
                                    @(item.TPId?.ToString() ?? "-")
                                </td>

                                <td>
                                    @(item.StartDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>
                                    @(item.EndDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>

                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge badge-dot bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge badge-dot bg-info">
                                            Completed
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge badge-dot bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dot bg-warning">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="btn-group" role="group">

                                        <!-- VIEW BATCH -->
                                        <a asp-area="HRMS"
                                           asp-controller="Trainer"
                                           asp-action="BatchDetails"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Batch">

                                            <em class="icon ni ni-eye"></em>

                                        </a>


                                        <!-- VIEW TRAINERS -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                title="View Trainers"
                                                onclick="showBatchTrainers(@item.Id)">

                                            <em class="icon ni ni-users"></em>

                                        </button>

                                    </div>

                                </td>

                            </tr>

                            serial++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center py-4 text-soft">

                                No batches found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>


<!-- BATCH TRAINERS MODAL -->
<div class="modal fade"
     id="batchTrainerModal"
     tabindex="-1"
     aria-labelledby="batchTrainerModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="batchTrainerModalLabel">

                    Batch Trainers

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead>
                            <tr>

                                <th>
                                    S.No.
                                </th>

                                <th>
                                    Registration No.
                                </th>

                                <th>
                                    Trainer Name
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Mobile
                                </th>

                            </tr>
                        </thead>

                        <tbody id="batchTrainerTableBody">

                            <tr>

                                <td colspan="5"
                                    class="text-center py-4">

                                    Loading...

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>
</div>


@section Scripts {

    <script>

        function showBatchTrainers(batchId) {

            $('#batchTrainerTableBody').html(`
                <tr>
                    <td colspan="5" class="text-center py-4">
                        Loading trainers...
                    </td>
                </tr>
            `);

            var modalElement =
                document.getElementById('batchTrainerModal');

            var modal =
                new bootstrap.Modal(modalElement);

            modal.show();


            $.ajax({

                url: '/HRMS/Trainer/GetBatchTrainers',

                type: 'GET',

                data: {
                    batchId: batchId
                },

                success: function (data) {

                    if (!data || data.length === 0) {

                        $('#batchTrainerTableBody').html(`
                            <tr>
                                <td colspan="5"
                                    class="text-center py-4">
                                    No trainers assigned to this batch.
                                </td>
                            </tr>
                        `);

                        return;
                    }


                    $('#batchTrainerTableBody').empty();


                    $.each(data, function (index, item) {

                        $('#batchTrainerTableBody').append(`

                            <tr>

                                <td>
                                    ${index + 1}
                                </td>

                                <td>
                                    ${item.registrationNo ?? '-'}
                                </td>

                                <td>
                                    <strong>
                                        ${item.trainerName ?? '-'}
                                    </strong>
                                </td>

                                <td>
                                    ${item.email ?? '-'}
                                </td>

                                <td>
                                    ${item.mobile ?? '-'}
                                </td>

                            </tr>

                        `);

                    });

                },

                error: function (xhr) {

                    console.log("STATUS:", xhr.status);
                    console.log("ERROR:", xhr.responseText);

                    $('#batchTrainerTableBody').html(`
                        <tr>
                            <td colspan="5"
                                class="text-center text-danger py-4">
                                Unable to load trainers.
                            </td>
                        </tr>
                    `);

                }

            });

        }

    </script>
}