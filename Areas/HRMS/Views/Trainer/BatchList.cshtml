@model IEnumerable<TSSC.Unified.Models.BatchMaster>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<!-- ============================================ -->
<!-- PAGE HEADER -->
<!-- ============================================ -->

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between">

        <!-- TITLE -->
        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                Batch List
            </h3>

        </div>


        <!-- CREATE BATCH -->
        <div class="nk-block-head-content">

            <div class="toggle-wrap nk-block-tools-toggle">

                <a href="#"
                   class="btn btn-icon btn-trigger toggle-expand me-n1"
                   data-target="pageMenu">

                    <em class="icon ni ni-more-v"></em>

                </a>


                <div class="toggle-expand-content"
                     data-content="pageMenu">

                    <ul class="nk-block-tools g-3">

                        <li class="nk-block-tools-opt">

                            <a asp-area="HRMS"
                               asp-controller="Trainer"
                               asp-action="CreateBatch"
                               class="btn btn-primary">

                                <em class="icon ni ni-plus"></em>

                                <span>
                                    Create Batch
                                </span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================================ -->
<!-- SUCCESS MESSAGE -->
<!-- ============================================ -->
@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <strong>Success!</strong>
        @TempData["msg"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ============================================ -->
<!-- ERROR MESSAGE -->
<!-- ============================================ -->
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <strong>Error!</strong>
        @TempData["error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ============================================ -->
<!-- BATCH TABLE -->
<!-- ============================================ -->

<div class="card card-bordered">

    <div class="card-inner">

        <div class="table-responsive">

            <table class="datatable-init-export table table-tranx table_custom table-bordered">

                <thead>

                    <tr>

                        <th>
                            S.No.
                        </th>

                        <th>
                            Batch Code
                        </th>

                        <th>
                            Batch Name
                        </th>

                        <th>
                            Job Role
                        </th>

                        <th>
                            TP
                        </th>

                        <th>
                            Start Date
                        </th>

                        <th>
                            End Date
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- S.NO -->
                                <td>
                                    @serial
                                </td>


                                <!-- BATCH CODE -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.BatchCode))
                                    {
                                        @item.BatchCode
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>


                                <!-- BATCH NAME -->
                                <td>

                                    <strong>
                                        @item.BatchName
                                    </strong>

                                </td>


                                <!-- JOB ROLE -->
                                <td>
                                    @item.JobRoleId
                                </td>


                                <!-- TP -->
                                <td>
                                    @(item.TPId?.ToString() ?? "-")
                                </td>


                                <!-- START DATE -->
                                <td>
                                    @(item.StartDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>


                                <!-- END DATE -->
                                <td>
                                    @(item.EndDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge badge-dot bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge badge-dot bg-info">
                                            Completed
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge badge-dot bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dot bg-warning">
                                            @item.Status
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td>

                                    <div class="btn-group"
                                         role="group">

                                        <!-- VIEW BATCH -->
                                        <a asp-area="HRMS"
                                           asp-controller="Trainer"
                                           asp-action="BatchDetails"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Batch">

                                            <em class="icon ni ni-eye"></em>

                                        </a>


                                        
                                        <!-- VIEW TRAINERS -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                title="View Trainers"
                                                onclick="showBatchTrainers(@item.Id)">

                                            <em class="icon ni ni-users"></em>

                                        </button>

                                    </div>

                                </td>

                            </tr>

                            serial++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center py-4 text-soft">

                                No batches found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ============================================ -->
<!-- TRAINER MODAL -->
<!-- ============================================ -->

<div class="modal fade"
     id="batchTrainerModal"
     tabindex="-1"
     aria-labelledby="batchTrainerModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">

                <h5 class="modal-title"
                    id="batchTrainerModalLabel">

                    Batch Trainers

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- BODY -->
            <div class="modal-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead>

                            <tr>

                                <th>
                                    S.No.
                                </th>

                                <th>
                                    Registration No.
                                </th>

                                <th>
                                    Trainer Name
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Mobile
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody id="batchTrainerTableBody">

                            <tr>

                                <td colspan="6"
                                    class="text-center py-4">

                                    Loading...

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- FOOTER -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ============================================ -->
<!-- SCREENING RESULT MODAL -->
<!-- ============================================ -->

<div class="modal fade"
     id="screeningResultModal"
     tabindex="-1"
     aria-labelledby="screeningResultModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-md modal-dialog-centered">

        <div class="modal-content">

            <form asp-area="HRMS"
                  asp-controller="Trainer"
                  asp-action="UpdateScreeningResult"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- HEADER -->
                <div class="modal-header">

                    <h5 class="modal-title"
                        id="screeningResultModalLabel">

                        Update Screening Result

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- BODY -->
                <div class="modal-body">

                    <input type="hidden"
                           id="resultScreeningId"
                           name="id" />


                    <!-- RESULT -->
                    <div class="form-group mb-3">

                        <label class="form-label">
                            Screening Result
                        </label>

                        <select name="status"
                                id="screeningResultStatus"
                                class="form-select"
                                required>

                            <option value="">
                                Select Result
                            </option>

                            <option value="Success">
                                Success
                            </option>

                            <option value="Rejected">
                                Reject
                            </option>

                            <option value="On Hold">
                                On Hold
                            </option>

                        </select>

                    </div>


                    <!-- REMARKS -->
                    <div class="form-group">

                        <label class="form-label">
                            Remarks
                        </label>

                        <textarea name="remarks"
                                  id="screeningResultRemarks"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter screening remarks"
                                  required></textarea>

                    </div>

                </div>


                <!-- FOOTER -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        Save Result

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // =====================================================
        // SHOW BATCH TRAINERS
        // =====================================================

        function showBatchTrainers(batchId)
        {
            // Loading
            $('#batchTrainerTableBody').html(`
                <tr>
                    <td colspan="6"
                        class="text-center py-4">

                        Loading trainers...

                    </td>
                </tr>
            `);


            // Open modal
            var modalElement =
                document.getElementById('batchTrainerModal');

            var modal =
                new bootstrap.Modal(modalElement);

            modal.show();


            // AJAX
            $.ajax({

                url: '/HRMS/Trainer/GetBatchTrainers',

                type: 'GET',

                data: {
                    batchId: batchId
                },

                success: function (data)
                {

                    // No trainers
                    if (!data || data.length === 0)
                    {
                        $('#batchTrainerTableBody').html(`
                            <tr>

                                <td colspan="6"
                                    class="text-center py-4">

                                    No trainers assigned to this batch.

                                </td>

                            </tr>
                        `);

                        return;
                    }


                    $('#batchTrainerTableBody').empty();


                    // ========================================
                    // TRAINERS
                    // ========================================

                    $.each(data, function (index, item)
                    {

                        var actionHtml = '';


                        // ====================================
                        // NO SCREENING
                        // ====================================

                        if (!item.screeningStatus)
                        {

                            actionHtml = `
                                <a href="/HRMS/Trainer/CreateScreening?batchId=${batchId}&trainerId=${item.id}"
                                   class="btn btn-sm btn-outline-success"
                                   title="Schedule Screening">

                                    <em class="icon ni ni-calendar-check"></em>

                                    Schedule

                                </a>
                            `;

                        }


                        // ====================================
                        // SCREENING SCHEDULED
                        // ====================================

                        else if (
                            item.screeningStatus === 'Scheduled'
                        )
                        {

                            if (item.canUpdateResult)
                            {

                                actionHtml = `
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Update Screening Result"
                                            onclick="openScreeningResult(${item.screeningId})">

                                        <em class="icon ni ni-check-circle"></em>

                                        Update Result

                                    </button>
                                `;

                            }
                            else
                            {

                                actionHtml = `
                                    <span class="badge badge-dim bg-warning">

                                        Scheduled

                                    </span>
                                `;
                            }

                        }


                        // ====================================
                        // SUCCESS
                        // ====================================

                        else if (
                            item.screeningStatus === 'Success'
                        )
                        {

                            actionHtml = `
                                <span class="badge badge-dim bg-success">

                                    Success

                                </span>
                            `;

                        }


                        // ====================================
                        // REJECTED
                        // ====================================

                        else if (
                            item.screeningStatus === 'Rejected'
                        )
                        {

                            actionHtml = `
                                <span class="badge badge-dim bg-danger">

                                    Rejected

                                </span>
                            `;

                        }


                        // ====================================
                        // ON HOLD
                        // ====================================

                        else if (
                            item.screeningStatus === 'On Hold'
                        )
                        {

                            actionHtml = `
                                <span class="badge badge-dim bg-warning">

                                    On Hold

                                </span>
                            `;

                        }


                        // ====================================
                        // CANCELLED
                        // ====================================

                        else if (
                            item.screeningStatus === 'Cancelled'
                        )
                        {

                            actionHtml = `
                                <a href="/HRMS/Trainer/CreateScreening?batchId=${batchId}&trainerId=${item.id}"
                                   class="btn btn-sm btn-outline-success"
                                   title="Schedule Screening">

                                    <em class="icon ni ni-calendar-check"></em>

                                    Schedule

                                </a>
                            `;

                        }


                        // ====================================
                        // OTHER STATUS
                        // ====================================

                        else
                        {

                            actionHtml = `
                                <span class="badge badge-dim bg-secondary">

                                    ${item.screeningStatus}

                                </span>
                            `;

                        }


                        // ====================================
                        // APPEND ROW
                        // ====================================

                        $('#batchTrainerTableBody').append(`

                            <tr>

                                <td>
                                    ${index + 1}
                                </td>

                                <td>
                                    ${item.registrationNo ?? '-'}
                                </td>

                                <td>

                                    <strong>
                                        ${item.trainerName ?? '-'}
                                    </strong>

                                </td>

                                <td>
                                    ${item.email ?? '-'}
                                </td>

                                <td>
                                    ${item.mobile ?? '-'}
                                </td>

                                <td>
                                    ${actionHtml}
                                </td>

                            </tr>

                        `);

                    });

                },


                error: function (xhr)
                {

                    console.log(xhr.status);

                    console.log(xhr.responseText);


                    $('#batchTrainerTableBody').html(`
                        <tr>

                            <td colspan="6"
                                class="text-center text-danger py-4">

                                Unable to load trainers.

                            </td>

                        </tr>
                    `);

                }

            });

        }


        // =====================================================
        // OPEN SCREENING RESULT MODAL
        // =====================================================

        function openScreeningResult(screeningId)
        {

            $('#resultScreeningId').val(screeningId);

            $('#screeningResultStatus').val('');

            $('#screeningResultRemarks').val('');


            var modalElement =
                document.getElementById(
                    'screeningResultModal'
                );


            var modal =
                new bootstrap.Modal(modalElement);


            modal.show();

        }

    </script>

}