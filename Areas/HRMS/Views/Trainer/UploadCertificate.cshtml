@model IEnumerable<TSSC.Unified.Models.BatchMaster>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between align-items-center">

        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                Upload Certificate
            </h3>

            <div class="nk-block-des">
                <p>
                    Select a batch to view its trainers and upload certificates.
                </p>
            </div>

        </div>

    </div>

</div>


@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <strong>Success!</strong>
        @TempData["msg"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <strong>Error!</strong>
        @TempData["error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="card card-bordered">

    <div class="card-inner">

        <div class="table-responsive">

            <table class="datatable-init-export table table-tranx table-bordered">

                <thead>

                    <tr>

                        <th>
                            S.No.
                        </th>

                        <th>
                            Batch Code
                        </th>

                        <th>
                            Batch Name
                        </th>

                        <th>
                            Job Role
                        </th>

                        <th>
                            Start Date
                        </th>

                        <th>
                            End Date
                        </th>

                        <th>
                            Trainers
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var batch in Model)
                        {
                            var trainerCount =
                            batch.BatchMasterTrainers?.Count ?? 0;

                            <tr>

                                <!-- S.NO -->
                                <td>
                                    @serial
                                </td>


                                <!-- BATCH CODE -->
                                <td>
                                    @(batch.BatchCode ?? "-")
                                </td>


                                <!-- BATCH NAME -->
                                <td>
                                    <strong>
                                        @batch.BatchName
                                    </strong>
                                </td>


                                <!-- JOB ROLE -->
                                <td>
                                    @(batch.JobRole?.JobRoleTitle ?? "-")
                                </td>


                                <!-- START DATE -->
                                <td>
                                    @(batch.StartDate.HasValue
                                                                ? batch.StartDate.Value.ToString("dd-MM-yyyy")
                                                                : "-")
                                                                  </td>


                                <!-- END DATE -->
                                <td>
                                    @(batch.EndDate.HasValue
                                                                ? batch.EndDate.Value.ToString("dd-MM-yyyy")
                                                                : "-")
                        </td>


                                                    <!-- TRAINERS -->
                                                    <td>
                                                        <span class="badge badge-dim bg-primary">
                                                            @trainerCount
                                                        </span>
                                                    </td>


                                                    <!-- ACTION -->
                                                    <td>

                                                        <a asp-area="HRMS"
                                                           asp-controller="Trainer"
                                                           asp-action="CertificateCandidates"
                                                           asp-route-batchId="@batch.Id"
                                                           class="btn btn-sm btn-outline-primary"
                                                           title="View Trainers">

                                                            <em class="icon ni ni-users"></em>
                                                            View Trainers

                                                        </a>

                                                    </td>

                                                </tr>

                                                serial++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center py-4">

                                No batches found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>