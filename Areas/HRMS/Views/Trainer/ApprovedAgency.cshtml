@model IEnumerable<TSSC.Unified.Models.BatchMaster>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Approved Assessment Agencies
            </h3>
        </div>
    </div>
</div>

<div class="card card-bordered">
    <div class="card-inner">

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["msg"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["error"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <div class="table-responsive">

            <table class="datatable-init-export table table-tranx table_custom table-bordered dataTable no-footer dtr-inline collapsed">

                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Batch Code</th>
                        <th>Batch Name</th>
                        <th>Job Role</th>
                        <th>Assessment Agency</th>
                        <th>Assigned Date</th>
                        <th>Approved By</th>
                        <th>Approved Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@serial</td>

                                <td>
                                    @(item.BatchCode ?? "-")
                                </td>

                                <td>
                                    @(item.BatchName ?? "-")
                                </td>

                                <td>
                                    @(item.JobRole?.JobRoleTitle ?? "-")
                                </td>

                                <td>
                                    @(item.AssessmentAgency?.AgencyName ?? "-")
                                </td>

                                <td>
                                    @(item.AssignedDate?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                                </td>

                                <td>
                                    @(item.VerticalHeadApprovedBy ?? "-")
                                </td>

                                <td>
                                    @(item.VerticalHeadApprovedDate?
                                                                .ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                        </td>

                                <td>
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                </td>
                            </tr>

                                        serial++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center">
                                No approved Assessment Agency requests found.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>

    </div>
</div>