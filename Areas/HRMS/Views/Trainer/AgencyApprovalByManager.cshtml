@model IEnumerable<TSSC.Unified.Models.BatchMaster>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Assessment Agency Approval
            </h3>
        </div>
    </div>
</div>

<div class="card card-bordered">
    <div class="card-inner">

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["msg"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["error"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">

            <table class="datatable-init-export table table-tranx table_custom table-bordered">

                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Batch Code</th>
                        <th>Batch Name</th>
                        <th>Job Role</th>
                        <th>Assessment Agency</th>
                        <th>Assigned Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @serial
                                </td>

                                <td>
                                    @(item.BatchCode ?? "-")
                                </td>

                                <td>
                                    @(item.BatchName ?? "-")
                                </td>

                                <td>
                                    @(item.JobRole?.JobRoleTitle ?? "-")
                                </td>

                                <td>
                                    @(item.AssessmentAgency?.AgencyName ?? "-")
                                </td>

                                <td>
                                    @(item.AssignedDate?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                                </td>

                                <td>
                                    @if (string.Equals(
                                                                item.AgencyApprovalStatus,
                                                                "Pending",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning">
                                            Pending
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.AgencyApprovalStatus,
                                    "Approved",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.AgencyApprovalStatus
                                        </span>
                                    }
                                </td>

                                <td>

                                    @if (string.Equals(
                                                                item.AgencyApprovalStatus,
                                                                "Pending",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-area="HRMS"
                                              asp-controller="Trainer"
                                              asp-action="AgencyApprovalByManager"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Approve"
                                                    onclick="return confirm('Are you sure you want to approve this Assessment Agency?');">

                                                <em class="icon ni ni-check"></em>

                                            </button>

                                        </form>
                                    }
                                    else if (string.Equals(
                                    item.AgencyApprovalStatus,
                                    "Approved",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="text-success">
                                            <em class="icon ni ni-check-circle"></em>
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Processed
                                        </span>
                                    }

                                </td>

                            </tr>

                            serial++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">
                                No Assessment Agency approval requests found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>