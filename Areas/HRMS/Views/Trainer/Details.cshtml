@model TSSC.Unified.Models.TrainerRegistration

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";

    var qualifications = ViewBag.Qualifications;
    var experiences = ViewBag.Experiences;
    var documents = ViewBag.Documents;
}

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between">

        <!-- PAGE TITLE -->
        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                Trainer Registration Details
            </h3>

        </div>


        <!-- BACK -->
        <div class="nk-block-head-content">

            <a asp-area="HRMS"
               asp-controller="Trainer"
               asp-action="RegistrationList"
               class="btn btn-outline-secondary">

                <em class="icon ni ni-arrow-left"></em>

                <span>
                    Back
                </span>

            </a>

        </div>

    </div>

</div>


<div class="row g-gs">


    <!-- ====================================================== -->
    <!-- REGISTRATION / BASIC DETAILS -->
    <!-- ====================================================== -->

    <div class="col-12">

        <div class="card card-bordered">

            <div class="card-inner">

                <h5 class="title mb-4">
                    Registration Details
                </h5>

                <div class="row gy-3">


                    <!-- Registration No -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Registration No.
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.RegistrationNo ?? "-")"
                               readonly />

                    </div>


                    <!-- Candidate Name -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Candidate Name
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.CandidateName ?? "-")"
                               readonly />

                    </div>


                    <!-- Date of Birth -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Date of Birth
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.DateOfBirth?.ToString("dd-MMM-yyyy") ?? "-")"
                               readonly />

                    </div>


                    <!-- Gender -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Gender
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.Gender ?? "-")"
                               readonly />

                    </div>


                    <!-- Job Role -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Job Role
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.JobRoleId"
                               readonly />

                    </div>


                    <!-- TP -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Training Partner
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.TPId?.ToString() ?? "-")"
                               readonly />

                    </div>


                    <!-- SPOC -->
                    <div class="col-md-4">

                        <label class="form-label">
                            SPOC Name
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.SPOCName ?? "-")"
                               readonly />

                    </div>


                    <!-- SIDH -->
                    <div class="col-md-4">

                        <label class="form-label">
                            SIDH Applied
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.SIDHApplied ?? "-")"
                               readonly />

                    </div>


                    <!-- Scheme -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Scheme
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.Scheme ?? "-")"
                               readonly />

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ====================================================== -->
    <!-- CONTACT DETAILS -->
    <!-- ====================================================== -->

    <div class="col-12">

        <div class="card card-bordered">

            <div class="card-inner">

                <h5 class="title mb-4">
                    Contact & Address Details
                </h5>

                <div class="row gy-3">


                    <!-- Email -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Email
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.Email ?? "-")"
                               readonly />

                    </div>


                    <!-- Mobile -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Mobile
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.Mobile ?? "-")"
                               readonly />

                    </div>


                    <!-- Address -->
                    <div class="col-md-12">

                        <label class="form-label">
                            Address
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  readonly>@(Model.Address ?? "-")</textarea>

                    </div>


                    <!-- State -->
                    <div class="col-md-3">

                        <label class="form-label">
                            State
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.StateId?.ToString() ?? "-")"
                               readonly />

                    </div>


                    <!-- District -->
                    <div class="col-md-3">

                        <label class="form-label">
                            District
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.DistrictId?.ToString() ?? "-")"
                               readonly />

                    </div>


                    <!-- City -->
                    <div class="col-md-3">

                        <label class="form-label">
                            City
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.CityId?.ToString() ?? "-")"
                               readonly />

                    </div>


                    <!-- Pincode -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Pincode
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.Pincode ?? "-")"
                               readonly />

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ====================================================== -->
    <!-- REFERENCE DETAILS -->
    <!-- ====================================================== -->

    <div class="col-12">

        <div class="card card-bordered">

            <div class="card-inner">

                <h5 class="title mb-4">
                    Reference Details
                </h5>

                <div class="row gy-3">


                    <div class="col-md-4">

                        <label class="form-label">
                            Reference Name
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.ReferenceName ?? "-")"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Reference Designation
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.ReferenceDesignation ?? "-")"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Reference Organization
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.ReferenceOrganization ?? "-")"
                               readonly />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Reference Email
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.ReferenceEmail ?? "-")"
                               readonly />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Reference Mobile
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.ReferenceMobile ?? "-")"
                               readonly />

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ====================================================== -->
    <!-- QUALIFICATIONS -->
    <!-- ====================================================== -->

    <div class="col-12">

        <div class="card card-bordered">

            <div class="card-inner">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h5 class="title mb-0">
                        Qualifications
                    </h5>

                </div>


                @if (qualifications != null && qualifications.Count > 0)
                {

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover">

                            <thead>

                                <tr>

                                    <th>
                                        S.No.
                                    </th>

                                    <th>
                                        Qualification
                                    </th>

                                    <th>
                                        Board / University
                                    </th>

                                    <th>
                                        Passing Year
                                    </th>

                                    <th>
                                        Percentage / CGPA
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    int qSerial = 1;
                                }

                                @foreach (var item in qualifications)
                                {

                                    <tr>

                                        <td>
                                            @qSerial
                                        </td>

                                        <td>
                                            @item.Qualification
                                        </td>

                                        <td>
                                            @item.Board
                                        </td>

                                        <td>
                                            @item.PassingYear
                                        </td>

                                        <td>
                                            @item.PercentageOrCGPA
                                        </td>

                                    </tr>

                                    qSerial++;

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="text-center text-soft py-4">
                        No qualification details found.
                    </div>

                }

            </div>

        </div>

    </div>



    <!-- ====================================================== -->
    <!-- EXPERIENCE -->
    <!-- ====================================================== -->

    <div class="col-12">

        <div class="card card-bordered">

            <div class="card-inner">

                <h5 class="title mb-4">
                    Experience
                </h5>


                @if (experiences != null && experiences.Count > 0)
                {

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover">

                            <thead>

                                <tr>

                                    <th>
                                        S.No.
                                    </th>

                                    <th>
                                        Organization
                                    </th>

                                    <th>
                                        Designation
                                    </th>

                                    <th>
                                        From Date
                                    </th>

                                    <th>
                                        To Date
                                    </th>

                                    <th>
                                        Duration
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    int eSerial = 1;
                                }

                                @foreach (var item in experiences)
                                {

                                    <tr>

                                        <td>
                                            @eSerial
                                        </td>

                                        <td>
                                            @item.OrganizationName
                                        </td>

                                        <td>
                                            @item.Designation
                                        </td>

                                        <td>
                                            @(item.FromDate?.ToString("dd-MMM-yyyy") ?? "-")
                                        </td>

                                        <td>
                                            @(item.ToDate?.ToString("dd-MMM-yyyy") ?? "-")
                                        </td>

                                        <td>
                                            @(item.Duration ?? "-")
                                        </td>

                                    </tr>

                                    eSerial++;

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="text-center text-soft py-4">
                        No experience details found.
                    </div>

                }

            </div>

        </div>

    </div>



    <!-- ====================================================== -->
    <!-- DOCUMENTS -->
    <!-- ====================================================== -->

    <div class="col-12">

        <div class="card card-bordered">

            <div class="card-inner">

                <h5 class="title mb-4">
                    Uploaded Documents
                </h5>


                @if (documents != null && documents.Count > 0)
                {

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover">

                            <thead>

                                <tr>

                                    <th>
                                        S.No.
                                    </th>

                                    <th>
                                        Document Type
                                    </th>

                                    <th>
                                        File
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    int dSerial = 1;
                                }

                                @foreach (var item in documents)
                                {

                                    <tr>

                                        <td>
                                            @dSerial
                                        </td>

                                        <td>
                                            @item.DocumentType
                                        </td>

                                        <td>
                                            @(item.FileName ?? "-")
                                        </td>

                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(item.FilePath))
                                            {

                                                <a href="@item.FilePath"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-primary">

                                                    <em class="icon ni ni-eye"></em>

                                                    View

                                                </a>

                                            }
                                            else
                                            {

                                                <span>
                                                    -
                                                </span>

                                            }

                                        </td>

                                    </tr>

                                    dSerial++;

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="text-center text-soft py-4">
                        No documents uploaded.
                    </div>

                }

            </div>

        </div>

    </div>

    <!-- ====================================================== -->
    <!-- REGISTRATION INFORMATION -->
    <!-- ====================================================== -->

    <div class="col-12">

        <div class="card card-bordered">

            <div class="card-inner">

                <h5 class="title mb-4">
                    Registration Information
                </h5>

                <div class="row gy-3">


                    <div class="col-md-4">

                        <label class="form-label">
                            Created Date
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Updated Date
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.UpdatedDate?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")"
                               readonly />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Mobile Verified
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(Model.MobileVerified ? "Yes" : "No")"
                               readonly />

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>