								</td>
							</tr>

							count++;
						}
					</tbody>

				</table>
			</div>

		</div>
	</div>
	<!-- YOUR EXISTING CARD ENDS HERE -->

</form>

@section Scripts {
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const selectAll = document.getElementById("selectAllRecords");
			const selectedIds = new Set();

			function getVisibleCheckboxes() {
				return document.querySelectorAll(".record-checkbox");
			}

			function updateSelectAll() {
				const checkboxes = getVisibleCheckboxes();

				selectAll.checked =
					checkboxes.length > 0 &&
					Array.from(checkboxes).every(cb =>
						selectedIds.has(cb.value)
					);

				selectAll.indeterminate =
					Array.from(checkboxes).some(cb =>
						selectedIds.has(cb.value)
					) && !selectAll.checked;
			}

			// Restore checkbox states when DataTables changes pages
			function restoreSelections() {
				getVisibleCheckboxes().forEach(function (checkbox) {
					checkbox.checked = selectedIds.has(checkbox.value);
				});

				updateSelectAll();
			}

			// Select/deselect all records on the current page
			selectAll.addEventListener("change", function () {
				getVisibleCheckboxes().forEach(function (checkbox) {
					checkbox.checked = selectAll.checked;

					if (checkbox.checked) {
						selectedIds.add(checkbox.value);
					} else {
						selectedIds.delete(checkbox.value);
					}
				});

				updateSelectAll();
			});

			// Track individual selections
			document.addEventListener("change", function (event) {
				if (event.target.classList.contains("record-checkbox")) {
					const checkbox = event.target;

					if (checkbox.checked) {
						selectedIds.add(checkbox.value);
					} else {
						selectedIds.delete(checkbox.value);
					}

					updateSelectAll();
				}
			});

			// Hook into DataTables pagination, search, and sorting
			if (window.jQuery &&
				$.fn.DataTable &&
				$.fn.DataTable.isDataTable(".datatable-init-export")) {

				$(".datatable-init-export").on(
					"draw.dt",
					restoreSelections
				);
			}

			// Submit selected IDs from every page
			const form = document.getElementById("bulkDownloadForm");

			if (form) {
				form.addEventListener("submit", function (event) {
					event.preventDefault();

					if (selectedIds.size === 0) {
						alert("Please select at least one record.");
						return;
					}

					form.querySelectorAll(".generated-selected-id")
						.forEach(input => input.remove());

					selectedIds.forEach(function (id) {
						const input = document.createElement("input");
						input.type = "hidden";
						input.name = "selectedIds";
						input.value = id;
						input.className = "generated-selected-id";
						form.appendChild(input);
					});

					form.submit();
				});
			}
		});
	</script>
}