@using TSSC.Unified.Models
@using TSSC.Unified.ViewModel
@model IEnumerable<TPRegistrationListVM>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	Layout = "_Layout";
	ViewData["Title"] = "TP Registrations";
	var pageTitle = "Pending TP Registrations";
	var pageDescription = "Training Partner registrations awaiting your approval.";

	if (ViewBag.CurrentTab == "approved")
	{
		pageTitle = "Approved TP Registrations";
		pageDescription = "Training Partner registrations approved by you.";
	}
	else if (ViewBag.CurrentTab == "rejected")
	{
		pageTitle = "Rejected TP Registrations";
		pageDescription = "Training Partner registrations rejected by you.";
	}
}

<div class="nk-block-head">
	<div class="nk-block-between">

		<div class="nk-block-head-content">

			<h3 class="nk-block-title page-title">
				@pageTitle
			</h3>

			<div class="nk-block-des text-soft">
				<p>
					@pageDescription
				</p>
			</div>

		</div>

	</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success alert-icon">
		<em class="icon ni ni-check-circle"></em>
		@TempData["SuccessMessage"]
	</div>
}

@if (TempData["ErrorMessage"] != null)
{
	<div class="alert alert-danger alert-icon">
		<em class="icon ni ni-alert-circle"></em>
		@TempData["ErrorMessage"]
	</div>
}
<form id="bulkDownloadForm"
