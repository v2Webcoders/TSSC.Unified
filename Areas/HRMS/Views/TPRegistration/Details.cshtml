						<textarea name="remarks"
								  class="form-control"
								  rows="3"
								  placeholder="Enter remarks"></textarea>
					</div>

					<div class="mt-3">
						<button type="submit"
								name="decision"
								value="Approved"
								class="btn btn-success"
								onclick="return confirm('Issue certificate for this TP registration?');">
							<em class="icon ni ni-check"></em> Issue Certificate
						</button>

						<button type="submit"
								name="decision"
								value="Rejected"
								class="btn btn-danger"
								onclick="return confirm('Reject certificate issuance?');">
							<em class="icon ni ni-cross"></em> Reject
						</button>
					</div>
				</form>
			}
		</div>

	</div>
