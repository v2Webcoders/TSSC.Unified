		@* =====================================================
   8. PAYMENT PROCESS
   ===================================================== *@

		<div class="border rounded p-3 mb-3">

			<div class="d-flex justify-content-between align-items-center mb-2">
				<strong>8. Payment Process</strong>

				@if (Model.PaymentProcess_Status == "Approved")
				{
					<span class="badge bg-success">Completed</span>
				}
				else if (Model.PaymentProcess_Status == "Rejected")
				{
					<span class="badge bg-danger">Rejected</span>
				}
				else if (currentStage == "PAYMENT_PROCESS")
				{
					<span class="badge bg-warning">Action Required</span>
				}
				else
				{
					<span class="badge bg-light text-dark">Pending</span>
				}
			</div>

			@* EXISTING PAYMENT DECISION DETAILS *@
			@if (Model.PaymentProcess_Status == "Approved" ||
					Model.PaymentProcess_Status == "Rejected")
			{
				<div class="mt-2 text-soft">
					<strong>@Model.PaymentProcess_Status</strong>

					@if (!string.IsNullOrWhiteSpace(Model.PaymentProcess_Remarks))
					{
						<div class="mt-1">
							@Model.PaymentProcess_Remarks
						</div>
					}

					<div class="mt-2">
						By: @Model.PaymentProcess_ApprovedBy
						<br />
						Date: @Model.PaymentProcess_Date?.ToString("dd MMM yyyy, hh:mm tt")
					</div>
				</div>
			}

			@* =====================================================
       PAYMENT PROOF UPLOADED BY TP APPLICANT
       ===================================================== *@

			<div class="mt-3 pt-3 border-top">
				<h6 class="mb-3">Payment Proof Submitted by TP</h6>

				@if (!string.IsNullOrWhiteSpace(Model.PaymentProofFileName))
				{
					<div class="bg-light rounded p-3">

						<div class="row g-3">

							<div class="col-md-6">
								<div class="text-soft small">
									Transaction ID / UTR
								</div>
								<strong>
									@(string.IsNullOrWhiteSpace(Model.PaymentTransactionId)
																? "-"
																: Model.PaymentTransactionId)
								</strong>
							</div>

							<div class="col-md-6">
								<div class="text-soft small">
									Proof Submitted On
								</div>
								<strong>
									@(Model.PaymentProofSubmittedOn?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
								</strong>
							</div>

							<div class="col-md-6">
								<div class="text-soft small">
									Proof Status
								</div>

								@if (Model.PaymentProofStatus == "Pending")
								{
									<span class="badge bg-warning">
										Awaiting Verification
									</span>
								}
								else if (Model.PaymentProofStatus == "Verified")
								{
									<span class="badge bg-success">
										Verified
									</span>
								}
								else if (Model.PaymentProofStatus == "Rejected")
								{
									<span class="badge bg-danger">
										Proof Rejected
									</span>
								}
								else
								{
									<span class="badge bg-light text-dark">
										@Model.PaymentProofStatus
									</span>
								}
							</div>

							<div class="col-md-6 d-flex align-items-end">
								<a href="~/uploads/TPPaymentProofs/@Model.PaymentProofFileName"
								   target="_blank"
								   rel="noopener"
								   class="btn btn-outline-primary btn-sm">
									<em class="icon ni ni-eye me-1"></em>
									View Uploaded Proof
								</a>
							</div>

						</div>
					</div>
				}
				else
				{
					<div class="alert alert-info mb-0">
						<em class="icon ni ni-info me-1"></em>
						The TP applicant has not uploaded payment proof yet.
					</div>
				}
			</div>

			@* =====================================================
       FINANCE ACTIONS
       ===================================================== *@

			@if (currentStage == "PAYMENT_PROCESS"
					&& userRole == "Finance"
					&& Model.PaymentProcess_Status != "Approved"
					&& Model.PaymentProcess_Status != "Rejected"
					&& Model.PaymentProofStatus == "Pending"
					&& !string.IsNullOrWhiteSpace(Model.PaymentProofFileName))
			{
				<form asp-area="HRMS"
					  asp-controller="TPRegistration"
					  asp-action="Decide"
					  method="post"
					  class="mt-3">

					@Html.AntiForgeryToken()

					<input type="hidden" name="id" value="@Model.Id" />

					<div class="form-group">
						<label class="form-label">Finance Remarks</label>
						<textarea name="remarks"
								  class="form-control"
								  rows="3"
								  placeholder="Enter payment verification remarks"></textarea>
					</div>

					<div class="mt-3 d-flex flex-wrap gap-2">

						<button type="submit"
								name="decision"
								value="Approved"
								class="btn btn-success"
								onclick="return confirm('Have you verified the payment against your bank or payment records?');">
							<em class="icon ni ni-check me-1"></em>
							Verify &amp; Mark Payment Processed
						</button>

						<button type="submit"
								name="decision"
								value="Rejected"
								class="btn btn-danger"
								onclick="return confirm('Are you sure you want to reject this payment proof?');">
							<em class="icon ni ni-cross me-1"></em>
							Reject Payment Proof
						</button>

					</div>
				</form>
			}
			else if (currentStage == "PAYMENT_PROCESS"
			&& userRole == "Finance"
			&& string.IsNullOrWhiteSpace(Model.PaymentProofFileName))
			{
				<div class="alert alert-warning mt-3 mb-0">
					Finance action is unavailable because the TP applicant
					has not submitted payment proof.
				</div>
			}

		</div>

