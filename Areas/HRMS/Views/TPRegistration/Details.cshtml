@using TSSC.Unified.Models
@model TPRegistration

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
	Layout = "_Layout";
	ViewData["Title"] = "TP Registration Details";
	var userRole = ViewBag.UserRole as string;
}

<div class="nk-block-head">
	<div class="nk-block-between">
		<div class="nk-block-head-content">
			<h3 class="nk-block-title page-title">
				TP Registration Details
			</h3>

			<div class="nk-block-des text-soft">
				<p>
					Application ID: <strong>#@Model.Id</strong>
				</p>
			</div>
		</div>

		<div class="nk-block-head-content">
			<a asp-area="HRMS"
			   asp-controller="TPRegistration"
			   asp-action="Index"
			   asp-route-tab="pending"
			   class="btn btn-primary">
				<em class="icon ni ni-arrow-left"></em>
				<span>Back to Registrations</span>
			</a>
		</div>
	</div>
</div>

<div class="card card-bordered">
	<div class="card-inner">
		<div class="row g-gs align-items-center">
			<div class="col-md-8">
				<h5 class="title mb-1">@Model.OrganizationName</h5>
				<span class="text-soft">
					Submitted on @Model.CreatedOn.ToString("dd MMM yyyy, hh:mm tt")
				</span>
			</div>

			<div class="col-md-4 text-md-end">
				@switch (Model.Status)
				{
					case "Submitted":
						<span class="badge bg-warning">Submitted</span>
						break;
					case "Under Review":
						<span class="badge bg-info">Under Review</span>
						break;
					case "Approved":
						<span class="badge bg-success">Approved</span>
						break;
					case "Rejected":
						<span class="badge bg-danger">Rejected</span>
						break;
					default:
						<span class="badge bg-secondary">@Model.Status</span>
						break;
				}
			</div>
		</div>
	</div>
</div>

<div class="card card-bordered mt-4">
	<div class="card-inner">
		<h5 class="title mb-4">Basic Details</h5>

		<div class="row g-gs">
			<div class="col-md-6">
				<span class="sub-text">Membership </span>
				<p><strong>@Model.MembershipType</strong></p>
			</div>
			<div class="col-md-6">
				<span class="sub-text">Organization Name</span>
				<p><strong>@Model.OrganizationName</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Type of Organization</span>
				<p><strong>@Model.OrganizationType</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Registration Number</span>
				<p><strong>@Model.RegistrationNumber</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Date of Incorporation</span>
				<p><strong>@Model.DateOfIncorporation?.ToString("dd MMM yyyy")</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">PAN Number</span>
				<p><strong>@Model.PANNumber</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">GST Number</span>
				<p><strong>@(Model.GSTNumber ?? "Not provided")</strong></p>
			</div>
		</div>
	</div>
</div>

<div class="card card-bordered mt-4">
	<div class="card-inner">
		<h5 class="title mb-4">Organization Profile</h5>

		<div class="row g-gs">
			<div class="col-md-6">
				<span class="sub-text">Sector Experience</span>
				<p><strong>@Model.SectorExperience</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Years of Experience</span>
				<p><strong>@Model.YearsOfExperience</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Training Centers</span>
				<p><strong>@(Model.TrainingCentersCount?.ToString() ?? "Not provided")</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Trainers Available</span>
				<p><strong>@Model.TrainersAvailableCount</strong></p>
			</div>

			<div class="col-12">
				<span class="sub-text">Previous Projects / Work Details</span>
				<p><strong>@(Model.PreviousProjects ?? "Not provided")</strong></p>
			</div>
		</div>
	</div>
</div>

<div class="card card-bordered mt-4">
	<div class="card-inner">
		<h5 class="title mb-4">Contact Details</h5>

		<div class="row g-gs">
			<div class="col-md-6">
				<span class="sub-text">Official Email ID</span>
				<p><strong>@Model.Email</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Mobile Number</span>
				<p><strong>@Model.MobileNumber</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Alternate Contact Person</span>
				<p><strong>@(Model.AlternateContactPerson ?? "Not provided")</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Location</span>
				<p><strong>@Model.City, @Model.District, @Model.State - @Model.PinCode</strong></p>
			</div>

			<div class="col-12">
				<span class="sub-text">Registered Office Address</span>
				<p><strong>@Model.RegisteredOfficeAddress</strong></p>
			</div>
		</div>
	</div>
</div>

<div class="card card-bordered mt-4">
	<div class="card-inner">
		<h5 class="title mb-4">Financial Details</h5>

		<div class="row g-gs">
			<div class="col-md-6">
				<span class="sub-text">Bank Name</span>
				<p><strong>@Model.BankName</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">IFSC Code</span>
				<p><strong>@Model.IFSCCode</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Bank Account Number</span>
				<p><strong>@Model.BankAccountNumber</strong></p>
			</div>
			<div class="col-md-6">
				<span class="sub-text">GST Available</span>
				<p><strong>@(Model.IsGSTAvailable ? "Yes" : "No")</strong></p>
			</div>

			@if (Model.IsGSTAvailable)
			{
				<div class="col-md-6">
					<span class="sub-text">GST Number</span>
					<p><strong>@Model.GSTNumber</strong></p>
				</div>
			}

			<div class="col-12">
				<span class="sub-text">Annual Turnover (Last 3 Years)</span>
				<p><strong>@Model.AnnualTurnoverLast3Years</strong></p>
			</div>
		</div>
	</div>
</div>

<div class="card card-bordered mt-4">
	<div class="card-inner">
		<h5 class="title mb-4">Authorized Person Details</h5>

		<div class="row g-gs">
			<div class="col-md-6">
				<span class="sub-text">Authorized Signatory</span>
				<p><strong>@Model.AuthorizedSignatoryName</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Designation</span>
				<p><strong>@Model.Designation</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Email ID</span>
				<p><strong>@Model.AuthorizedPersonEmail</strong></p>
			</div>

			<div class="col-md-6">
				<span class="sub-text">Mobile Number</span>
				<p><strong>@Model.AuthorizedPersonMobile</strong></p>
			</div>
		</div>
	</div>
</div>

<div class="card card-bordered mt-4">
	<div class="card-inner">
		<h5 class="title mb-4">Uploaded Documents</h5>

		@if (Model.Documents != null && Model.Documents.Any())
		{
			<div class="row g-gs">
				@foreach (var document in Model.Documents)
				{
					<div class="col-md-6">
						<div class="d-flex justify-content-between align-items-center border rounded p-3">
							<div>
								<strong>@document.DocumentType</strong>
								<br />
								<small class="text-soft">
									Uploaded @document.UploadedOn.ToString("dd MMM yyyy")
								</small>
							</div>

							<a href="@Url.Content($"~/uploads/tp-registrations/{Model.Id}/{document.FileName}")"
							   target="_blank"
							   class="btn btn-sm btn-outline-primary">
								<em class="icon ni ni-eye"></em>
								View
							</a>
						</div>
					</div>
				}
			</div>
		}
		else
		{
			<p class="text-soft mb-0">No documents are available.</p>
		}
	</div>
</div>


@* ============================================================
   APPROVAL WORKFLOW
   CurrentStage is the source of truth for the active stage.
   Approval buttons are hidden once a stage has been decided.
   ============================================================ *@

@{
	var currentStage = Model.CurrentStage?.ToUpperInvariant();
}

<div class="card card-bordered mt-4">
	<div class="card-inner">

		<div class="d-flex justify-content-between align-items-center mb-4">
			<h5 class="title mb-0">Approval Workflow</h5>

			@switch (currentStage)
			{
				case "REGIONAL":
					<span class="badge bg-primary">Regional</span>
					break;
				case "AFFILIATIONS":
					<span class="badge bg-primary">Affiliations</span>
					break;
				case "FINANCE":
					<span class="badge bg-primary">Finance</span>
					break;
				case "VERTICAL_HEAD":
					<span class="badge bg-primary">Vertical Head</span>
					break;
				case "SENIOR_REVIEWER_1":
					<span class="badge bg-primary">Senior Reviewer 1</span>
					break;
				case "SENIOR_REVIEWER_2":
					<span class="badge bg-primary">Senior Reviewer 2</span>
					break;
				case "CEO":
					<span class="badge bg-primary">CEO</span>
					break;
				case "PAYMENT_PROCESS":
					<span class="badge bg-primary">Payment Process</span>
					break;
				case "FINANCE_CERTIFICATE":
					<span class="badge bg-primary">Finance Certificate</span>
					break;
				case "CERTIFICATE_ISSUANCE":
					<span class="badge bg-primary">Certificate Issuance</span>
					break;
				default:
					<span class="badge bg-secondary">@Model.CurrentStage</span>
					break;
			}
		</div>

		@* =====================================================
           1. REGIONAL HEAD
           ===================================================== *@

		<div class="border rounded p-3 mb-3">
			<div class="d-flex justify-content-between align-items-center mb-2">
				<strong>1. Regional Head</strong>

				@if (Model.Regional_Head_Status == "Approved")
				{
					<span class="badge bg-success">Approved</span>
				}
				else if (Model.Regional_Head_Status == "Rejected")
				{
					<span class="badge bg-danger">Rejected</span>
				}
				else if (currentStage == "REGIONAL")
				{
					<span class="badge bg-warning">Action Required</span>
				}
				else
				{
					<span class="badge bg-light text-dark">Pending</span>
				}
			</div>

			@if (Model.Regional_Head_Status == "Approved" ||
					Model.Regional_Head_Status == "Rejected")
			{
				<div class="mt-2 text-soft">
					<strong>@Model.Regional_Head_Status</strong>

					@if (!string.IsNullOrWhiteSpace(Model.Regional_Head_Remarks))
					{
						<div class="mt-1">@Model.Regional_Head_Remarks</div>
					}

					<div class="mt-2">
						By: @Model.Regional_Head_ApprovedBy
						<br />
						Date: @Model.Regional_Head_Date?.ToString("dd MMM yyyy, hh:mm tt")
					</div>
				</div>
			}

			@if (currentStage == "REGIONAL" &&
					userRole == "RegionalHead" &&
					Model.Regional_Head_Status != "Approved" &&
					Model.Regional_Head_Status != "Rejected")
			{
				<form asp-area="HRMS"
					  asp-controller="TPRegistration"
					  asp-action="Decide"
					  method="post"
					  class="mt-3">

					@Html.AntiForgeryToken()
					<input type="hidden" name="id" value="@Model.Id" />

					<div class="form-group">
						<label class="form-label">Remarks</label>
						<textarea name="remarks"
								  class="form-control"
								  rows="3"
								  placeholder="Enter remarks"></textarea>
					</div>

					<div class="mt-3">
						<button type="submit"
								name="decision"
								value="Approved"
								class="btn btn-success"
								onclick="return confirm('Approve this TP registration?');">
							<em class="icon ni ni-check"></em> Approve
						</button>

						<button type="submit"
								name="decision"
								value="Rejected"
								class="btn btn-danger"
								onclick="return confirm('Reject this TP registration?');">
							<em class="icon ni ni-cross"></em> Reject
						</button>
					</div>
				</form>
			}
		</div>

		@* =====================================================
           2. AFFILIATIONS
           ===================================================== *@

		<div class="border rounded p-3 mb-3">
			<div class="d-flex justify-content-between align-items-center mb-2">
				<strong>2. Affiliations</strong>

				@if (Model.Affiliations_Status == "Approved")
				{
					<span class="badge bg-success">Approved</span>
				}
				else if (Model.Affiliations_Status == "Rejected")
				{
					<span class="badge bg-danger">Rejected</span>
				}
				else if (currentStage == "AFFILIATIONS")
