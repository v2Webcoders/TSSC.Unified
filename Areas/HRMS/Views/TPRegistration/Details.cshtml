			}

			@if (currentStage == "AFFILIATIONS" &&
					userRole == "AffiliationTeam" &&
					Model.Affiliations_Status != "Approved" &&
					Model.Affiliations_Status != "Rejected")
			{
				<form asp-area="HRMS"
