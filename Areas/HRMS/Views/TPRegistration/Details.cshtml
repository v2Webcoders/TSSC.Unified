@using TSSC.Unified.Models
@model TPRegistration

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "TP Registration Details";
    var userRole = ViewBag.UserRole as string;
}

<div class="nk-block-head">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                TP Registration Details
            </h3>

            <div class="nk-block-des text-soft">
                <p>
                    Application ID: <strong>#@Model.Id</strong>
                </p>
            </div>
        </div>

        <div class="nk-block-head-content">
            <a asp-area="HRMS"
               asp-controller="TPRegistration"
               asp-action="Index"
               asp-route-tab="pending"
               class="btn btn-primary">
                <em class="icon ni ni-arrow-left"></em>
                <span>Back to Registrations</span>
            </a>
        </div>
    </div>
</div>

<div class="card card-bordered">
    <div class="card-inner">
        <div class="row g-gs align-items-center">
            <div class="col-md-8">
                <h5 class="title mb-1">@Model.OrganizationName</h5>
                <span class="text-soft">
                    Submitted on @Model.CreatedOn.ToString("dd MMM yyyy, hh:mm tt")
                </span>
            </div>

            <div class="col-md-4 text-md-end">
                @switch (Model.Status)
                {
                    case "Submitted":
                        <span class="badge bg-warning">Submitted</span>
                        break;
                    case "Under Review":
                        <span class="badge bg-info">Under Review</span>
                        break;
                    case "Approved":
                        <span class="badge bg-success">Approved</span>
                        break;
                    case "Rejected":
                        <span class="badge bg-danger">Rejected</span>
                        break;
                    default:
                        <span class="badge bg-secondary">@Model.Status</span>
                        break;
                }
            </div>
        </div>
    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">
        <h5 class="title mb-4">Basic Details</h5>

        <div class="row g-gs">
            <div class="col-md-6">
                <span class="sub-text">Organization Name</span>
                <p><strong>@Model.OrganizationName</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Type of Organization</span>
                <p><strong>@Model.OrganizationType</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Registration Number</span>
                <p><strong>@Model.RegistrationNumber</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Date of Incorporation</span>
                <p><strong>@Model.DateOfIncorporation?.ToString("dd MMM yyyy")</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">PAN Number</span>
                <p><strong>@Model.PANNumber</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">GST Number</span>
                <p><strong>@(Model.GSTNumber ?? "Not provided")</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">
        <h5 class="title mb-4">Organization Profile</h5>

        <div class="row g-gs">
            <div class="col-md-6">
                <span class="sub-text">Sector Experience</span>
                <p><strong>@Model.SectorExperience</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Years of Experience</span>
                <p><strong>@Model.YearsOfExperience</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Training Centers</span>
                <p><strong>@(Model.TrainingCentersCount?.ToString() ?? "Not provided")</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Trainers Available</span>
                <p><strong>@Model.TrainersAvailableCount</strong></p>
            </div>

            <div class="col-12">
                <span class="sub-text">Previous Projects / Work Details</span>
                <p><strong>@(Model.PreviousProjects ?? "Not provided")</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">
        <h5 class="title mb-4">Contact Details</h5>

        <div class="row g-gs">
            <div class="col-md-6">
                <span class="sub-text">Official Email ID</span>
                <p><strong>@Model.Email</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Mobile Number</span>
                <p><strong>@Model.MobileNumber</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Alternate Contact Person</span>
                <p><strong>@(Model.AlternateContactPerson ?? "Not provided")</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Location</span>
                <p><strong>@Model.City, @Model.District, @Model.State - @Model.PinCode</strong></p>
            </div>

            <div class="col-12">
                <span class="sub-text">Registered Office Address</span>
                <p><strong>@Model.RegisteredOfficeAddress</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">
        <h5 class="title mb-4">Financial Details</h5>

        <div class="row g-gs">
            <div class="col-md-6">
                <span class="sub-text">Bank Name</span>
                <p><strong>@Model.BankName</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">IFSC Code</span>
                <p><strong>@Model.IFSCCode</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Bank Account Number</span>
                <p><strong>@Model.BankAccountNumber</strong></p>
            </div>

            <div class="col-12">
                <span class="sub-text">Annual Turnover (Last 3 Years)</span>
                <p><strong>@Model.AnnualTurnoverLast3Years</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">
        <h5 class="title mb-4">Authorized Person Details</h5>

        <div class="row g-gs">
            <div class="col-md-6">
                <span class="sub-text">Authorized Signatory</span>
                <p><strong>@Model.AuthorizedSignatoryName</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Designation</span>
                <p><strong>@Model.Designation</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Email ID</span>
                <p><strong>@Model.AuthorizedPersonEmail</strong></p>
            </div>

            <div class="col-md-6">
                <span class="sub-text">Mobile Number</span>
                <p><strong>@Model.AuthorizedPersonMobile</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">
        <h5 class="title mb-4">Uploaded Documents</h5>

        @if (Model.Documents != null && Model.Documents.Any())
        {
            <div class="row g-gs">
                @foreach (var document in Model.Documents)
                {
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center border rounded p-3">
                            <div>
                                <strong>@document.DocumentType</strong>
                                <br />
                                <small class="text-soft">
                                    Uploaded @document.UploadedOn.ToString("dd MMM yyyy")
                                </small>
                            </div>

                            <a href="@Url.Content($"~/uploads/tp-registrations/{Model.Id}/{document.FileName}")"
                               target="_blank"
                               class="btn btn-sm btn-outline-primary">
                                <em class="icon ni ni-eye"></em>
                                View
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-soft mb-0">No documents are available.</p>
        }
    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">

        <h5 class="title mb-3">
            Regional Head Approval
        </h5>

        @if (Model.Regional_Head_Status == "Approved")
        {
            <div class="alert alert-success mb-0">
                <strong>Approved</strong>
                <br />
                @Model.Regional_Head_Remarks

                <div class="mt-2 text-soft">
                    Approved By:
                    @Model.Regional_Head_ApprovedBy
                    <br />
                    Date:
                    @Model.Regional_Head_Date?.ToString("dd MMM yyyy, hh:mm tt")
                </div>
            </div>
        }
        else if (Model.Regional_Head_Status == "Rejected")
        {
            <div class="alert alert-danger mb-0">
                <strong>Rejected</strong>
                <br />
                @Model.Regional_Head_Remarks

                <div class="mt-2 text-soft">
                    Rejected By:
                    @Model.Regional_Head_ApprovedBy
                    <br />
                    Date:
                    @Model.Regional_Head_Date?.ToString("dd MMM yyyy, hh:mm tt")
                </div>
            </div>
        }
        else if (userRole == "RegionalHead")
        {
            <form asp-area="HRMS"
                  asp-controller="TPRegistration"
                  asp-action="Decide"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="form-group">
                    <label class="form-label">Remarks</label>

                    <textarea name="remarks"
                              class="form-control"
                              rows="3"
                              placeholder="Enter remarks"></textarea>
                </div>

                <div class="mt-3">

                    <button type="submit"
                            name="decision"
                            value="Approved"
                            class="btn btn-success"
                            onclick="return confirm('Approve this TP registration?');">
                        <em class="icon ni ni-check"></em>
                        Approve
                    </button>

                    <button type="submit"
                            name="decision"
                            value="Rejected"
                            class="btn btn-danger"
                            onclick="return confirm('Reject this TP registration?');">
                        <em class="icon ni ni-cross"></em>
                        Reject
                    </button>

                </div>

            </form>
        }
        else
        {
            <span class="badge bg-warning">
                Pending
            </span>
        }

    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">

        <h5 class="title mb-3">
            Vertical Head Approval
        </h5>

        @if (Model.Vertical_Head_Status == "Approved")
        {
            <div class="alert alert-success mb-0">
                <strong>Approved</strong>
                <br />

                @Model.Vertical_Head_Remarks

                <div class="mt-2 text-soft">
                    Approved By:
                    @Model.Vertical_Head_ApprovedBy
                    <br />

                    Date:
                    @Model.Vertical_Head_Date?.ToString(
                             "dd MMM yyyy, hh:mm tt")
                </div>
            </div>
        }
        else if (Model.Vertical_Head_Status == "Rejected")
        {
            <div class="alert alert-danger mb-0">
                <strong>Rejected</strong>
                <br />

                @Model.Vertical_Head_Remarks

                <div class="mt-2 text-soft">
                    Rejected By:
                    @Model.Vertical_Head_ApprovedBy
                    <br />

                    Date:
                    @Model.Vertical_Head_Date?.ToString(
                             "dd MMM yyyy, hh:mm tt")
                </div>
            </div>
        }
        else if (userRole == "VerticalHead"
        && Model.Regional_Head_Status == "Approved")
        {
            <form asp-area="HRMS"
                  asp-controller="TPRegistration"
                  asp-action="Decide"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="form-group">
                    <label class="form-label">
                        Remarks
                    </label>

                    <textarea name="remarks"
                              class="form-control"
                              rows="3"
                              placeholder="Enter remarks"></textarea>
                </div>

                <div class="mt-3">

                    <button type="submit"
                            name="decision"
                            value="Approved"
                            class="btn btn-success"
                            onclick="return confirm('Approve this TP registration?');">
                        <em class="icon ni ni-check"></em>
                        Approve
                    </button>

                    <button type="submit"
                            name="decision"
                            value="Rejected"
                            class="btn btn-danger"
                            onclick="return confirm('Reject this TP registration?');">
                        <em class="icon ni ni-cross"></em>
                        Reject
                    </button>

                </div>

            </form>
        }
        else
        {
            <span class="badge bg-warning">
                Pending
            </span>
        }

    </div>
</div>
<div class="card card-bordered mt-4">
    <div class="card-inner">

        <h5 class="title mb-3">
            Finance Approval
        </h5>

        @if (Model.Finance_Status == "Approved")
        {
            <div class="alert alert-success mb-0">
                <strong>Approved</strong>
                <br />
                @Model.Finance_Remarks

                <div class="mt-2 text-soft">
                    Approved By:
                    @Model.Finance_ApprovedBy
                    <br />
                    Date:
                    @Model.Finance_Date?.ToString(
                             "dd MMM yyyy, hh:mm tt")
                </div>
            </div>
        }
        else if (Model.Finance_Status == "Rejected")
        {
            <div class="alert alert-danger mb-0">
                <strong>Rejected</strong>
                <br />
                @Model.Finance_Remarks

                <div class="mt-2 text-soft">
                    Rejected By:
                    @Model.Finance_ApprovedBy
                    <br />
                    Date:
                    @Model.Finance_Date?.ToString(
                             "dd MMM yyyy, hh:mm tt")
                </div>
            </div>
        }
        else if (userRole == "Finance"
        && Model.Vertical_Head_Status == "Approved")
        {
            <form asp-area="HRMS"
                  asp-controller="TPRegistration"
                  asp-action="Decide"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="form-group">
                    <label class="form-label">Remarks</label>

                    <textarea name="remarks"
                              class="form-control"
                              rows="3"
                              placeholder="Enter remarks"></textarea>
                </div>

                <div class="mt-3">

                    <button type="submit"
                            name="decision"
                            value="Approved"
                            class="btn btn-success">
                        <em class="icon ni ni-check"></em>
                        Approve
                    </button>

                    <button type="submit"
                            name="decision"
                            value="Rejected"
                            class="btn btn-danger">
                        <em class="icon ni ni-cross"></em>
                        Reject
                    </button>

                </div>

            </form>
        }
        else
        {
            <span class="badge bg-warning">
                Pending
            </span>
        }

    </div>
</div>

<div class="card card-bordered mt-4">
    <div class="card-inner">

        <h5 class="title mb-3">
            CEO Approval
        </h5>

        @if (Model.CEO_Status == "Approved")
        {
            <div class="alert alert-success mb-0">

                <strong>Approved</strong>

                @if (!string.IsNullOrWhiteSpace(Model.CEO_Remarks))
                {
                    <br />
                    @Model.CEO_Remarks
                }

                <div class="mt-2 text-soft">
                    Approved By:
                    @Model.CEO_ApprovedBy
                    <br />

                    Date:
                    @Model.CEO_Date?.ToString(
                             "dd MMM yyyy, hh:mm tt")
                </div>

            </div>
        }
        else if (Model.CEO_Status == "Rejected")
        {
            <div class="alert alert-danger mb-0">

                <strong>Rejected</strong>

                @if (!string.IsNullOrWhiteSpace(Model.CEO_Remarks))
                {
                    <br />
                    @Model.CEO_Remarks
                }

                <div class="mt-2 text-soft">
                    Rejected By:
                    @Model.CEO_ApprovedBy
                    <br />

                    Date:
                    @Model.CEO_Date?.ToString(
                             "dd MMM yyyy, hh:mm tt")
                </div>

            </div>
        }
        else if (userRole == "CEO"
        && Model.Finance_Status == "Approved")
        {
            <form asp-area="HRMS"
                  asp-controller="TPRegistration"
                  asp-action="Decide"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="form-group">
                    <label class="form-label">
                        Remarks
                    </label>

                    <textarea name="remarks"
                              class="form-control"
                              rows="3"
                              placeholder="Enter remarks, especially when rejecting the application."></textarea>
                </div>

                <div class="mt-3">

                    <button type="submit"
                            name="decision"
                            value="Approved"
                            class="btn btn-success"
                            onclick="return confirm('Approve this TP registration?');">

                        <em class="icon ni ni-check"></em>
                        Approve

                    </button>

                    <button type="submit"
                            name="decision"
                            value="Rejected"
                            class="btn btn-danger"
                            onclick="return confirm('Reject this TP registration?');">

                        <em class="icon ni ni-cross"></em>
                        Reject

                    </button>

                </div>

            </form>
        }
        else
        {
            <div class="d-flex align-items-center">
                <span class="badge bg-warning">
                    Pending
                </span>

                <span class="text-soft ms-2">
                    Awaiting CEO approval
                </span>
            </div>
        }

    </div>
</div>

