@using TSSC.Unified.Models
@model IEnumerable<Holiday>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    bool isHR = User.IsInRole("HR");
    var year = (int)ViewBag.Year;
    var month = (int)ViewBag.Month;

    var firstDate =
        new DateTime(year, month, 1);

    var daysInMonth =
        DateTime.DaysInMonth(year, month);

    var firstDayOfWeek =
        (int)firstDate.DayOfWeek;

    var holidays =
        Model.ToList();

    var previousMonth =
        firstDate.AddMonths(-1);

    var nextMonth =
        firstDate.AddMonths(1);

    var monthName =
        firstDate.ToString("MMMM yyyy");
}
<style>
    .holiday-calendar {
    table-layout: fixed;
    min-width: 900px;
    }

    .holiday-calendar th {
    text-align: center;
    background: #3aa7bd;
    color: #fff;
    font-weight: 600;
    padding: 12px;
    }

    .holiday-calendar td {
    height: 120px;
    vertical-align: top;
    padding: 10px;
    background: #f8fafc;
    }

    .holiday-calendar .empty-day {
    background: #eef2f5;
    }

    .calendar-date {
    font-size: 16px;
    margin-bottom: 10px;
    }

    .mark-holiday {
    margin-top: 20px;
    font-size: 12px;
    }

    .holiday-box {
    padding: 8px;
    border-radius: 6px;
    background: #e7f7ed;
    border-left: 4px solid #20c997;
    }

    .holiday-box strong {
    display: block;
    margin-bottom: 5px;
    word-break: break-word;
    }
</style>
<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between">

        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                Holiday Calendar
            </h3>

            <div class="nk-block-des text-soft">
                Manage company holidays and working calendar.
            </div>

        </div>

    </div>

</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <em class="icon ni ni-check-circle me-1"></em>

        @TempData["Success"]

        <button type="button"
        class="btn-close"
        data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <em class="icon ni ni-cross-circle me-1"></em>

        @TempData["Error"]

        <button type="button"
        class="btn-close"
        data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="card card-preview">

    <div class="card-inner">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-action="Holidays"
            asp-route-year="@previousMonth.Year"
            asp-route-month="@previousMonth.Month"
            class="btn btn-outline-primary">
                <em class="icon ni ni-chevron-left"></em>
                Previous
            </a>
            <h4 class="mb-0">
                @monthName
            </h4>
            <a asp-action="Holidays"
            asp-route-year="@nextMonth.Year"
            asp-route-month="@nextMonth.Month"
            class="btn btn-outline-primary">
                Next
                <em class="icon ni ni-chevron-right"></em>
            </a>
        </div>
        <div class="table-responsive">

            <table class="table table-bordered holiday-calendar">

                <thead>

                    <tr>

                        <th>Sun</th>
                        <th>Mon</th>
                        <th>Tue</th>
                        <th>Wed</th>
                        <th>Thu</th>
                        <th>Fri</th>
                        <th>Sat</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int day = 1;
                        int totalCells =
                            (int)Math.Ceiling(
                                (firstDayOfWeek + daysInMonth) / 7.0) * 7;
                    }

                    @for (int cell = 0;
                        cell < totalCells;
                        cell++)
                    {
                        if (cell % 7 == 0)
                        {
                            @:<tr>
                        }


                        if (cell < firstDayOfWeek ||
                            day > daysInMonth)
                        {
                            <td class="empty-day"></td>
                        }
                        else
                        {
                            var currentDate =
                                new DateTime(
                                    year,
                                    month,
                                    day);

                            var holiday =
                                holidays.FirstOrDefault(x =>
                                    x.HolidayDate.Date ==
                                    currentDate.Date);


                            <td class="calendar-day">

                                <div class="calendar-date">

                                    <strong>
                                        @day
                                    </strong>

                                </div>


                                @if (holiday != null)
                                {
                                    <div class="holiday-box">

                                        <strong>
                                            @holiday.HolidayName
                                        </strong>

                                        <span class="badge bg-success">
                                            Holiday
                                        </span>
                                        @if (isHR)
                                        {
                                            <div class="mt-2">

                                                <!-- EDIT -->
                                                <button type="button"
                                                class="btn btn-sm btn-outline-primary edit-holiday"
                                                data-id="@holiday.HolidayId"
                                                data-date="@holiday.HolidayDate.ToString("yyyy-MM-dd")"
                                                data-name="@holiday.HolidayName"
                                                data-type="@holiday.HolidayType"
                                                data-description="@holiday.Description"
                                                title="Edit Holiday">

                                                    <em class="icon ni ni-edit"></em>

                                                </button>


                                                <!-- DELETE -->
                                                <form asp-action="DeleteHoliday"
                                                method="post"
                                                class="d-inline"
                                                onsubmit="return confirm('Are you sure you want to delete this holiday?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                    name="id"
                                                    value="@holiday.HolidayId" />

                                                    <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete Holiday">

                                                        <em class="icon ni ni-trash"></em>

                                                    </button>

                                                </form>
                                            </div>
                                        }


                                    </div>
                                }
                                else
                                {
                                    @if (isHR)
                                    {
                                        <button type="button"
                                class="btn btn-sm btn-primary mark-holiday"
                                data-date="@currentDate.ToString("yyyy-MM-dd")">

                            <em class="icon ni ni-calendar-check"></em>

                            Mark Holiday

                        </button>
                                    }

                                }

                </td>

                day++;
            }


            if (cell % 7 == 6)
            {
                @:</tr>
            }
        }

        </tbody>

    </table>

</div>

</div>

</div>

                                <div class="modal fade"
     id="markHolidayModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="MarkHoliday"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title">
                        Mark Holiday
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Holiday Date
                        </label>

                        <input type="date"
                               id="HolidayDate"
                               name="HolidayDate"
                               class="form-control"
                               readonly
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Holiday Name
                        </label>

                        <input type="text"
                               id="HolidayName"
                               name="HolidayName"
                               class="form-control"
                               placeholder="Independence Day"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Holiday Type
                        </label>

                        <select id="HolidayType"
                                name="HolidayType"
                                class="form-select">

                            <option value="Public Holiday">
                                Public Holiday
                            </option>

                            <option value="Company Holiday">
                                Company Holiday
                            </option>

                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Remarks
                        </label>

                        <textarea id="Description"
                                  name="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional remarks"></textarea>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <em class="icon ni ni-check me-1"></em>

                        Mark Holiday

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- EDIT HOLIDAY MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="editHolidayModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="EditHoliday"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="EditHolidayId"
                       name="HolidayId" />


                <div class="modal-header">

                    <h5 class="modal-title">
                        Edit Holiday
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <!-- DATE -->

                    <div class="mb-3">

                        <label class="form-label">
                            Holiday Date
                        </label>

                        <input type="date"
                               id="EditHolidayDate"
                               name="HolidayDate"
                               class="form-control"
                               required />

                    </div>


                    <!-- NAME -->

                    <div class="mb-3">

                        <label class="form-label">
                            Holiday Name
                        </label>

                        <input type="text"
                               id="EditHolidayName"
                               name="HolidayName"
                               class="form-control"
                               required />

                    </div>


                    <!-- TYPE -->

                    <div class="mb-3">

                        <label class="form-label">
                            Holiday Type
                        </label>

                        <select id="EditHolidayType"
                                name="HolidayType"
                                class="form-select">

                            <option value="Public Holiday">
                                Public Holiday
                            </option>

                            <option value="Company Holiday">
                                Company Holiday
                            </option>

                        </select>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="mb-3">

                        <label class="form-label">
                            Remarks
                        </label>

                        <textarea id="EditDescription"
                                  name="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional remarks"></textarea>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <em class="icon ni ni-check me-1"></em>

                        Update Holiday

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script>

    document
        .querySelectorAll(".mark-holiday")
        .forEach(function (button) {

            button.addEventListener("click", function () {

                const date =
                    this.getAttribute("data-date");


                document
                    .getElementById("HolidayDate")
                    .value = date;


                document
                    .getElementById("HolidayName")
                    .value = "";


                document
                    .getElementById("Description")
                    .value = "";


                document
                    .getElementById("HolidayType")
                    .value = "Public Holiday";


                const modal =
                    new bootstrap.Modal(
                        document.getElementById(
                            "markHolidayModal"
                        )
                    );


                modal.show();

            });

        });
       

</script>


@section Scripts {

    <script>

        document.addEventListener("click", function (event) {

            const editButton =
                event.target.closest(".edit-holiday");

            if (!editButton)
                return;

            alert("EDIT CLICKED");


            // =========================================
            // GET BUTTON DATA
            // =========================================

            const id =
                editButton.dataset.id;

            const date =
                editButton.dataset.date;

            const name =
                editButton.dataset.name;

            const type =
                editButton.dataset.type;

            const description =
                editButton.dataset.description;


            // =========================================
            // FILL FORM
            // =========================================

            document.getElementById("EditHolidayId").value =
                id || "";

            document.getElementById("EditHolidayDate").value =
                date || "";

            document.getElementById("EditHolidayName").value =
                name || "";

            document.getElementById("EditHolidayType").value =
                type || "";

            document.getElementById("EditDescription").value =
                description || "";


            // =========================================
            // GET MODAL
            // =========================================

            const modalElement =
                document.getElementById("editHolidayModal");


            if (!modalElement) {

                alert("Modal element NOT FOUND");

                return;
            }


            // =========================================
            // OPEN MODAL
            // =========================================

            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );

            modal.show();

        });

    </script>

}

