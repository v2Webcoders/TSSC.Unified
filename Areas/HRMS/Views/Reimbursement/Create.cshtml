@model TSSC.Unified.ViewModel.ReimbursementVM

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.ReimbursementId > 0
        ? "Edit Reimbursement"
        : "Apply Reimbursement";
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                @(Model.ReimbursementId > 0
                                ? "Edit Reimbursement"
                                : "Apply Reimbursement")
            </h3>
        </div>

        <div class="nk-block-head-content">
            <a asp-action="MyReimbursement"
               asp-controller="Reimbursement"
               asp-area="HRMS"
               class="btn btn-primary d-none d-md-inline-flex">

                <em class="icon ni ni-list"></em>
                &nbsp; My Reimbursement

            </a>
        </div>

    </div>
</div>


<div class="nk-block nk-block-lg">

    <div class="card card-preview">

        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        }

        @if (TempData["msg"] != null)
        {
            <div class="example-alert w-100">

                <div class="alert alert-success alert-icon">

                    <em class="icon ni ni-check-circle"></em>

                    <strong>@TempData["msg"]</strong>

                </div>

            </div>
        }


        <div class="card-inner">

            <form asp-action="Create"
                  asp-controller="Reimbursement"
                  asp-area="HRMS"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden" asp-for="ReimbursementId" />

                <input type="hidden" asp-for="EmployeeId" />


                <div class="row gy-3">


                    <!-- ================================================= -->
                    <!-- 1. EMPLOYEE DETAIL -->
                    <!-- ================================================= -->

                    <div class="col-12 mb-2">

                        <div style="border-left:4px solid #D9622F;padding:5px 0 5px 12px;">

                            <h5 class="mb-0 d-flex align-items-center gap-2"
                                style="color:#1B2A4A;">

                                <em class="ni ni-user"></em>

                                1. Employee Detail

                            </h5>

                        </div>

                    </div>


                    <!-- Employee Name -->

                    <div class="col-md-4">

                        <label class="form-label">

                            Employee Name
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="EmployeeName"
                               class="form-control"
                               readonly />

                    </div>


                    <!-- Employee ID -->

                    <div class="col-md-4">

                        <label class="form-label">

                            Employee ID
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="EmployeeCode"
                               class="form-control"
                               readonly />

                    </div>


                    <!-- Department -->

                    <div class="col-md-4">

                        <label class="form-label">

                            Department
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="DepartmentName"
                               class="form-control"
                               readonly />

                    </div>


                    <!-- Divider -->

                    <div class="col-12">

                        <hr class="my-3" />

                    </div>


                    <!-- ================================================= -->
                    <!-- 2. REIMBURSEMENT DETAIL -->
                    <!-- ================================================= -->

                    <div class="col-12 mb-2">

                        <div style="border-left:4px solid #D9622F;padding:5px 0 5px 12px;">

                            <h5 class="mb-0 d-flex align-items-center gap-2"
                                style="color:#1B2A4A;">

                                <em class="ni ni-wallet"></em>

                                2. Reimbursement Detail

                            </h5>

                        </div>

                    </div>


                    <!-- Amount -->

                    <div class="col-md-3">

                        <label class="form-label">

                           Enter Amount (₹)
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="ExpenseAmount"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter Amount" />

                        <span asp-validation-for="ExpenseAmount"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Expense Date -->

                    <div class="col-md-3">

                        <label class="form-label">

                            Expense Date
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="ExpenseDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="ExpenseDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Category -->

                    <div class="col-md-3">

                        <label class="form-label">

                            Category
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="ExpenseCategory"
                                asp-items="Model.ExpenseCategoryList"
                                class="form-select">

                            <option value="">
                                Select Category
                            </option>

                        </select>

                        <span asp-validation-for="ExpenseCategory"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Payment Mode -->

                    <div class="col-md-3">

                        <label class="form-label">

                            Payment Mode
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="PaymentMode"
                                asp-items="Model.PaymentModeList"
                                class="form-select">

                            <option value="">
                                Select Payment Mode
                            </option>

                        </select>

                        <span asp-validation-for="PaymentMode"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Description / Purpose -->

                    <div class="col-md-12">

                        <label class="form-label">

                            Description / Purpose
                            <span class="text-danger">*</span>

                        </label>

                        <textarea asp-for="Purpose"
                                  rows="4"
                                  class="form-control"
                                  placeholder="Enter description / purpose"></textarea>

                        <span asp-validation-for="Purpose"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ================================================= -->
                    <!-- PAYMENT PROOF / BILL -->
                    <!-- ================================================= -->

                    <div class="col-md-6">

                        <label class="form-label">

                            Payment Proof / Bill
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="InvoiceBillFile"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.pdf" />

                        <small class="form-text text-muted">

                            Upload valid bills / receipts
                            (JPG, PNG, PDF)

                        </small>


                        @if (!string.IsNullOrEmpty(Model.InvoiceBill))
                        {
                            <div class="mt-2">

                                <a href="@Url.Content(Model.InvoiceBill)"
                                   target="_blank"
                                   class="btn btn-sm btn-info">

                                    <em class="icon ni ni-file"></em>

                                    View Current Bill

                                </a>

                            </div>
                        }


                        <input type="hidden"
                               asp-for="InvoiceBill" />

                    </div>


                    <!-- ================================================= -->
                    <!-- ADDITIONAL DOCUMENT -->
                    <!-- ================================================= -->

                    <div class="col-md-6">

                        <label class="form-label">

                            Additional Document (if any)

                        </label>

                        <input asp-for="SupportingDocumentFile"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.pdf" />

                        <small class="form-text text-muted">

                            Upload valid bills / receipts
                            (JPG, PNG, PDF)

                        </small>


                        @if (!string.IsNullOrEmpty(Model.SupportingDocument))
                        {
                            <div class="mt-2">

                                <a href="@Url.Content(Model.SupportingDocument)"
                                   target="_blank"
                                   class="btn btn-sm btn-info">

                                    <em class="icon ni ni-file"></em>

                                    View Current Document

                                </a>

                            </div>
                        }


                        <input type="hidden"
                               asp-for="SupportingDocument" />

                    </div>


                    <!-- ================================================= -->
                    <!-- BUTTONS -->
                    <!-- ================================================= -->

                    <div class="col-12 mt-4">

                        <button type="submit"
                                class="btn btn-primary">

                            @if (Model.ReimbursementId > 0)
                            {
                                <em class="icon ni ni-edit"></em>

                                <span>
                                    Update Reimbursement
                                </span>
                            }
                            else
                            {
                                <em class="icon ni ni-save"></em>

                                <span>
                                    Submit Reimbursement
                                </span>
                            }

                        </button>


                        <a asp-action="MyReimbursement"
                           asp-controller="Reimbursement"
                           asp-area="HRMS"
                           class="btn btn-outline-secondary ms-2">

                            Cancel

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}