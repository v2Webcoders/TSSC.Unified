@using TSSC.Unified.Models
@model Employee

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "_Layout";
}

<div class="nk-block-head nk-block-head-sm">

	<div class="nk-block-between">

		<div class="nk-block-head-content">

			<h3 class="nk-block-title page-title">
				My Profile
			</h3>

			<div class="nk-block-des text-soft">
				<p>
					View your personal and employment information.
				</p>
			</div>

		</div>

	</div>

</div>


<div class="nk-block nk-block-lg">

	<div class="card card-preview">

		<div class="card-inner">

			<div class="preview-block">


				<!-- ================= Profile Header ================= -->

				<div class="row align-items-center mb-5 p-4 border rounded-3"
					 style="border:1px solid #d9dee3 !important;
            background:#fff;
            box-shadow:0 2px 8px rgba(0,0,0,0.05);">

					<div class="col-md-3 text-center">

						<img src="@(string.IsNullOrEmpty(Model.PhotoPath)
? Url.Content("~/images/no-user.png")
: Url.Content(Model.PhotoPath))"
							 class="rounded-circle"
							 style="width:150px;
                    height:150px;
                    object-fit:cover;
                    border:4px solid #dee2e6;
                    padding:4px;
                    background:#fff;" />

					</div>

					<div class="col-md-9">

						<h3 class="mb-1" style="color:#1B2A4A;">
							@Model.FirstName @Model.LastName
						</h3>

						<p class="text-muted mb-2">
							Employee Code:
							<strong>@Model.EmployeeCode</strong>
						</p>

						<div class="d-flex flex-wrap gap-2">

							<span class="badge bg-primary">
								@Model.Designation.DesignationName
							</span>

							<span class="badge bg-success">
								@Model.EmploymentStatus
							</span>

						</div>

					</div>

				</div>

				<!-- ================= Personal Information ================= -->

				<div class="col-12 mb-4">

					<div style="border-left:4px solid #D9622F;
                padding:5px 0 5px 12px;">

						<h5 class="mb-0 d-flex align-items-center gap-2"
							style="color:#1B2A4A;">

							<em class="ni ni-user-alt"></em>
							Personal Information

						</h5>

					</div>

				</div>

				<div class="row gy-4 mb-5">

					<div class="col-md-4">

						<label class="form-label text-muted">
							First Name
						</label>

						<div class="form-control-plaintext fw-bold"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">
							@Model.FirstName
						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Last Name
						</label>

						<div class="form-control-plaintext fw-bold"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">
							@Model.LastName
						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Gender
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">
							@Model.Gender
						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Date of Birth
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">
							@(Model.DOB?.ToString("dd MMM yyyy") ?? "-")
						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Blood Group
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">
							@(string.IsNullOrEmpty(Model.BloodGroup)
														? "-"
														: Model.BloodGroup)
						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Marital Status
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">
							@(string.IsNullOrEmpty(Model.MaritalStatus)
														? "-"
														: Model.MaritalStatus)
						</div>

					</div>

				</div>


				<!-- ================= Contact Information ================= -->

				<div class="col-12 mb-4">

					<div style="border-left:4px solid #D9622F;
                padding:5px 0 5px 12px;">

						<h5 class="mb-0 d-flex align-items-center gap-2"
							style="color:#1B2A4A;">

							<em class="ni ni-call"></em>
							Contact Information

						</h5>

					</div>

				</div>

				<div class="row gy-4 mb-5">

					<div class="col-md-6">

						<label class="form-label text-muted">
							Personal Email
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.PersonalEmail)
														? "-"
														: Model.PersonalEmail)

						</div>

					</div>

					<div class="col-md-6">

						<label class="form-label text-muted">
							Mobile Number
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.MobileNo)
														? "-"
														: Model.MobileNo)

						</div>

					</div>

					<div class="col-md-6">

						<label class="form-label text-muted">
							Alternate Mobile
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.AlternateMobile)
														? "-"
														: Model.AlternateMobile)

						</div>

					</div>

				</div>


				<!-- ================= Address ================= -->

				<div class="col-12 mb-4">

					<div style="border-left:4px solid #D9622F;
                padding:5px 0 5px 12px;">

						<h5 class="mb-0 d-flex align-items-center gap-2"
							style="color:#1B2A4A;">

							<em class="ni ni-map-pin"></em>
							Address

						</h5>

					</div>

				</div>

				<div class="row gy-4 mb-5">

					<div class="col-md-6">

						<label class="form-label text-muted">
							Current Address
						</label>

						<div class="border rounded p-3"
							 style="min-height:100px;
                    border-color:#e5e9f2 !important;
                    border-left:3px solid #D9622F !important;">

							@(string.IsNullOrEmpty(Model.CurrentAddress)
														? "-"
														: Model.CurrentAddress)

						</div>

					</div>

					<div class="col-md-6">

						<label class="form-label text-muted">
							Permanent Address
						</label>

						<div class="border rounded p-3"
							 style="min-height:100px;
                    border-color:#e5e9f2 !important;
                    border-left:3px solid #D9622F !important;">

							@(string.IsNullOrEmpty(Model.PermanentAddress)
														? "-"
														: Model.PermanentAddress)

						</div>

					</div>

				</div>


				<!-- ================= Identity Details ================= -->

				<div class="col-12 mb-4">

					<div style="border-left:4px solid #D9622F;
                padding:5px 0 5px 12px;">

						<h5 class="mb-0 d-flex align-items-center gap-2"
							style="color:#1B2A4A;">

							<em class="ni ni-shield-check"></em>
							Identity Details

						</h5>

					</div>

				</div>

				<div class="row gy-4 mb-5">

					<div class="col-md-4">

						<label class="form-label text-muted">
							Aadhaar Number
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.AadhaarNo)
														? "-"
														: Model.AadhaarNo)

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							PAN Number
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.PANNo)
														? "-"
														: Model.PANNo)

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Passport Number
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.PassportNo)
														? "-"
														: Model.PassportNo)

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							UAN Number
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.UANNo)
														? "-"
														: Model.UANNo)

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							PF Number
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.PFNo)
														? "-"
														: Model.PFNo)

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							ESIC Number
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(string.IsNullOrEmpty(Model.ESICNo)
														? "-"
														: Model.ESICNo)

						</div>

					</div>

				</div>


				<!-- ================= Official Information ================= -->

				<div class="col-12 mb-4">

					<div style="border-left:4px solid #D9622F;
                padding:5px 0 5px 12px;">

						<h5 class="mb-0 d-flex align-items-center gap-2"
							style="color:#1B2A4A;">

							<em class="ni ni-briefcase"></em>
							Official Information

						</h5>

					</div>

				</div>

				<div class="row gy-4 mb-5">

					<div class="col-md-4">

						<label class="form-label text-muted">
							Employee Code
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@Model.EmployeeCode

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Department
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@Model.Department.DepartmentName

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Designation
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@Model.Designation.DesignationName

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Date of Joining
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@(Model.JoiningDate.ToString("dd MMM yyyy") ?? "-")

						</div>

					</div>

					<div class="col-md-4">

						<label class="form-label text-muted">
							Employment Status
						</label>

						<div class="form-control-plaintext"
							 style="border-bottom:1px solid #e5e9f2;
                    padding-bottom:8px;">

							@Model.EmploymentStatus

						</div>

					</div>

				</div>

			</div>
		</div>
	</div>

</div>


<style>

	/* =========================================================
				   PROFILE FIELD
				   ========================================================= */

	.profile-value {
		min-height: 44px;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 13px;
		background: #f8f9fc;
		border: 1px solid #e5e9f2;
		border-radius: 5px;
		color: #364a63;
		font-size: 14px;
		line-height: 1.5;
		word-break: break-word;
		transition: all .2s ease;
	}


		.profile-value:hover {
			background: #f5f7fb;
			border-color: #d7deea;
		}


		/* =========================================================
				   FIELD ICON
				   ========================================================= */

		.profile-value > em {
			flex-shrink: 0;
			color: #8094ae;
			font-size: 16px;
		}


	/* =========================================================
				   FIELD LABEL
				   ========================================================= */

	.profile-label {
		font-size: 12px;
		font-weight: 600;
		margin-bottom: 6px;
		color: #8094ae;
		text-transform: uppercase;
		letter-spacing: .03em;
	}


	/* =========================================================
				   SECTION DESCRIPTION
				   ========================================================= */

	.text-soft {
		color: #8094ae;
	}


	/* =========================================================
				   EMPLOYMENT STATUS
				   ========================================================= */

	.status-wrapper {
		display: inline-flex;
		align-items: center;
		gap: 9px;
	}


	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		display: inline-block;
	}


	.status-active {
		background-color: #20c997;
	}


	.status-active-text {
		color: #00a878;
		font-weight: 600;
	}


	.status-inactive {
		background-color: #e85347;
	}


	.status-inactive-text {
		color: #e85347;
		font-weight: 600;
	}

	/* =========================================================
			   PROFILE SECTION
			   ========================================================= */

	.profile-section {
		margin-top: 24px;
		margin-bottom: 4px;
		padding-top: 4px;
	}


		/* First section should not have extra top spacing */

		.profile-section:first-child {
			margin-top: 10;
		}


	/* =========================================================
			   SECTION HEADER
			   ========================================================= */

	.profile-section-header {
		display: flex;
		align-items: center;
		gap: 12px;
		width: 100%;
		padding: 0 0 10px 0;
		border-bottom: 1px solid #e5e9f2;
	}


	/* =========================================================
			   SECTION ICON
			   ========================================================= */

	.profile-section-icon {
		width: 38px;
		height: 38px;
		min-width: 38px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
	}


		.profile-section-icon em {
			font-size: 18px;
		}


	/* Personal */

	.personal-icon {
		background: #eef4ff;
		color: #1b4d89;
	}


	/* Employment */

	.employment-icon {
		background: #fff4ec;
		color: #d9622f;
	}


	/* Contact */

	.contact-icon {
		background: #eef9f4;
		color: #198754;
	}


	/* =========================================================
			   SECTION CONTENT
			   ========================================================= */

	.profile-section-content {
		min-width: 0;
		flex: 1;
	}


	/* =========================================================
			   SECTION TITLE
			   ========================================================= */

	.profile-section-title {
		margin: 0;
		color: #1b2a4a;
		font-size: 18px;
		font-weight: 600;
		line-height: 1.3;
		white-space: normal;
	}


	/* =========================================================
			   SECTION SUBTITLE
			   ========================================================= */

	.profile-section-subtitle {
		display: block;
		margin-top: 2px;
		color: #8094ae;
		font-size: 12px;
		line-height: 1.4;
	}


	/* =========================================================
			   PROFILE FIELDS
			   ========================================================= */

	.profile-value {
		min-height: 44px;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 13px;
		background: #f8f9fc;
		border: 1px solid #e5e9f2;
		border-radius: 5px;
		color: #364a63;
		font-size: 14px;
		line-height: 1.5;
		word-break: break-word;
	}


		.profile-value > em {
			flex-shrink: 0;
			color: #8094ae;
			font-size: 16px;
		}


	/* =========================================================
			   FIELD LABEL
			   ========================================================= */

	.profile-label {
		font-size: 12px;
		font-weight: 600;
		margin-bottom: 6px;
		color: #8094ae;
		text-transform: uppercase;
		letter-spacing: .03em;
	}


	/* =========================================================
			   STATUS
			   ========================================================= */

	.status-wrapper {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}


	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		display: inline-block;
	}


	.status-active {
		background: #20c997;
	}


	.status-active-text {
		color: #00a878;
		font-weight: 600;
	}


	.status-inactive {
		background: #e85347;
	}


	.status-inactive-text {
		color: #e85347;
		font-weight: 600;
	}


	/* =========================================================
			   MOBILE
			   ========================================================= */

	@@media (max-width: 767px) {
		.profile-section {
			margin-top: 20px;
		}

		.profile-section-title {
			font-size: 16px;
		}

		.profile-section-icon {
			width: 34px;
			height: 34px;
			min-width: 34px;
		}
	}

	/* =========================================================
				   MOBILE
				   ========================================================= */

	@@media (max-width: 767px) {
		.profile-value {
			min-height: 42px;
		}
	}
</style>

