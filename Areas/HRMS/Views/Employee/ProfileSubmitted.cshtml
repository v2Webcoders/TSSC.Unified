@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "_Layout";
}

<div class="nk-block nk-block-lg">
	<div class="card card-preview">
		<div class="card">
			<div class="card-inner text-center py-5">

				<em class="icon ni ni-check-circle"
					style="font-size:60px;"></em>

				<h3 class="mt-3">
					Profile Submitted Successfully
				</h3>

				<p class="text-soft">
					Your employee profile has been submitted successfully
					and is currently waiting for HR verification.
				</p>

				<div class="alert alert-info d-inline-block mt-3">
					<strong>Status:</strong> Submitted
				</div>

				<div class="mt-4">
					<a asp-controller="Employee"
					   asp-action="MyProfile"
					   class="btn btn-outline-danger">
						<em class="icon ni ni-eye"></em>
						View My Profile
					</a>

					<a asp-controller="Home"
					   asp-action="Index"
					   class="btn btn-primary">
						Go to Dashboard
					</a>
				</div>

			</div>
		</div>
	</div>
</div>
