@model IEnumerable<TSSC.Unified.Models.HRPolicy>

@{
    Layout = "_Layout";
    int serial = 1;
    var activePolicies = Model.Where(x => x.IsActive).ToList();
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-head-content">
        <h3 class="nk-block-title page-title">
            Company Policies
        </h3>
    </div>
</div>


<div class="nk-block nk-block-lg">

    <div class="card card-bordered card-preview">

        <div class="card-inner">

            <table class="table table-bordered table-striped table_custom">

                <thead class="bg-light">
                    <tr>
                        <th width="70">#</th>
                        <th>Policy Name</th>
                        <th>Description</th>
                        <th width="150">Effective Date</th>
                        <th width="120">Action</th>
                    </tr>
                </thead>


                <tbody>

                    @foreach (var item in Model.Where(x => x.IsActive))
                    {
                        <tr>
                            <td>
                                @serial
                            </td>

                            <td>
                                <strong>
                                    @item.PolicyTitle
                                </strong>
                            </td>

                            <td>
                                @item.Description
                            </td>

                            <td>
                                @item.CreatedOn?.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.PolicyDocument))
                                {
                                    <a href="~/uploads/policies/@item.PolicyDocument"
                                       target="_blank"
                                       class="btn btn-sm btn-primary">

                                        <em class="icon ni ni-file-docs"></em>
                                        View

                                    </a>
                                }
                            </td>
                        </tr>

                        serial++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>