@model IEnumerable<Certificate>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Certificates";
}

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between">

        <div class="nk-block-head-content">

            <h3 class="nk-block-title page-title">
                Certificates
            </h3>

        </div>

    </div>

</div>


<div class="card card-bordered">

    <div class="card-inner">

        <table class="datatable-init-export table table-tranx table_custom table-bordered">

            <thead>
                <tr>
                    <th>#</th>
                  @*   <th>Id No</th> *@
                    <th>Company Name</th>
                   @*  <th>Description</th>
                    <th>Start Date</th>
                    <th>End Date</th> *@
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    int count = 1;

                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @count
                            </td>

                            <td>
                                @item.CompanyName
                            </td>
                            <td>

                                <div class="btn-group" role="group">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-info"
                                            title="Preview Template"
                                            onclick="showTemplatePreview(
                            '@Url.Content(
                                                                    "~/uploads/certificates/templates/" + item.TemplateFile
                                                                )'
                )">

                                                        <em class="icon ni ni-eye"></em>

                                                    </button>


                                                    <a href="/HRMS/Certificate/BulkGenerate?id=@item.Id"
                                                       class="btn btn-sm btn-primary"
                                                       title="Generate Certificates">

                                                        <em class="icon ni ni-file-pdf"></em>

                                                        <span>Generate Certificates</span>

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>

                                        count++;
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center">

                            No certificates found.

                        </td>

                    </tr>
                }

                <div class="modal fade"
                     id="templatePreviewModal"
                     tabindex="-1"
                     aria-hidden="true">

                    <div class="modal-dialog modal-xl modal-dialog-centered">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5 class="modal-title">
                                    Certificate Preview
                                </h5>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal">
                                </button>

                            </div>

                            <div class="modal-body text-center">

                                <img id="templatePreviewImage"
                                     src=""
                                     class="img-fluid"
                                     style="max-width:100%; height:auto;"
                                     alt="Certificate Template">

                            </div>

                        </div>

                    </div>

                </div>

            </tbody>

        </table>

    </div>

</div>
<script>

    function showTemplatePreview(imageUrl) {

        document.getElementById(
            "templatePreviewImage"
        ).src = imageUrl;

        var modal =
            new bootstrap.Modal(
                document.getElementById(
                    "templatePreviewModal"
                )
            );

        modal.show();
    }

</script>