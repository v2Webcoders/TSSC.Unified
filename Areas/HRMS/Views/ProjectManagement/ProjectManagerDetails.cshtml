@using TSSC.Unified.Models
@model TSSC.Unified.Models.AdminProject

@{
    Layout = "_Layout";
    ViewData["Title"] = "Project Details";

    var milestones = ViewBag.ProjectMilestones as List<ProjectMilestone>;
    var projectTeams = ViewBag.ProjectTeams as List<ProjectTeam>;
    var projectBudgets = ViewBag.ProjectBudgets as List<ProjectDepartmentBudget>;
    var projectTasks = ViewBag.ProjectTasks as List<ProjectTask>;
    var milestoneUpdates = ViewBag.MilestoneUpdates as List<ProjectMilestoneUpdate>;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">Project Details</h3>
            <div class="nk-block-des text-soft">
                Manage project tasks and milestone progress.
            </div>
        </div>

        <div class="nk-block-head-content">
            <a asp-area="HRMS"
               asp-controller="ProjectManagement"
               asp-action="ProjectManagerIndex"
               class="btn btn-outline-light">
                <em class="icon ni ni-arrow-left"></em>
                Back
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-bordered">
    <div class="card-inner">

        <!-- PROJECT INFORMATION -->
        <h5 class="title mb-3">
            <em class="icon ni ni-briefcase text-primary"></em>
            Project Information
        </h5>

        <div class="row g-3">

            <div class="col-md-4">
                <label class="form-label">Project Name</label>
                <input class="form-control" value="@Model.ProjectName" readonly />
            </div>

            <div class="col-md-4">
                <label class="form-label">Department</label>
                <input class="form-control"
                       value="@(Model.Department ?? "-")" readonly />
            </div>

            <div class="col-md-4">
                <label class="form-label">Project Cost</label>
                <input class="form-control"
                       value="@(Model.ProjectCost?.ToString("N2") ?? "-")"
                       readonly />
            </div>

            <div class="col-md-12">
                <label class="form-label">Project Description</label>
                <textarea class="form-control" rows="3" readonly>@Model.ProjectDescription</textarea>
            </div>
        </div>

        <hr class="my-4" />

        <!-- PROJECT TIMELINE -->
        <h5 class="title mb-3">
            <em class="icon ni ni-calendar text-primary"></em>
            Project Timeline
        </h5>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Start Date</label>
                <input class="form-control"
                       value="@Model.StartDate.ToString("dd-MMM-yyyy")"
                       readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label">End Date</label>
                <input class="form-control"
                       value="@Model.EndDate.ToString("dd-MMM-yyyy")"
                       readonly />
            </div>
        </div>

        <hr class="my-4" />

        <!-- PROJECT ATTACHMENT -->
        <h5 class="title mb-3">
            <em class="icon ni ni-file-docs text-primary"></em>
            Project Attachment
        </h5>

        @if (!string.IsNullOrWhiteSpace(Model.Attachment))
        {
            <a href="@Url.Content(Model.Attachment)"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-sm btn-outline-primary">
                <em class="icon ni ni-eye"></em>
                View Attachment
            </a>
        }
        else
        {
            <p class="text-soft">No attachment uploaded.</p>
        }

        <hr class="my-4" />

        <!-- PROJECT TEAM -->
        <h5 class="title mb-3">
            <em class="icon ni ni-users text-primary"></em>
            Project Team
        </h5>

        @if (projectTeams != null && projectTeams.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Employee ID</th>
                            <th>Employee Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int teamSr = 1;
                        }

                        @foreach (var item in projectTeams)
                        {
                            <tr>
                                <td>@teamSr</td>
                                <td>@item.EmployeeId</td>
                                <td>
                                    @($"{item.Employee?.FirstName} {item.Employee?.LastName}")
                                </td>
                            </tr>
                            teamSr++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-soft">No employees assigned to this project.</p>
        }

        <hr class="my-4" />

        <!-- DEPARTMENT BUDGET -->
        <h5 class="title mb-3">
            <em class="icon ni ni-wallet text-primary"></em>
            Department Budget Allocation
        </h5>

        @if (projectBudgets != null && projectBudgets.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Department</th>
                            <th>Budget Amount</th>
                            <th>Allocation Purpose</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int budgetSr = 1;
                        }

                        @foreach (var item in projectBudgets)
                        {
                            <tr>
                                <td>@budgetSr</td>
                                <td>@item.Department</td>
                                <td>@item.BudgetAmount.ToString("N2")</td>
                                <td>@(item.AllocationPurpose ?? "-")</td>
                                <td>@(item.Remarks ?? "-")</td>
                            </tr>
                            budgetSr++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-soft">No budget allocation found.</p>
        }

        <hr class="my-4" />

        <!-- TASK ASSIGNMENT -->
        <h5 class="title mb-3">
            <em class="icon ni ni-task text-primary"></em>
            Task Assignment
        </h5>

        @if (milestones != null && milestones.Any())
        {
            foreach (var milestone in milestones)
            {
                var milestoneTasks = projectTasks?
                .Where(x => x.MilestoneId == milestone.MilestoneId)
                .ToList() ?? new List<ProjectTask>();

                <div class="mb-4">

                    <h6 class="title mb-3">
                        @milestone.MilestoneName
                    </h6>

                    @if (milestoneTasks.Any())
                    {
                        <!-- SHOW ASSIGNED TASK DETAILS ONLY -->
                        <div class="card card-bordered">
                            <div class="card-inner">

                                <h6 class="title mb-3">
                                    Assigned Task Details
                                </h6>

                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>S.No.</th>
                                                <th>Task Name</th>
                                                <th>Assigned Employee</th>
                                                <th>Start Date</th>
                                                <th>Due Date</th>
                                                <th>Status</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int milestoneTaskSr = 1;
                                            }

                                            @foreach (var task in milestoneTasks)
                                            {
                                                <tr>
                                                    <td>@milestoneTaskSr</td>
                                                    <td>@task.TaskName</td>
                                                    <td>
                                                        @(task.Employee == null
                                                                                                ? "-"
                                                                                                : $"{task.Employee.FirstName} {task.Employee.LastName}")
                                                                                                                                                    </td>
                                                                                                                                                    <td>
                                                                                                                                                        @task.StartDate.ToString("dd-MMM-yyyy")
                                                                                                                                                    </td>
                                                                                                                                                    <td>
                                                                                                                                                        @task.DueDate.ToString("dd-MMM-yyyy")
                                                                                                                                                    </td>
                                                                                                                                                    <td>@task.Status</td>
                                                                                                                                                    <td>
                                                        @(string.IsNullOrWhiteSpace(task.TaskDescription)
                                                                                                ? "-" : task.TaskDescription)
                                    </td>
                                </tr>

                                                                                milestoneTaskSr++;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else if (projectTeams != null && projectTeams.Any())
                    {
                        <!-- SHOW ASSIGN FORM ONLY WHEN NO TASK EXISTS -->
                        <form action="@Url.Action(
                                                                "AssignProjectTask",
                                                                "ProjectManagement",
                                                                new { area = "HRMS" })"
                  method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ProjectId"
                                   value="@Model.ProjectId" />

                            <input type="hidden"
                                   name="MilestoneId"
                                   value="@milestone.MilestoneId" />

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label">
                                        Assign Employee <span class="text-danger">*</span>
                                    </label>

                                    <select name="EmployeeId"
                                            class="form-select"
                                            required>
                                        <option value="">Select Employee</option>

                            @foreach (var team in projectTeams)
                                        {
                                            if (team.Employee != null)
                                            {
                                                <option value="@team.EmployeeId">
                                                    @team.Employee.FirstName
                                                    @team.Employee.LastName
                                                    (@team.EmployeeId)
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        Task Name <span class="text-danger">*</span>
                                    </label>

                                    <input type="text"
                                           name="TaskName"
                                           class="form-control"
                                           maxlength="200"
                                           required />
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label">Task Description</label>

                                    <textarea name="TaskDescription"
                                  class="form-control"
                                  rows="2"
                                  maxlength="10000"></textarea>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        Start Date <span class="text-danger">*</span>
                                    </label>

                                    <input type="date"
                                           name="StartDate"
                                           class="form-control"
                                           min="@milestone.StartDate.ToString("yyyy-MM-dd")"
                                           max="@milestone.EndDate.ToString("yyyy-MM-dd")"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        Due Date <span class="text-danger">*</span>
                                    </label>

                                    <input type="date"
                                           name="DueDate"
                                           class="form-control"
                                           min="@milestone.StartDate.ToString("yyyy-MM-dd")"
                                           max="@milestone.EndDate.ToString("yyyy-MM-dd")"
                                           required />
                                </div>

                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-primary">
                                        <em class="icon ni ni-plus"></em>
                                        Assign Task
                                    </button>
                                </div>

                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            No employees assigned to this project by the Business Head.
                        </div>
                    }

                </div>

                @if (milestone != milestones.Last())
                {
                    <hr class="my-3" />
                }
            }
        }
        else
        {
            <div class="alert alert-warning">
                No milestones available for this project.
            </div>
        }

        <hr class="my-4" />

        <!-- MILESTONE PROGRESS UPDATE -->
        <!-- MILESTONE PROGRESS UPDATE -->
        <h5 class="title mb-3">
            <em class="icon ni ni-update text-primary"></em>
            Update Milestone Progress
        </h5>

        @if (milestones != null && milestones.Any())
        {
            foreach (var milestone in milestones)
            {
                var existingUpdates = milestoneUpdates?
                .Where(x => x.MilestoneId == milestone.MilestoneId)
                .OrderByDescending(x => x.UpdateDate)
                .ThenByDescending(x => x.CreatedDate)
                .ToList() ?? new List<ProjectMilestoneUpdate>();

                <div class="mb-4">

                    <h6 class="title mb-3">
                        @milestone.MilestoneName
                    </h6>

                    @if (existingUpdates.Any())
                    {
                        <!-- SHOW SAVED MILESTONE DETAILS -->
                        <div class="card card-bordered">
                            <div class="card-inner">

                                <h6 class="title mb-3">
                                    <em class="icon ni ni-check-circle text-success"></em>
                                    Milestone Update Details
                                </h6>

                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>S.No.</th>
                                                <th>Update Date</th>
                                                <th>Status</th>
                                                <th>Progress</th>
                                                <th>Remarks</th>
                                                <th>Document</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int updateSr = 1;
                                            }

                                            @foreach (var update in existingUpdates)
                                            {
                                                <tr>
                                                    <td>@updateSr</td>
                                                    <td>
                                                        @update.UpdateDate.ToString("dd-MMM-yyyy")
                                                    </td>
                                                    <td>@update.CurrentStatus</td>
                                                    <td>
                                                        @update.ProgressPercentage.ToString("N2")%
                                                    </td>
                                                    <td>@(update.Remarks ?? "-")</td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(update.SupportingDocument))
                                                        {
                                                            <a href="@Url.Content(update.SupportingDocument)"
                                                               target="_blank"
                                                               rel="noopener noreferrer"
                                                               class="btn btn-sm btn-outline-primary">
                                                                <em class="icon ni ni-eye"></em>
                                                                View
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span>-</span>
                                                        }
                                                    </td>
                                                </tr>

                                                updateSr++;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- SHOW FORM ONLY IF UPDATE DOES NOT EXIST -->
                        <form action="@Url.Action(
                                                  "SaveMilestoneUpdate",
                                                  "ProjectManagement",
                                                  new { area = "HRMS" })"
                  method="post"
                  enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ProjectId"
                                   value="@Model.ProjectId" />

                            <input type="hidden"
                                   name="MilestoneId"
                                   value="@milestone.MilestoneId" />

                            <div class="row g-3">

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Update Date <span class="text-danger">*</span>
                                    </label>

                                    <input type="date"
                                           name="UpdateDate"
                                           class="form-control"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           required />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Current Status <span class="text-danger">*</span>
                                    </label>

                                    <select name="CurrentStatus"
                                            class="form-select"
                                            required>
                                        <option value="Not Started">Not Started</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                        <option value="On Hold">On Hold</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Progress (%) <span class="text-danger">*</span>
                                    </label>

                                    <input type="number"
                                           name="ProgressPercentage"
                                           class="form-control"
                                           min="0"
                                           max="100"
                                           step="0.01"
                                           value="0"
                                           required />
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label">Supporting Document</label>

                                    <input type="file"
                                           name="SupportingFile"
                                           class="form-control"
                                           accept=".pdf,.doc,.docx" />

                                    <small class="text-soft">
                                        PDF, DOC or DOCX. Maximum 5 MB.
                                    </small>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label">Remarks</label>

                                    <textarea name="Remarks"
                                  class="form-control"
                                  rows="2"
                                  maxlength="4000"></textarea>
                                </div>

                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-primary">
                                        <em class="icon ni ni-save"></em>
                                        Save Update
                                    </button>
                                </div>

                            </div>
                        </form>
                        }

                </div>

                @if (milestone != milestones.Last())
                {
                    <hr class="my-3" />
                }
            }
        }
        else
        {
            <p class="text-soft">
                No milestones available for progress update.
            </p>
        }

    </div>
</div>
