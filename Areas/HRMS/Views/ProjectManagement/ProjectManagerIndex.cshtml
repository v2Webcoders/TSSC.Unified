@model IEnumerable<TSSC.Unified.Models.AdminProject>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Projects";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                My Projects
            </h3>
            <div class="nk-block-des text-soft">
                View and manage your assigned projects
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-bordered">
    <div class="card-inner">

        <div class="nk-block-head-content mb-3">
            <h5 class="title">Assigned Project List</h5>
        </div>

        <div class="table-responsive">

            <table class="datatable-init-export table table-tranx table_custom table-bordered dataTable no-footer dtr-inline collapsed">

                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Project Name</th>
                        <th>Department</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Project Cost</th>
                        <th>Project Status</th>
                        <th>Business Head Status</th>
                        <th>CEO Status</th>
                        <th>Attachment</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@serial</td>

                                <td>
                                    @item.ProjectName
                                </td>

                                <td>
                                    @(item.Department ?? "-")
                                </td>

                                <td>
                                    @item.StartDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @item.EndDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @(item.ProjectCost?.ToString("N2") ?? "-")
                                </td>

                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                        @(item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <td>
                                    @(item.BusinessHeadStatus ?? "Pending")
                                </td>

                                <td>
                                    @(item.CEOStatus ?? "Not Submitted")
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.Attachment))
                                    {
                                        <a href="@Url.Content(item.Attachment)"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="btn btn-sm btn-outline-primary">
                                            <em class="icon ni ni-file-pdf"></em>
                                            View
                                        </a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td>
                                    <a asp-area="HRMS"
                                       asp-controller="ProjectManagement"
                                       asp-action="ProjectManagerDetails"
                                       asp-route-id="@item.ProjectId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="View Project">
                                        <em class="icon ni ni-eye"></em>
                                    </a>
                                </td>
                            </tr>

                            serial++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center">
                                No projects assigned to you.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
