@using TSSC.Unified.Models
@model IEnumerable<Department>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Departments";
}

<div class="nk-block-head">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Departments
            </h3>
        </div>

        <div class="nk-block-head-content">

            <a asp-action="Create"
               asp-controller="Department"
               asp-area="HRMS"
               class="btn btn-primary">

                <em class="icon ni ni-plus"></em>
                <span>Add Department</span>

            </a>

        </div>

    </div>
</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-icon">
        <em class="icon ni ni-check-circle"></em>
        @TempData["SuccessMessage"]
    </div>
}


<div class="card card-bordered">

    <div class="card-inner">

        <div class="table-responsive">

            <table class="datatable-init-export table table-tranx table_custom table-bordered dataTable no-footer dtr-inline collapsed">

                <thead>
                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Department Name
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-end">
                            Action
                        </th>

                    </tr>
                </thead>


                <tbody>

                    @{
                        var count = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @count
                            </td>

                            <td>
                                <strong>
                                    @item.DepartmentName
                                </strong>
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <td class="text-end">

                                <a asp-action="Create"
                                   asp-controller="Department"
                                   asp-area="HRMS"
                                   asp-route-id="@item.DepartmentId"
                                   class="btn btn-sm btn-primary">

                                    <em class="icon ni ni-edit"></em>
                                    Edit

                                </a>
                                @if (item.IsActive)
                                {
                                    <form asp-action="Delete"
                                          asp-controller="Department"
                                          asp-area="HRMS"
                                          asp-route-id="@item.DepartmentId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to deactivate this department?');">

                                            <em class="icon ni ni-cross-circle"></em>
                                            Deactivate

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate"
                                          asp-controller="Department"
                                          asp-area="HRMS"
                                          asp-route-id="@item.DepartmentId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">

                                            <em class="icon ni ni-check-circle"></em>
                                            Activate

                                        </button>

                                    </form>
                                }

                            </td>

                        </tr>

                        count++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>