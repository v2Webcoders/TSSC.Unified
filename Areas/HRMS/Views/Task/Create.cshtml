@model TSSC.Unified.ViewModel.TaskVM

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
}

@if (!ViewData.ModelState.IsValid)
{
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
}

@if (TempData["msg"] != null)
{
    <div class="example-alert w-100">
        <div class="alert alert-success alert-icon">
            <em class="icon ni ni-check-circle"></em>
            <strong>@TempData["msg"]</strong>
        </div>
    </div>
}
<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">@(Model.TaskId > 0 ? "Edit Task" : "Add Task")</h3>
            <div class="nk-block-des text-soft">
            </div>
        </div>
        <div class="nk-block-head-content">
            <a asp-action="TaskList"
               asp-controller="Task"
               class="btn btn-primary d-none d-md-inline-flex">
                <em class="icon ni ni-list"></em>&nbsp; Task List
            </a>
        </div>
    </div>
</div>

<div class="card card-bordered">

    <div class="card-inner">

        <div class="preview-block">

            <div class="row gy-4">

                <div class="col-sm-12">

                    <form asp-action="Create"
                          asp-controller="Task"
                          method="post"
                          enctype="multipart/form-data">

                        <input type="hidden" asp-for="TaskId" />


                        <div class="row gy-3">


                            <!-- ================= Task Information ================= -->

                            <div class="col-12 mb-4">
                                <div style="border-left:4px solid #D9622F;padding:5px 0 5px 12px;">

                                    <h5 class="mb-0 d-flex align-items-center gap-2"
                                        style="color:#1B2A4A;">

                                        <em class="ni ni-clipboard"></em>
                                        Task Information

                                    </h5>

                                </div>
                            </div>



                            <div class="col-md-6">

                                <label class="form-label">
                                    Task Name <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TaskName"
                                       class="form-control" />

                                <span asp-validation-for="TaskName"
                                      class="text-danger"></span>

                            </div>



                            <div class="col-md-6">

                                <label class="form-label">
                                    Assign To <span class="text-danger">*</span>
                                </label>


                                <select asp-for="AssignedTo"
                                        asp-items="ViewBag.EmployeeList"
                                        class="form-select">

                                    <option value="">
                                        Select Employee
                                    </option>

                                </select>


                                <span asp-validation-for="AssignedTo"
                                      class="text-danger"></span>

                            </div>




                            <div class="col-md-12">

                                <label class="form-label">
                                    Task Description
                                </label>


                                <textarea asp-for="TaskDescription"
                                          class="form-control"
                                          rows="4"></textarea>


                            </div>




                            <div class="col-md-6">

                                <label class="form-label">
                                    Deadline <span class="text-danger">*</span>
                                </label>


                                <input asp-for="Deadline"
                                       type="date"
                                       class="form-control" />


                                <span asp-validation-for="Deadline"
                                      class="text-danger"></span>


                            </div>




                            <div class="col-md-6">

                                <label class="form-label">
                                    Attachment
                                </label>


                                <input asp-for="AttachmentFile"
                                       type="file"
                                       class="form-control" />


                            </div>





                            <div class="col-md-12">

                                <label class="form-label">
                                    Remarks
                                </label>


                                <textarea asp-for="Remarks"
                                          class="form-control"
                                          rows="3"></textarea>


                            </div>




                            <!-- ================= Status ================= -->

                           @*  <div class="col-md-6">

                                <label class="form-label">
                                    Status
                                </label>


                                <select asp-for="Status"
                                        class="form-select">

                                    <option value="Pending">
                                        Pending
                                    </option>

                                    <option value="In Progress">
                                        In Progress
                                    </option>

                                    <option value="Completed">
                                        Completed
                                    </option>


                                </select>


                            </div> *@





                            <!-- ================= Buttons ================= -->


                            <div class="col-12 mt-4">


                                <button type="submit"
                                        class="btn btn-primary">


                                    @if (Model.TaskId > 0)
                                    {
                                        <em class="icon ni ni-edit"></em>
                                        <span> Update Task</span>
                                    }
                                    else
                                    {
                                        <em class="icon ni ni-plus"></em>
                                        <span> Assign Task</span>
                                    }


                                </button>



                                <a asp-action="TaskList"
                                   asp-controller="Task"
                                   class="btn btn-outline-secondary ms-2">

                                    Cancel

                                </a>


                            </div>


                        </div>


                    </form>


                </div>


            </div>


        </div>


    </div>


</div>