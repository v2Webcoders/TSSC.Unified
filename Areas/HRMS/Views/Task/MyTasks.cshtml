@model IEnumerable<TSSC.Unified.ViewModel.TaskVM>

    @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

    @{
    Layout = "_Layout";
    ViewData["Title"] = "My Tasks";
    int serial = 1;
    }


  <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">My Task List</h3>
            </div>
        </div>
    </div> 
    <div class="nk-content-inner">

        <div class="nk-content-body">


            <div class="card card-bordered">

                <div class="card-inner">
                    <table class="datatable-init-export table table-tranx table_custom table-bordered dataTable no-footer dtr-inline collapsed">


                        <thead>

                            <tr>

                                <th>S.No.</th>

                                <th>Task Name</th>

                                <th>Description</th>

                                <th>Assigned By</th>

                                <th>Deadline</th>

                                <th>Status</th>

                                <th>Attachment</th>

                                <th width="120">Action</th>

                            </tr>


                        </thead>



                        <tbody>


                            @foreach (var item in Model)
                            {

                            <tr>


                                <td>
                                    @serial
                                </td>



                                <td>
                                    @item.TaskName
                                </td>



                                <td>
                                    @item.TaskDescription
                                </td>



                                <td>
                                    @item.AssignedByName
                                </td>



                                <td>
                                    @item.Deadline.ToString("dd-MMM-yyyy")
                                </td>



                                <td>

                                    @if (item.Status == "Completed")
                                    {
                                    <span class="badge badge-dot bg-success">
                                        Completed
                                    </span>
                                    }
                                    else if (item.Status == "In Progress")
                                    {
                                    <span class="badge badge-dot bg-info">
                                        In Progress
                                    </span>
                                    }
                                    else
                                    {
                                    <span class="badge badge-dot bg-warning">
                                        Pending
                                    </span>
                                    }

                                </td>




                                <td>

                                    @if (!string.IsNullOrEmpty(item.Attachment))
                                    {
                                    <a href="~/Uploads/Tasks/@item.Attachment"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-info">

                                        <em class="icon ni ni-file-text"></em>
                                        View File

                                    </a>
                                    }
                                    else
                                    {
                                    <span>-</span>
                                    }


                                </td>




                                <td>


                                    <div class="btn-group" role="group">


                                        <a asp-area="HRMS"
                                           asp-controller="Task"
                                           asp-action="Details"
                                           asp-route-id="@item.TaskId"
                                           class="btn btn-sm btn-outline-info"
                                           title="View">

                                            <em class="icon ni ni-eye"></em>

                                        </a>


                                    </div>


                                </td>



                            </tr>


                            serial++;

                            }


                        </tbody>



                    </table>


                </div>


            </div>


        </div>


    </div>
