@{
    Layout = "~/Views/Shared/_RegistrationLayout.cshtml";
    ViewData["Title"] = "Registration Submitted";
}

<div class="form-shell" style="padding:56px 24px;">
    <div style="max-width:700px; margin:0 auto; text-align:center;">
        <div style="
            width:72px;
            height:72px;
            margin:0 auto 22px;
            display:flex;
            align-items:center;
            justify-content:center;
            border-radius:50%;
            background:#eaf8ef;
            color:#18864b;
            font-size:36px;
            font-weight:700;">
            ✓
        </div>

        <h2 style="margin:0 0 14px; color:#102b5c;">
            TP Registration Submitted Successfully
        </h2>

        <p style="max-width:580px; margin:0 auto 28px; color:#526070; line-height:1.7;">
            Dear Applicant, your Affiliation Registration has been successfully submitted.
            Your login credentials have been sent to your registered email address.
            For any assistance, please contact us at <strong>it@tsscindia.com</strong>.
            <br />
            <strong>– TSSC</strong>
        </p>
        <div style="
            padding:18px 22px;
            margin:0 auto 30px;
            max-width:560px;
            text-align:left;
            border:1px solid #dce7f3;
            border-radius:10px;
            background:#f8fbff;">
            <strong style="display:block; margin-bottom:7px; color:#102b5c;">
                What happens next?
            </strong>
            <span style="color:#526070;">
                The TSSC team will verify your details and documents. You will receive
                updates through your registered email address.
            </span>
        </div>

        <a href="/"
           class="btn-primary"
           style="display:inline-block; width:auto; padding:13px 28px; text-decoration:none;">
            Go to Home
        </a>
    </div>
</div>