		function checkFiles() {
			let ok = true;
			tpForm.querySelectorAll('input[type=file]').forEach(inp => {
				const span = tpForm.querySelector(`[data-valmsg-for="${inp.name}"]`);
				const f = inp.files[0];
				const bad = f && f.name.toLowerCase().endsWith('.pdf') && f.size > MAX_PDF;
				if (span) span.textContent = bad ? 'PDF must not exceed 2 MB.' : '';
				if (bad) ok = false;
			});
			return ok;
		}

		function showErrors(errors) {
			tpForm.querySelectorAll('[data-valmsg-for]').forEach(s => s.textContent = '');
			let list = tpForm.querySelector('[data-valmsg-summary] ul');
			if (list) list.innerHTML = '';

			let first = null;
			for (const [key, msgs] of Object.entries(errors)) {
				const span = key && tpForm.querySelector(`[data-valmsg-for="${key}"]`);
				if (span) { span.textContent = msgs.join(' '); first ??= span; }
				else if (list) {
					msgs.forEach(m => {
						const li = document.createElement('li');
						li.textContent = m;
						list.appendChild(li);
					});
					first ??= list;
				}
			}
			first?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		}
	});
