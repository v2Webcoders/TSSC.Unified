<script>
	document.addEventListener('DOMContentLoaded', () => {

		function toggleGSTNumber() {
				const selected = document.querySelector(
					'input[name="IsGSTAvailable"]:checked'
				);

				const gstNumberField = document.getElementById("gstNumberField");
				const gstNumber = document.getElementById("GSTNumber");

				if (!gstNumberField) {
					return;
				}

				if (selected && selected.value === "true") {
					gstNumberField.style.display = "";
				} else {
					gstNumberField.style.display = "none";

					if (gstNumber) {
						gstNumber.value = "";
					}
				}
			}

			document
				.querySelectorAll('input[name="IsGSTAvailable"]')
				.forEach(function (radio) {
					radio.addEventListener("change", toggleGSTNumber);
				});

			// Set correct state when page initially loads
			toggleGSTNumber();

		const tpForm = document.getElementById('tpForm');
		const MAX_PDF = 2 * 1024 * 1024;

		tpForm.addEventListener('submit', async e => {
			e.preventDefault();

		const btn = document.getElementById('submitBtn');
		const btnText = document.getElementById('submitBtnText');
		const spinner = document.getElementById('submitSpinner');

	if (btn.disabled) return;
			console.log('A. submit fired');

			// 1. client-side validation
			if (typeof $ === 'undefined' || typeof $.fn.valid !== 'function') {
				console.log('B. jquery-validate NOT loaded, skipping client validation');
			} else if (!$(tpForm).valid()) {
				console.log('B. client validation failed');
				const firstBad = tpForm.querySelector('.input-validation-error');
				firstBad?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				firstBad?.focus();
				return;
			}

			// 2. file size check
			if (!checkFiles()) { console.log('C. file check failed'); return; }

				// 3. Show processing state and send
	btn.disabled = true;
	//btnText.textContent = 'Submitting Registration...';
	spinner.style.display = 'inline-block';

	try {
		const res = await fetch(tpForm.action, {
			method: 'POST',
			body: new FormData(tpForm),
			headers: {
				'X-Requested-With': 'XMLHttpRequest'
			}
		});

		if (res.ok) {
			const data = await res.json();
			window.location.href = data.redirectUrl;
			return;
		} else if (res.status === 400) {
			const text = await res.text();

			try {
				showErrors(JSON.parse(text).errors);
			} catch {
				showErrors({
					'': ['Request was rejected. Please reload and try again.']
				});
			}
		} else {
			showErrors({
				'': ['Something went wrong. Please try again.']
			});
		}
	} catch (err) {
		console.error('Registration submission failed:', err);

		showErrors({
			'': ['Network error. Please check your connection and try again.']
		});
		} finally {
		btn.disabled = false;
		spinner.style.display = 'none';
	}

