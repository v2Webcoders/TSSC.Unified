                            <div class="mb-2">
                                <span class="badge bg-warning text-dark">
                                    Document Not Uploaded
                                </span>
                            </div>
                        }

                        <input asp-for="CancelledCheque"
                               type="file"
                               accept=".pdf,.jpg,.jpeg,.png" />

                        <small class="text-soft">
                            Leave blank to keep the existing document.
                        </small>

                        <span asp-validation-for="CancelledCheque"
                              class="text-danger"></span>

                    </div>


                    <!-- UNDERTAKING -->

                    <div class="field">

                        <label asp-for="UndertakingDocument">
                            Undertaking
                        </label>

                        @if (documents.Any(x =>
                        x.DocumentType == "Undertaking"))
                        {
                            <div class="mb-2">
                                <span class="badge bg-success">
                                    ✓ Document Uploaded
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-2">
                                <span class="badge bg-warning text-dark">
                                    Document Not Uploaded
                                </span>
                            </div>
                        }

                        <input asp-for="UndertakingDocument"
                               type="file"
                               accept=".pdf" />

                        <small class="text-soft">
                            Leave blank to keep the existing document.
                        </small>

                        <span asp-validation-for="UndertakingDocument"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>
        </div> *@


        <!-- ========================================================= -->
        <!-- STEP 6 : AUTHORIZED PERSON -->
        <!-- ========================================================= -->

        <div class="accordion open" data-step="6">

            <div class="acc-head" onclick="toggleAcc(this)">
                <div class="left">
                    <div class="step-num">6</div>
                    <div class="title">Authorized Person Details</div>
                </div>
            </div>

            <div class="acc-body">

                <div class="form-grid">

                    <div class="field">

                        <label asp-for="AuthorizedSignatoryName">
                            Name of Authorized Signatory
                            <span class="req">*</span>
                        </label>

                        <input asp-for="AuthorizedSignatoryName"
                               type="text" />

                        <span asp-validation-for="AuthorizedSignatoryName"
                              class="text-danger"></span>

                    </div>


                    <div class="field">

                        <label asp-for="Designation">
                            Designation
                            <span class="req">*</span>
                        </label>

                        <input asp-for="Designation"
                               type="text" />

                        <span asp-validation-for="Designation"
                              class="text-danger"></span>

                    </div>


                    <div class="field">

                        <label asp-for="AuthorizedPersonEmail">
                            Email ID
                            <span class="req">*</span>
                        </label>

                        <input asp-for="AuthorizedPersonEmail"
                               type="text" />

                        <span asp-validation-for="AuthorizedPersonEmail"
                              class="text-danger"></span>

                    </div>


                    <div class="field">

                        <label asp-for="AuthorizedPersonMobile">
                            Mobile Number
                            <span class="req">*</span>
                        </label>

                        <input asp-for="AuthorizedPersonMobile"
                               type="text"
                               maxlength="10"
                               inputmode="numeric" />

                        <span asp-validation-for="AuthorizedPersonMobile"
                              class="text-danger"></span>

                    </div>


                    <!-- AUTHORIZED PERSON ID -->

                    <div class="field full">

                        <label asp-for="AuthorizedPersonIdProof">
                            ID Proof (Aadhaar / PAN)
                        </label>

                        @{
                            var authorizedPersonIdDoc = documents
                            .FirstOrDefault(x =>
                            x.DocumentType == "Authorized Person ID Proof");
                        }

                        @if (authorizedPersonIdDoc != null)
                        {
                            <div class="mb-2 d-flex align-items-center gap-2">

                                <span class="badge bg-success">
                                    ✓ Document Uploaded
                                </span>

                                <a href="@Url.Content(
                $"~/uploads/tp-registrations/{Model.Id}/{authorizedPersonIdDoc.FileName}")"
                                   target="_blank"
                                   class="text-primary">
                                    View
                                </a>

                            </div>
                        }
                        else
                        {
                            <div class="mb-2">
                                <span class="badge bg-warning text-dark">
                                    Document Not Uploaded
                                </span>
                            </div>
                        }

                        <input asp-for="AuthorizedPersonIdProof"
                               type="file"
                               accept=".pdf,.jpg,.jpeg,.png" />

                        <small class="text-soft">
                            Leave blank to keep the existing document.
                            Upload only if you want to replace it.
                        </small>

                        <span asp-validation-for="AuthorizedPersonIdProof"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>
        </div>


        <!-- ========================================================= -->
        <!-- DECLARATION -->
        <!-- ========================================================= -->

        <div style="margin-top:24px;">

            <label class="check-row">

                <input asp-for="DeclarationAccepted"
                       type="checkbox" />

                I accept the Terms &amp; Conditions and declare that the
                information provided above is true and authentic to the
                best of my knowledge.

            </label>

            <span asp-validation-for="DeclarationAccepted"
                  class="text-danger"></span>

        </div>


        <!-- ========================================================= -->
        <!-- ACTIONS -->
        <!-- ========================================================= -->

        <div class="form-actions"
             style="justify-content: space-between;">

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-dim btn-outline-secondary"
               style="width:auto; flex:0 0 auto; padding:13px 28px;">

                Cancel

            </a>


            <button type="submit"
                    class="btn-primary"
                    style="width:auto; flex:0 0 auto; padding:13px 28px;">

                Resubmit Application

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
