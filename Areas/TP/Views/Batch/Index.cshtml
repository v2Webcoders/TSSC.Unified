@using TSSC.Unified.ViewModel
@model IEnumerable<BatchIndexVM>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">Batch List</h3>
        </div>

        <div class="nk-block-head-content">
            <div class="toggle-wrap nk-block-tools-toggle">

                <a href="#"
                   class="btn btn-icon btn-trigger toggle-expand me-n1"
                   data-target="pageMenu">
                    <em class="icon ni ni-more-v"></em>
                </a>

                <div class="toggle-expand-content" data-content="pageMenu">
                    <ul class="nk-block-tools g-3">
                        <li class="nk-block-tools-opt">
                            <a asp-action="Create"
                               class="btn btn-primary">
                                <em class="icon ni ni-plus"></em>
                                <span>Create Batch</span>
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </div>

    </div>
</div>

<div class="nk-block nk-block-lg">

    @if (TempData["BatchSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <em class="icon ni ni-check-circle"></em>
            @TempData["BatchSuccess"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["DeleteSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <em class="icon ni ni-check-circle"></em>
            @TempData["DeleteSuccess"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card card-preview">
        <div class="card-inner">

            <div class="table-responsive">

                <table class="datatable-init-export table table-tranx table_custom table-bordered"
                       data-auto-responsive="false">

                    <thead>
                        <tr>
                            <th width="60">S.No.</th>
                            <th>Batch ID</th>
                            <th>Screening Details</th>
                            <th>Scheme Name</th>
                            <th>Project Name</th>
                            <th>Training Center</th>
                            <th>Job Role</th>
                            <th>Trainer Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Total Candidates</th>
                            <th>Created On</th>
                            <th>Status</th>
                           
                            <th width="130">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@serial</td>

                                <td>
                                    <strong>@item.BatchId</strong>
                                </td>
                                @* Screening Details *@
                                <td style="min-width:150px;">
                                    @if (item.MonitoringStatus == "Scheduled"
                                   && item.MonitoringDateTime.HasValue)
                                    {
                                        <span class="badge bg-info">
                                            <em class="icon ni ni-calendar-check"></em>
                                            Scheduled
                                        </span>

                                        <div class="small mt-1">
                                            <em class="icon ni ni-calendar"></em>
                                            @item.MonitoringDateTime.Value.ToString("dd-MMM-yyyy")
                                        </div>

                                        <div class="small text-muted">
                                            <em class="icon ni ni-clock"></em>
                                            @item.MonitoringDateTime.Value.ToString("hh:mm tt")
                                        </div>
                                    }
                                    else if (item.MonitoringStatus == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            <em class="icon ni ni-check-circle"></em>
                                            Screening Completed
                                        </span>

                                        @if (item.MonitoringDateTime.HasValue)
                                        {
                                            <div class="small mt-1">
                                                @item.MonitoringDateTime.Value.ToString("dd-MMM-yyyy, hh:mm tt")
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">
                                            Not Scheduled
                                        </span>
                                    }
                                </td>

                                <td>@item.SchemeName</td>
                                <td>@item.ProjectName</td>
                                <td>@item.CenterName</td>
                                <td>@item.JobRoleName</td>
                                <td>@item.TrainerName</td>

                                <td>@item.StartDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.EndDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.CandidateCount</td>
                                <td>
                                    @item.CreatedOn.ToString("dd-MMM-yyyy")
                                </td>
                                <td style="min-width:150px;">
                                    @if (string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-dot bg-success">Active</span>
                                    }
                                    else if (string.Equals(item.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-dot bg-primary">Completed</span>
                                    }
                                    else if (string.Equals(item.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-dot bg-danger">Cancelled</span>
                                    }
                                    else if (string.Equals(item.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-dot bg-success">Approved</span>
                                    }
                                    else if (string.Equals(item.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-dot bg-danger">Rejected</span>
                                    }
                                    else if (string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-dot bg-warning">Pending Approval</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dot bg-warning">
                                            @(string.IsNullOrWhiteSpace(item.Status) ? "N/A" : item.Status)
                                        </span>
                                    }

                                   

                                    @if (string.Equals(item.Status, "Rejected", StringComparison.OrdinalIgnoreCase)
                                   && !string.IsNullOrWhiteSpace(item.ApprovalRemarks))
                                    {
                                        <br />
                                        <small class="text-danger">
                                            <em class="icon ni ni-alert-circle"></em>
                                            Remarks: @item.ApprovalRemarks
                                        </small>
                                    }

                                    @if (string.Equals(item.Status, "Rejected", StringComparison.OrdinalIgnoreCase)
                                   && item.ApprovedOn.HasValue)
                                    {
                                        <br />
                                        <small class="text-muted">
                                            @item.ApprovedOn.Value.ToString("dd-MMM-yyyy hh:mm tt")
                                        </small>
                                    }
                                </td>
                                
                               
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Batch">
                                            <em class="icon ni ni-eye"></em>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Edit Batch">
                                            <em class="icon ni ni-edit"></em>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            serial++;
                        }
                    </tbody>
                </table>

            </div>

        </div>
    </div>
</div>