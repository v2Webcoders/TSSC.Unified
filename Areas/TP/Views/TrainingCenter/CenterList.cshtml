
@model IEnumerable<TSSC.Unified.ViewModel.TrainingCenterViewModel>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}
<style>
    .approval-progress {
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        min-width: 190px;
        padding: 0 5px;
    }

    /* Line passes exactly through the center of circles */
    .approval-line {
        position: absolute;
        top: 14px;
        left: 18px;
        right: 18px;
        height: 2px;
        background: #d9dee7;
        z-index: 0;
    }

    .approval-step {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: transparent;
    }

    .approval-circle {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        background: #fff;
        border: 2px solid #d9dee7;
    }

        .approval-circle.approved {
            background: #e7f7ee;
            border-color: #28a745;
            color: #28a745;
        }

        .approval-circle.rejected {
            background: #fdeaea;
            border-color: #dc3545;
            color: #dc3545;
        }

        .approval-circle.pending {
            background: #fff8e1;
            border-color: #f0ad00;
            color: #f0ad00;
        }

    .approval-step small {
        margin-top: 5px;
        font-size: 10px;
        font-weight: 600;
        color: #8091a5;
    }
</style>
<!-- Page Heading: same as SelectJobRole -->
@* <div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Training Center List
            </h3>
        </div>

        <div class="nk-block-head-content">
            <a asp-area="TP"
               asp-controller="TrainingCenter"
               asp-action="SelectJobRole"
               class="btn btn-success">
                <em class="icon ni ni-plus"></em>
                Add Center
            </a>
        </div>
    </div>
</div> *@

<!-- Same card UI -->
<div class="card card-bordered">
    <div class="card-inner">

        <!-- Table Heading -->
        <div class="nk-block-head nk-block-head-sm">
            <div class="nk-block-between">
                <div class="nk-block-head-content">
                    <h5 class="nk-block-title">
                        Training Centers
                    </h5>
                </div>

                <div class="nk-block-head-content">
                    <span class="badge bg-primary">
                        Total: @(Model?.Count() ?? 0)
                    </span>
                </div>
            </div>
        </div>

        <!-- Same table classes as SelectJobRole -->
        <div class="table-responsive">
            <table class="datatable-init-export table table-tranx table_custom table-bordered">

                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Progress</th>
                        <th>Center Name</th>
                        <th>Job Role</th>
                        <th>Scheme</th>
                        <th>QP Hours</th>
                        @* <th>Approval</th> *@
                        <th>Payment</th>
                        <th>Schedule for Inspection</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@serial</td>

                                <td>
                                    <div class="approval-progress">
                                        <div class="approval-line"></div>

                                        <!-- 1. Finance -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.FinanceStatus == "Approved" ? "approved" : item.FinanceStatus == "Rejected" ? "rejected" : item.FinanceStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="Finance - @(item.FinanceStatus == "Approved" ? "Approved" : item.FinanceStatus == "Rejected" ? "Rejected" : item.FinanceStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.FinanceStatus == "Approved" ? "✓" : item.FinanceStatus == "Rejected" ? "✕" : item.FinanceStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>Finance</small>
                                        </div>

                                        <!-- 2. Regional Head -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.RegionalHeadStatus == "Approved" ? "approved" : item.RegionalHeadStatus == "Rejected" ? "rejected" : item.RegionalHeadStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="Regional Head - @(item.RegionalHeadStatus == "Approved" ? "Approved" : item.RegionalHeadStatus == "Rejected" ? "Rejected" : item.RegionalHeadStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.RegionalHeadStatus == "Approved" ? "✓" : item.RegionalHeadStatus == "Rejected" ? "✕" : item.RegionalHeadStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>RH</small>
                                        </div>

                                        <!-- 3. Vertical Head -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.VerticalHeadStatus == "Approved" ? "approved" : item.VerticalHeadStatus == "Rejected" ? "rejected" : item.VerticalHeadStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="Vertical Head - @(item.VerticalHeadStatus == "Approved" ? "Approved" : item.VerticalHeadStatus == "Rejected" ? "Rejected" : item.VerticalHeadStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.VerticalHeadStatus == "Approved" ? "✓" : item.VerticalHeadStatus == "Rejected" ? "✕" : item.VerticalHeadStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>VH</small>
                                        </div>

                                        <!-- 4. Business Head -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.BusinessHeadStatus == "Approved" ? "approved" : item.BusinessHeadStatus == "Rejected" ? "rejected" : item.BusinessHeadStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="Business Head - @(item.BusinessHeadStatus == "Approved" ? "Approved" : item.BusinessHeadStatus == "Rejected" ? "Rejected" : item.BusinessHeadStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.BusinessHeadStatus == "Approved" ? "✓" : item.BusinessHeadStatus == "Rejected" ? "✕" : item.BusinessHeadStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>BH</small>
                                        </div>

                                        <!-- 5. CEO -->
                                        <div class="approval-step">
                                            <div class="approval-circle @(item.CEOStatus == "Approved" ? "approved" : item.CEOStatus == "Rejected" ? "rejected" : item.CEOStatus == "On Hold" ? "onhold" : "pending")"
                                                 data-bs-toggle="tooltip"
                                                 data-bs-placement="top"
                                                 title="CEO - @(item.CEOStatus == "Approved" ? "Approved" : item.CEOStatus == "Rejected" ? "Rejected" : item.CEOStatus == "On Hold" ? "On Hold" : "Pending")">
                                                @(item.CEOStatus == "Approved" ? "✓" : item.CEOStatus == "Rejected" ? "✕" : item.CEOStatus == "On Hold" ? "!" : "•")
                                            </div>
                                            <small>CEO</small>
                                        </div>

                                    </div>
                                </td>


                                <td>@item.TrainingCenterName</td>

                                <td>
                                    @(item.JobRoleTitle ?? "-")
                                </td>

                                <td>
                                    @(item.SchemeName ?? "-")
                                </td>

                                <td>
                                    @(item.QPHours.HasValue
                                                                ? item.QPHours.Value.ToString("0.##") + " Hours"
                                                                : "-")
                        </td>

                              @*   <td>
                            @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">
                                            @(item.Status ?? "Pending")
                                        </span>
                                    }
                                </td> *@

                                <td>
                                    @if (item.FinanceStatus == "Approved")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (item.PaymentStatus == "Success")
                                    {
                                        <span class="badge bg-warning">Verification Pending</span>
                                    }
                                    else
                                    {
                                        <a asp-area="TP"
                                           asp-controller="TrainingCenter"
                                           asp-action="Payment"
                                           asp-route-id="@item.Id"
                                           class="btn btn-success btn-sm">
                                            <em class="icon ni ni-wallet"></em>
                                            Pay Now
                                        </a>
                                    }
                        </td>

                        <td>
                            @(item.InspectionDate.HasValue
                                                        ? item.InspectionDate.Value.ToString("dd-MM-yyyy hh:mm tt")
                                                        : "Not Scheduled")
                        </td>

                                <td>
                                    <a asp-area="TP"
                                       asp-controller="TrainingCenter"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-primary btn-sm">
                                        <em class="icon ni ni-eye"></em>
                                        View
                                    </a>
                            @if (item.RegionalHeadStatus == "Approved"
                                                        && item.VerticalHeadStatus == "Approved"
                                                        && item.BusinessHeadStatus == "Approved"
                                                        && item.CEOStatus == "Approved")
                                    {
                                        <a asp-area="TP"
                                           asp-controller="TrainingCenter"
                                           asp-action="DownloadCertificate"
                                           asp-route-id="@item.Id"
                                           class="btn btn-success btn-sm">
                                            <em class="icon ni ni-file-download"></em>
                                            Download Certificate
                                        </a>
                                    }
                                </td>
                            </tr>

                                        serial++;
                        }
                    }
                    @* else
                    {
                        <tr>
                            <td colspan="9" class="text-center">
                                No training centers found.
                            </td>
                        </tr>
                    } *@
                </tbody>

            </table>
        </div>

    </div>
</div>
