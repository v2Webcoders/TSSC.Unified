@model TSSC.Unified.ViewModel.TrainingCenterViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Training Center Payment";
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Training Center Payment
            </h3>
        </div>
    </div>
</div>

<div class="card card-bordered">
    <div class="card-inner">

        <h5 class="title mb-3">Payment Details</h5>

        <p>
            <strong>Training Center:</strong>
            @Model.TrainingCenterName
        </p>

        <p>
            <strong>Payment Status:</strong>
            @(Model.PaymentStatus ?? "Pending")
        </p>

        @if (Model.PaymentStatus == "Paid")
        {
            <div class="alert alert-success">
                Payment has already been recorded.
            </div>
        }
        else
        {
            <form asp-area="TP"
                  asp-controller="TrainingCenter"
                  asp-action="Payment"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-success">
                    <em class="icon ni ni-wallet"></em>
                    Pay Now
                </button>

                <a asp-area="TP"
                   asp-controller="TrainingCenter"
                   asp-action="CenterList"
                   class="btn btn-light">
                    Back to List
                </a>
            </form>
        }

    </div>
</div>
