@using QUIZAPP.ViewModel
@model DashboardViewModel

@{
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "ADMIN DASHBOARD";
}
@section Styles {
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true" />
}
<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between g-3">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">Welcome back, TSSC Admin <span>&#128075;</span></h3>
            <div class="nk-block-des text-soft">
                <p>Here's what's happening with TSSC today.</p>
            </div>
        </div><!-- .nk-block-head-content -->
        <div class="nk-block-head-content">
            <div class="d-flex align-center flex-wrap g-5">
                <div class="d-flex align-center text-soft gx-2">
                    <em class="icon ni ni-calendar-alt me-2"></em>
                    <span>21 July 2025, Monday</span>
                </div>
                <a href="javascript:void(0);" class="btn btn-primary"><em class="icon ni ni-download-cloud"></em><span>Download Report</span></a>
            </div>
        </div>
        <!-- .nk-block-head-content -->
    </div><!-- .nk-block-between -->
</div><!-- .nk-block-head -->
<div class="nk-block">
    <div class="row g-gs">
        <div class="col-sm-6 col-xxl-3">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="d-flex align-center g-3">
                        <div class="user-avatar bg-primary-dim">
                            <em class="icon ni ni-users"></em>
                        </div>
                        <div>
                            <span class="sub-title text-soft">Total Students</span>
                            <div class="nk-sale-data">
                                <span class="amount">24,568</span>
                            </div>
                            <span class="change up text-success"><em class="icon ni ni-arrow-long-up"></em>12.5% from last month</span>
                        </div>
                    </div>
                </div>
            </div><!-- .card -->
        </div><!-- .col -->
        <div class="col-sm-6 col-xxl-3">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="d-flex align-center g-3">
                        <div class="user-avatar bg-success-dim">
                            <em class="icon ni ni-building"></em>
                        </div>
                        <div>
                            <span class="sub-title text-soft">Active Training Partners</span>
                            <div class="nk-sale-data">
                                <span class="amount">1,248</span>
                            </div>
                            <span class="change up text-success"><em class="icon ni ni-arrow-long-up"></em>8.4% from last month</span>
                        </div>
                    </div>
                </div>
            </div><!-- .card -->
        </div><!-- .col -->
        <div class="col-sm-6 col-xxl-3">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="d-flex align-center g-3">
                        <div class="user-avatar bg-warning-dim">
                            <em class="icon ni ni-book-read"></em>
                        </div>
                        <div>
                            <span class="sub-title text-soft">Ongoing Trainings</span>
                            <div class="nk-sale-data">
                                <span class="amount">382</span>
                            </div>
                            <span class="change up text-success"><em class="icon ni ni-arrow-long-up"></em>15.3% from last month</span>
                        </div>
                    </div>
                </div>
            </div><!-- .card -->
        </div><!-- .col -->
        <div class="col-sm-6 col-xxl-3">
            <div class="card card-bordered">
                <div class="card-inner">
                    <div class="d-flex align-center g-3">
                        <div class="user-avatar bg-purple-dim">
                            <em class="icon ni ni-award"></em>
                        </div>
                        <div>
                            <span class="sub-title text-soft">Certifications Issued</span>
                            <div class="nk-sale-data">
                                <span class="amount">18,752</span>
                            </div>
                            <span class="change up text-success"><em class="icon ni ni-arrow-long-up"></em>10.1% from last month</span>
                        </div>
                    </div>
                </div>
            </div><!-- .card -->
        </div><!-- .col -->
    </div><!-- .row -->
</div><!-- .nk-block -->
<div class="nk-block">
    <div class="row g-gs">
        <div class="col-xxl-5">
            <div class="card card-bordered h-100">
                <div class="card-inner">
                    <div class="card-title-group align-start mb-2">
                        <div class="card-title">
                            <h6 class="title">Student Enrollment Overview</h6>
                        </div>
                        <div class="card-tools">
                            <div class="dropdown">
                                <a href="javascript:void(0)" class="dropdown-toggle btn btn-white btn-dim btn-outline-light btn-sm" data-bs-toggle="dropdown"><span>This Year</span><em class="dd-indc icon ni ni-chevron-right"></em></a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <ul class="link-list-opt no-bdr">
                                        <li><a href="javascript:void(0)"><span>This Year</span></a></li>
                                        <li><a href="javascript:void(0)"><span>Last Year</span></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex g-3 mb-2">
                        <div class="d-flex align-center"><span class="dot dot-lg sq me-1" style="background:#0f5fa8"></span><span class="lead-text">This Year</span></div>
                        <div class="d-flex align-center ms-3"><span class="dot dot-lg sq me-1" style="background:#dbdfea"></span><span class="lead-text">Last Year</span></div>
                    </div>
                    <div class="nk-sales-ck large pt-2" style="height:230px">
                        <canvas id="studentEnrollmentChart"></canvas>
                    </div>
                </div>
            </div><!-- .card -->
        </div><!-- .col -->
        <div class="col-xxl-4">
            <div class="card card-bordered h-100">
                <div class="card-inner">
                    <div class="card-title-group align-start mb-2">
                        <div class="card-title">
                            <h6 class="title">Training &amp; Certification Statistics</h6>
                        </div>
                    </div>
                    <div class="d-flex align-center justify-center" style="height:170px">
                        <canvas id="trainingStatsChart"></canvas>
                    </div>
                    <ul class="nk-store-statistics mt-3">
                        <li class="item d-flex justify-between align-center py-1">
                            <span class="d-flex align-center gx-2"><span class="dot dot-lg" style="background:#0f5fa8"></span><span class="ms-2">Ongoing Trainings</span></span>
                            <span class="text-soft">382 <span class="text-soft">(28%)</span></span>
                        </li>
                        <li class="item d-flex justify-between align-center py-1">
                            <span class="d-flex align-center gx-2"><span class="dot dot-lg" style="background:#639922"></span><span class="ms-2">Completed Trainings</span></span>
                            <span class="text-soft">612 <span class="text-soft">(45%)</span></span>
                        </li>
                        <li class="item d-flex justify-between align-center py-1">
                            <span class="d-flex align-center gx-2"><span class="dot dot-lg" style="background:#f5821f"></span><span class="ms-2">Assessments</span></span>
                            <span class="text-soft">278 <span class="text-soft">(17%)</span></span>
                        </li>
                        <li class="item d-flex justify-between align-center py-1">
                            <span class="d-flex align-center gx-2"><span class="dot dot-lg" style="background:#816bff"></span><span class="ms-2">Certifications Issued</span></span>
                            <span class="text-soft">456 <span class="text-soft">(10%)</span></span>
                        </li>
                    </ul>
                </div>
            </div><!-- .card -->
        </div><!-- .col -->
        <div class="col-xxl-3">
            <div class="card card-bordered h-100">
                <div class="card-inner">
                    <div class="card-title-group align-start mb-3">
                        <div class="card-title">
                            <h6 class="title">Quick Actions</h6>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <a href="javascript:void(0);" class="btn btn-outline-light w-100 h-100 d-flex flex-column align-center py-3"><em class="icon ni ni-user-add fs-4"></em><span class="mt-2" style="font-size:12px">Add New Student</span></a>
                        </div>
                        <div class="col-6">
                            <a href="javascript:void(0);" class="btn btn-outline-light w-100 h-100 d-flex flex-column align-center py-3"><em class="icon ni ni-building fs-4"></em><span class="mt-2" style="font-size:12px">Add Training Partner</span></a>
                        </div>
                        <div class="col-6">
                            <a href="javascript:void(0);" class="btn btn-outline-light w-100 h-100 d-flex flex-column align-center py-3"><em class="icon ni ni-book-read fs-4"></em><span class="mt-2" style="font-size:12px">Create Training</span></a>
                        </div>
                        <div class="col-6">
                            <a href="javascript:void(0);" class="btn btn-outline-light w-100 h-100 d-flex flex-column align-center py-3"><em class="icon ni ni-clipboard fs-4"></em><span class="mt-2" style="font-size:12px">Schedule Assessment</span></a>
                        </div>
                        <div class="col-6">
                            <a href="javascript:void(0);" class="btn btn-outline-light w-100 h-100 d-flex flex-column align-center py-3"><em class="icon ni ni-award fs-4"></em><span class="mt-2" style="font-size:12px">Issue Certificate</span></a>
                        </div>
                        <div class="col-6">
                            <a href="javascript:void(0);" class="btn btn-outline-light w-100 h-100 d-flex flex-column align-center py-3"><em class="icon ni ni-reports fs-4"></em><span class="mt-2" style="font-size:12px">Generate Report</span></a>
                        </div>
                    </div>
                </div>
            </div><!-- .card -->
        </div><!-- .col -->
    </div><!-- .row -->
</div><!-- .nk-block -->
