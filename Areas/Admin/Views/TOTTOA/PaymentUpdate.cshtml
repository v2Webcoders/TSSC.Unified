@model IEnumerable<TSSC.Unified.Models.TrainerRegistration>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Trainer Payment Verification
            </h3>
        </div>

    </div>
</div>

<div class="card card-bordered">
    <div class="card-inner">

        <table class="datatable-init-export table table-tranx table_custom table-bordered dataTable no-footer dtr-inline collapsed">

            <thead>
                <tr>
                    <th>S.No.</th>
                    <th>Registration No.</th>
                    <th>Trainer Name</th>
                    <th>Email</th>
                    <th>Payment Status</th>
                    <th>Payment Date</th>
                    <th>Payment Verification</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @serial
                        </td>

                        <td>
                            @item.RegistrationNo
                        </td>

                        <td>
                            @item.CandidateName
                        </td>

                        <td>
                            @item.Email
                        </td>

                        <td>
                            @if (item.PaymentStatus == "Success")
                            {
                                <span class="badge badge-dot bg-success">
                                    Success
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-dot bg-warning">
                                    @item.PaymentStatus
                                </span>
                            }
                        </td>

                        <td>
                            @(item.PaymentDate?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                        </td>

                        <td>
                            @if (item.PaymentVerified)
                            {
                                <span class="badge badge-dot bg-success">
                                    Verified
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-dot bg-warning">
                                    Pending
                                </span>
                            }
                        </td>

                        <td>
                            @if (item.PaymentStatus == "Success"
                                                    && !item.PaymentVerified)
                            {
                                <form method="post"
                                      action="/Admin/TOTTOA/VerifyPayment"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-success"
                                            title="Verify Payment"
                                            onclick="return confirm('Are you sure you want to verify this payment?');">

                                        <em class="icon ni ni-check"></em>
                                        Verify

                                    </button>

                                </form>
                            }
                            else if (item.PaymentVerified)
                            {
                                <span class="badge badge-dim bg-success">
                                    Verified
                                </span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                    </tr>

                    serial++;
                }

            </tbody>

        </table>

    </div>
</div>