@model IEnumerable<TSSC.Unified.Models.AdminProject>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Project Management
            </h3>
        </div>

        <div class="nk-block-head-content">

            <div class="toggle-wrap nk-block-tools-toggle">

                <a href="#"
                   class="btn btn-icon btn-trigger toggle-expand me-n1"
                   data-target="pageMenu">

                    <em class="icon ni ni-more-v"></em>

                </a>

                <div class="toggle-expand-content"
                     data-content="pageMenu">

                    <ul class="nk-block-tools g-3">

                        <li class="nk-block-tools-opt">

                            <a href="/Admin/ProjectManagement/AddProject"
                               class="btn btn-primary">

                                <em class="icon ni ni-plus"></em>
                                <span>Add Project</span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>
</div>

<div class="card card-bordered">

    <div class="card-inner">

        <table class="datatable-init-export table table-tranx table_custom table-bordered dataTable no-footer dtr-inline collapsed">

            <thead>
                <tr>
                    <th>S.No.</th>
                    <th>Project Name</th>
                    <th>Department</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Project Cost</th>
                    <th>Project Manager</th>
                    <th>Business Head</th>
                    <th>Attachment</th>
                    <th>Status</th>
                    <th>Created On</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>@serial</td>

                            <td>
                                @item.ProjectName
                            </td>

                            <td>
                                @item.Department
                            </td>

                            <td>
                                @item.StartDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @item.EndDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @(item.ProjectCost?.ToString("N2") ?? "-")
                            </td>

                            <td>
                                @item.ProjectManagerId
                            </td>

                            <td>
                                @item.BusinessHeadId
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.Attachment))
                                {
                                    <a href="@item.Attachment"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary"
                                       title="View Attachment">

                                        <em class="icon ni ni-file-pdf"></em>
                                        View
                                    </a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-dot bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-dot bg-danger">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                @item.CreatedDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td>

                                <div class="btn-group" role="group">

                                    <!-- Edit Button -->
                                    <a href="/Admin/ProjectManagement/Edit/@item.ProjectId"
                                       class="btn btn-sm btn-outline-warning"
                                       title="Edit">
                                        <em class="icon ni ni-edit"></em>
                                    </a>

                                    <!-- Details Button -->
                                    <a href="/Admin/ProjectManagement/Details/@item.ProjectId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="View Details">
                                        <em class="icon ni ni-eye"></em>
                                    </a>

                                </div>

                            </td>

                        </tr>

                        serial++;
                    }
                }

            </tbody>

        </table>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center text-muted py-4">
                No Projects found.
            </div>
        }

    </div>

</div>
