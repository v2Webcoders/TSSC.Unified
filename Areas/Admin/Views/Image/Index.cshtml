@model List<string>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Image List";
}

<div class="nk-block-head nk-block-head-sm">

    <div class="nk-block-between">

        <div class="nk-block-head-content">

            <h2 class="nk-block-title page-title">
                Photo Library
            </h2>
        </div>

        <div class="nk-block-head-content">

            <a asp-area="Admin"
               asp-controller="Image"
               asp-action="Upload"
               class="btn btn-primary d-none d-md-inline-flex">

                <em class="icon ni ni-upload"></em>&nbsp;
                Upload Candidate Photos

            </a>

        </div>

    </div>

</div>


<div class="card card-bordered">

    <div class="card-inner">

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info alert-icon">

                <em class="icon ni ni-info"></em>

                <strong>
                    No images found.
                </strong>

            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="datatable-init-export table table-tranx table_custom table-bordered">
                    <thead > <tr> <th style="width:80px;"> S.No. </th> <th> Image Name </th> <th style="width:200px;"> Image </th> </tr> </thead>
                    <tbody>
                        @{
                            int serialNo = 1;
                        } @foreach (var image in Model)
                        {
                            var imageName = System.IO.Path.GetFileName(image);
                            <tr> <td> @serialNo </td> <td> <span class="fw-medium"> @imageName </span> </td> <td> <img src="@image" alt="@imageName" class="img-thumbnail" style="width:120px;height:80px;object-fit:contain;" /> </td> </tr>
                            serialNo++;
                        } </tbody> </table> </div>
        }

    </div>

</div>