@model IEnumerable<TSSC.Unified.Models.CertificateGenerationAssessmentDetail>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Course Certificate History";
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Course Certificate History
            </h3>
            <div class="nk-block-des text-soft">
                <p>View generated course certificates.</p>
            </div>
        </div>
    </div>
</div>

<div class="card card-bordered card-preview">
    <div class="card-inner">

        <div class="table-responsive">

            <table class="datatable-init-export table table-tranx table_custom table-bordered">

                <thead>
                    <tr >

                        <th>S.No.</th>

                        <th>Batch Id</th>
                        <th>Enrollment No</th>
                        <th>Unique ID</th>

                        <th>Candidate Name</th>

                        <th>Gender</th>

                        <th>Father Name</th>

                        <th>Job Role</th>

                        <th>Date Of Issue</th>

                        <th>Generated Date</th>
                       
                        <th>Status</th>

                        <th>Action</th>

                    </tr>
                </thead>

                <tbody>

                    @{
                        int sno = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr class="nk-tb-item">

                            <td class="nk-tb-col">
                                @sno
                            </td>
                            <td class="nk-tb-col">
                                <span class="fw-bold">
                                    @item.BatchId
                                </span>
                            </td>
                            <td class="nk-tb-col">
                                <span class="fw-bold">
                                    @item.EnrollmentNo
                                </span>
                            </td>
                            <td class="nk-tb-col">
                                <span class="fw-bold">
                                    @item.CertificateUniqueNo
                                </span>
                            </td>
                            <td class="nk-tb-col">
                                <span class="fw-bold">
                                    @item.CandidateName
                                </span>
                            </td>

                            <td class="nk-tb-col">
                                @item.Gender
                            </td>

                            <td class="nk-tb-col">
                                @item.FatherName
                            </td>

                            <td class="nk-tb-col">
                                @item.JobRole
                            </td>

                            <td class="nk-tb-col">
                                @(item.DateOfIssue.HasValue
                                    ? item.DateOfIssue.Value.ToString("dd-MM-yyyy")
                                    : "-")
                            </td>

                            <td class="nk-tb-col">
                                @item.GeneratedDate.ToString("dd-MM-yyyy hh:mm tt")
                            </td>

                            <td class="nk-tb-col">

                                @if (item.IsGenerated)
                                {
                                    <span class="badge badge-dim bg-success">
                                        Generated
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-dim bg-danger">
                                        Failed
                                    </span>
                                }

                            </td>
                           
                            <td class="nk-tb-col nk-tb-col-tools">

                                @if (item.IsGenerated &&
                               !string.IsNullOrWhiteSpace(item.GeneratedFilePath))
                                {
                                    <a href="@Url.Content(
                                        item.GeneratedFilePath
                                    )"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">

                                        <em class="icon ni ni-eye"></em>
                                        <span>View</span>

                                    </a>
                                }

                            </td>

                        </tr>

                        sno++;
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>