@model IEnumerable<TSSC.Unified.Models.CertificateGenerationDetail>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    int serial = 1;
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Certificate Generation History
            </h3>
        </div>

    </div>
</div>


<div class="card card-preview">
    <div class="card-inner">

        <table class="datatable-init-export table table-tranx table_custom table-bordered">

            <thead>
                <tr>
                    <th>S.No.</th>
                    <th>Certificate No.</th>
                    <th>Company Name</th>
                    <th>Description</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Generated Date</th>
                    <th>Generated By</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@serial</td>

                        <td>
                            @item.CertificateNo
                        </td>

                        <td>
                            @item.CompanyName
                        </td>

                        <td>
                            @item.Description
                        </td>

                        <td>
                            @item.StartDate?.ToString("dd-MMM-yyyy")
                        </td>

                        <td>
                            @item.EndDate?.ToString("dd-MMM-yyyy")
                        </td>

                        <td>
                            @(item.CertificateGeneration?.GeneratedDate.ToString("dd-MMM-yyyy"))
                        </td>

                        <td>
                            @item.CertificateGeneration?.GeneratedBy
                        </td>

                        <td>

                            @if (item.IsGenerated)
                            {
                                <span class="badge bg-success">
                                    Generated
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Failed
                                </span>
                            }

                        </td>

                        <td>

                            @if (item.IsGenerated &&
                                                    !string.IsNullOrEmpty(item.GeneratedFilePath))
                            {
                                <a href="@item.GeneratedFilePath"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary">

                                    <em class="icon ni ni-download"></em>
                                    Download

                                </a>
                            }
                            else
                            {
                                <span>-</span>
                            }

                        </td>

                    </tr>

                    serial++;
                }

            </tbody>

        </table>

    </div>
</div>