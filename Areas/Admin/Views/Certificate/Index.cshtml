@model IEnumerable<Certificate>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Certificates";
}

<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">

        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">
                Certificates
            </h3>
        </div>

    </div>
</div>


<div class="card card-bordered">

    <div class="card-inner">

        <div class="row g-4">

            <!-- ========================================= -->
            <!-- Certificate Type -->
            <!-- ========================================= -->

            <div class="col-md-3">

                <div class="form-group">

                    <label class="form-label">
                        Certificate Type
                    </label>

                    <div class="form-control-wrap">

                        <select id="certificateType"
                                class="form-select">

                            <option value="">
                                Select Certificate Type
                            </option>

                            @foreach (var type in Model
                                                        .Where(x => !string.IsNullOrWhiteSpace(x.CertificateType))
                                                        .Select(x => x.CertificateType)
                                                        .Distinct()
                                                        .OrderBy(x => x))
                            {
                                <option value="@type">
                                    @type
                                </option>
                            }

                        </select>

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- Certificate Name -->
            <!-- ========================================= -->

            <div class="col-md-3">

                <div class="form-group">

                    <label class="form-label">
                        Certificate Name
                    </label>

                    <div class="form-control-wrap">

                        <select id="certificateName"
                                class="form-select"
                                disabled>

                            <option value="">
                                Select Certificate Name
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- State -->
            <!-- ========================================= -->

            <div class="col-md-3">

                <div class="form-group">

                    <label class="form-label">
                        Select State
                    </label>

                    <div class="form-control-wrap">

                        <select id="certificateState"
                                class="form-select">

                            <option value="">
                                Select State
                            </option>

                            @foreach (var state in ViewBag.States)
                            {
                                <option value="@state.Id">
                                    @state.StateName
                                </option>
                            }

                        </select>

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- Generate Button -->
            <!-- ========================================= -->

            <div class="col-md-3 d-flex align-items-end">

                <div class="form-group w-100">

                    <button type="button"
                            id="generateCertificateBtn"
                            class="btn btn-primary w-100"
                            disabled>

                        <em class="icon ni ni-file-pdf"></em>

                        Generate

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- ========================================= -->
<!-- Template Preview Modal -->
<!-- ========================================= -->

<div class="modal fade"
     id="templatePreviewModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Certificate Preview
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body text-center">

                <img id="templatePreviewImage"
                     src=""
                     class="img-fluid"
                     style="max-width:100%; height:auto;"
                     alt="Certificate Template">

            </div>

        </div>

    </div>

</div>



<script>

    // =====================================================
    // CERTIFICATE DATA
    // =====================================================

    var certificates = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.Select(x => new
                        {
                                id = x.Id,
                                type = x.CertificateType,
                                name = x.CompanyName,
                                template = x.TemplateFile
                        })
                )
        );


    // =====================================================
    // ELEMENTS
    // =====================================================

    var certificateType =
        document.getElementById("certificateType");

    var certificateName =
        document.getElementById("certificateName");

    var certificateState =
        document.getElementById("certificateState");

    var generateButton =
        document.getElementById("generateCertificateBtn");


    // =====================================================
    // CERTIFICATE TYPE CHANGE
    // =====================================================

    certificateType.addEventListener("change", function () {

        var selectedType = this.value;


        // Reset Certificate Name
        certificateName.innerHTML =
            '<option value="">Select Certificate Name</option>';

        certificateName.disabled = true;

        // Disable Generate
        generateButton.disabled = true;


        if (!selectedType) {
            return;
        }


        // Get certificates for selected type

        var filteredCertificates =
            certificates.filter(function (item) {

                return item.type === selectedType;

            });


        // Add certificates to dropdown

        filteredCertificates.forEach(function (item) {

            var option =
                document.createElement("option");

            option.value = item.id;

            option.text = item.name;

            certificateName.appendChild(option);

        });


        certificateName.disabled = false;

    });


    // =====================================================
    // CERTIFICATE NAME CHANGE
    // =====================================================

    certificateName.addEventListener("change", function () {

        var certificateId =
            this.value;


        /*
         * Generate tabhi enable hoga
         * jab Certificate + State dono selected hon
         */

        if (!certificateId || !certificateState.value) {

            generateButton.disabled = true;

            return;
        }


        generateButton.disabled = false;

    });


    // =====================================================
    // STATE CHANGE
    // =====================================================

    certificateState.addEventListener("change", function () {

        /*
         * State sirf generation ke liye hai.
         *
         * State Certificate Type ya Certificate Name
         * ko filter nahi karega.
         */

        var stateId = this.value;


        /*
         * Agar State remove/change hota hai,
         * Generate button ko dobara validate karo.
         */

        if (!stateId || !certificateName.value) {

            generateButton.disabled = true;

            return;
        }


        generateButton.disabled = false;

    });


    // =====================================================
    // GENERATE CERTIFICATE
    // =====================================================

    generateButton.addEventListener("click", function () {

        var certificateId =
            certificateName.value;

        var stateId =
            certificateState.value;


        // Certificate validation

        if (!certificateId) {

            alert("Please select Certificate Name");

            return;
        }


        // State validation

        if (!stateId) {

            alert("Please select State");

            return;
        }


        // =================================================
        // SEND CERTIFICATE ID + STATE ID
        // =================================================

        window.location.href =
            "/Admin/Certificate/BulkGenerate?id=" +
            certificateId +
            "&stateId=" +
            stateId;

    });


    // =====================================================
    // TEMPLATE PREVIEW
    // =====================================================

    function showTemplatePreview(imageUrl) {

        document.getElementById(
            "templatePreviewImage"
        ).src = imageUrl;


        var modal =
            new bootstrap.Modal(
                document.getElementById(
                    "templatePreviewModal"
                )
            );


        modal.show();

    }

</script>