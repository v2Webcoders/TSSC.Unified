@using QUIZAPP.ViewModel
@using TSSC.Unified.ViewModel
@model ResetPasswordVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "~/Views/Shared/_RegistrationLayout.cshtml";
	ViewData["Title"] = "TP Registration";
}
<style>
	.stage.container-fluid {
		padding: 0;
	}

	.step-panel {
		display: none;
	}

		.step-panel.active {
			display: block;
		}

	.otp-row {
		display: flex;
		gap: 10px;
		margin-bottom: 16px;
	}

		.otp-row input {
			width: 44px;
			height: 52px;
			text-align: center;
			font-size: 19px;
			font-weight: 700;
			border-radius: 8px;
			border: 1px solid var(--line);
			outline: none;
			font-family: 'Manrope', sans-serif;
		}

			.otp-row input:focus {
				border-color: var(--saffron);
				box-shadow: 0 0 0 3px rgba(240,130,29,0.15);
			}

	.steps-track {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 26px;
	}

		.steps-track .dot-step {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: var(--line);
			transition: background .2s ease, width .2s ease;
		}

			.steps-track .dot-step.done {
				background: var(--saffron);
				width: 22px;
				border-radius: 4px;
			}

	.resend-line {
		font-size: 13px;
		color: var(--ink-soft);
		text-align: center;
		margin-top: 16px;
	}

	.pw-toggle {
		position: absolute;
		right: 12px;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--ink-soft);
	}

		.pw-toggle svg {
			width: 17px;
			height: 17px;
			stroke: currentColor;
		}

	input[type=password].pw-field {
		padding-right: 38px;
	}

	.strength-bar {
		display: flex;
		gap: 4px;
		margin: 8px 0 16px;
	}

		.strength-bar span {
			height: 4px;
			flex: 1;
			border-radius: 3px;
			background: var(--line);
		}
</style>
<div class="container-fluid stage">
	<div class="row g-0" style="min-height: calc(100vh - 32px);">



		<!-- Right form panel -->
		<div class="col-lg-6 panel">
			<div class="card">

				<a class="d-lg-none brand-mark" href="index.html" style="color:var(--navy); margin-bottom:22px; display:flex;">
					<span class="dot"></span> TSSC UNIFIED PORTAL
				</a>

				<div class="steps-track">
					<div class="dot-step done" data-step="1"></div>
					<div class="dot-step done" data-step="2"></div>
				</div>

				<div class="step-panel active">

					<div class="card-eyebrow">Step 2 of 2</div>

					<div class="card-title">Create new password</div>

					<div class="card-note">
						Enter your new password below.
					</div>

					<form asp-action="ResetPassword"
						  asp-controller="Account"
						  method="post">

						@Html.AntiForgeryToken()

						<input asp-for="UserId" type="hidden" />
						<input asp-for="Token" type="hidden" />

						<div class="field">
							<label asp-for="Password">New Password</label>

							<div class="input-wrap">
								<input asp-for="Password"
									   type="password"
									   placeholder="Enter new password" />
							</div>

							<span asp-validation-for="Password"
								  class="error-text"></span>
							<div class="form-note mt-1">
								<em class="text-soft">
									Password must be at least 8 characters with uppercase, lowercase, and numbers.
								</em>
							</div>
						</div>

						<div class="field">
							<label asp-for="ConfirmPassword">Confirm Password</label>

							<div class="input-wrap">
								<input asp-for="ConfirmPassword"
									   type="password"
									   placeholder="Confirm new password" />
							</div>

							<span asp-validation-for="ConfirmPassword"
								  class="error-text"></span>
						</div>

						<button type="submit" class="btn-primary">
							Reset Password
						</button>

					</form>

				</div>

			</div>
		</div>

	</div>
</div>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}


