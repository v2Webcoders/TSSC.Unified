	<div class="container-fluid stage">

		<div class="row g-0" style="min-height: calc(100vh - 32px);">



			<!-- Right sign-in form -->
			<div class="col-lg-6 panel">
				<div class="card">

					<a class="d-lg-none brand-mark" href="index.html" style="color:var(--navy); margin-bottom:22px; display:flex;">
						<span class="dot"></span> TSSC UNIFIED PORTAL
					</a>

					<div class="status-chip" id="formTitle"><span class="pulse"></span> HRMS Administrator Portal</div>
					<div class="card-title">Welcome back</div>
					<div class="card-note">Sign in with your registered user name and password to continue.</div>


					@using (Html.BeginForm("Login", "Account", FormMethod.Post,
										new
										{
											@class = "",
											id = "signinForm",
											autocomplete = "off",
											autocorrect = "off",
											autocapitalize = "off",
											novalidate = "novalidate"
										}))
					{
						<div class="field">
							<label for="userid">User Name</label>

							<div class="input-wrap">
								<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6">
									<rect x="3" y="5" width="18" height="14" rx="2" />
									<path d="M3 7l9 6 9-6" />
								</svg>

								@Html.TextBoxFor(m => m.userid, new
									{
										@class = "",
										@id = "userid",
										@placeholder = "Enter your username",
										@autocomplete = "username",
										required = "required"
									})
							</div>

							@Html.ValidationMessageFor(m => m.userid, "", new { @class = "error-text" })
						</div>

						<div class="field">
							<label for="password">Password</label>

							<div class="input-wrap">
								<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6">
									<rect x="5" y="11" width="14" height="9" rx="2" />
									<path d="M8 11V8a4 4 0 018 0v3" />
								</svg>

								@Html.PasswordFor(m => m.Password, new
									{
										@class = "pw-field",
										@id = "password",
										@placeholder = "Enter your password",
										@autocomplete = "current-password",
										required = "required"
									})

								@* <button type="button"
                                        class="pw-toggle"
                                        id="pwToggle"
                                        aria-label="Show password">
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6">
                                        <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button> *@

							</div>

							@Html.ValidationMessageFor(m => m.Password, "", new { @class = "error-text" })
						</div>

						<div class="row-between">
							@* <label class="remember">
                                <input type="checkbox" name="RememberMe" />
                                Remember me
                            </label> *@

							<a class="link-btn" href="javascript:void(0);">
								Forgot password?
							</a>
						</div>

						<button type="submit" id="btnSubmit" class="btn-primary">
							Sign In
						</button>

						@if (TempData["ErrorMessage"] != null)
						{
							<div class="alert alert-danger mt-3">
								<i class="fas fa-exclamation-circle me-2"></i>
								@TempData["ErrorMessage"]
							</div>
						}
					}


					<div class="switch-line">Don't have an account? <a href="register.html">Register</a></div>
				</div>
