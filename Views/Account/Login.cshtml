	<script>
		const role = sessionStorage.getItem('regRole');
		if(role) document.getElementById('formTitle').textContent = role + ' Registration';

		function toggleAcc(headEl){
		  const acc = headEl.closest('.accordion');
		  document.querySelectorAll('.accordion').forEach(a => { if(a !== acc) a.classList.remove('open'); });
		  acc.classList.toggle('open');
		  updateProgress();
		}

		function updateProgress(){
		  const openStep = document.querySelector('.accordion.open');
		  const stepNum = openStep ? parseInt(openStep.dataset.step) : 0;
		  document.querySelectorAll('.form-progress .seg').forEach((seg, i) => {
			seg.classList.toggle('done', i < stepNum);
		  });
		}
		updateProgress();

		function fileChosen(input){
		  const label = input.closest('.file-drop').querySelector('.name');
		  label.textContent = input.files.length ? input.files[0].name : 'no file chosen';
		}

		document.getElementById('tpForm').addEventListener('submit', (e) => {
		  e.preventDefault();
		  window.location.href = 'notification.html';
		});

	</script>
