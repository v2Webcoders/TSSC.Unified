@using QUIZAPP.ViewModel
@using TSSC.Unified.ViewModel
@model ForgotPasswordVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
	Layout = "~/Views/Shared/_RegistrationLayout.cshtml";
	ViewData["Title"] = "TP Registration";
}
<style>
	.stage.container-fluid {
		padding: 0;
	}

	.step-panel {
		display: none;
	}

		.step-panel.active {
			display: block;
		}

	.otp-row {
		display: flex;
		gap: 10px;
		margin-bottom: 16px;
	}

		.otp-row input {
			width: 44px;
			height: 52px;
			text-align: center;
			font-size: 19px;
			font-weight: 700;
			border-radius: 8px;
			border: 1px solid var(--line);
			outline: none;
			font-family: 'Manrope', sans-serif;
		}

			.otp-row input:focus {
				border-color: var(--saffron);
				box-shadow: 0 0 0 3px rgba(240,130,29,0.15);
			}

	.steps-track {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 26px;
	}

		.steps-track .dot-step {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: var(--line);
			transition: background .2s ease, width .2s ease;
		}

			.steps-track .dot-step.done {
				background: var(--saffron);
				width: 22px;
				border-radius: 4px;
			}

	.resend-line {
		font-size: 13px;
		color: var(--ink-soft);
		text-align: center;
		margin-top: 16px;
	}

	.pw-toggle {
		position: absolute;
		right: 12px;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--ink-soft);
	}

		.pw-toggle svg {
			width: 17px;
			height: 17px;
			stroke: currentColor;
		}

	input[type=password].pw-field {
		padding-right: 38px;
	}

	.strength-bar {
		display: flex;
		gap: 4px;
		margin: 8px 0 16px;
	}

		.strength-bar span {
			height: 4px;
			flex: 1;
			border-radius: 3px;
			background: var(--line);
		}
</style>
<div class="container-fluid stage">
	<div class="row g-0" style="min-height: calc(100vh - 32px);">



		<!-- Right form panel -->
		<div class="col-lg-6 panel">
			<div class="card">

				<a class="d-lg-none brand-mark" href="index.html" style="color:var(--navy); margin-bottom:22px; display:flex;">
					<span class="dot"></span> TSSC UNIFIED PORTAL
				</a>

				<div class="steps-track">
					<div class="dot-step done" data-step="1"></div>
					<div class="dot-step" data-step="2"></div>
					@* <div class="dot-step" data-step="3"></div> *@
				</div>

				<!-- STEP 1: Email -->
				<div class="step-panel active" id="step1">
					<div class="card-eyebrow">Step 1 of 2</div>

					<div class="card-title">Reset your password</div>

					<div class="card-note">
						Enter your registered email to receive a password reset link.
					</div>
					@if (TempData["ForgotPasswordMessage"] != null)
					{
						<div class="alert alert-success">
							@TempData["ForgotPasswordMessage"]
						</div>
					}

					@if (TempData["Error"] != null)
					{
						<div class="alert alert-danger">
							@TempData["Error"]
						</div>
					}
					<form asp-action="ForgotPassword"
						  asp-controller="Account"
						  method="post"
						  novalidate>

						@Html.AntiForgeryToken()

						<div class="field">
							<label asp-for="Email">Email address</label>

							<div class="input-wrap">
								<svg viewBox="0 0 24 24"
									 fill="none"
									 stroke="currentColor"
									 stroke-width="1.6">
									<rect x="3" y="5" width="18" height="14" rx="2" />
									<path d="M3 7l9 6 9-6" />
								</svg>

								<input asp-for="Email"
									   type="email"
									   id="rpEmail"
									   placeholder="you@organisation.com"
									   autocomplete="email" />
							</div>

							<span asp-validation-for="Email"
								  class="error-text"></span>
						</div>

						<button type="submit" class="btn-primary">
							Submit
						</button>

					</form>

					<div class="switch-line">
						<a href="/account/login">← Back to sign in</a>
					</div>
				</div>

				<!-- STEP 2: OTP -->
				<div class="step-panel" id="step2">
					<div class="card-eyebrow">Step 2 of 3</div>
					<div class="card-title">Enter verification code</div>
					<div class="card-note">We've sent a 6-digit code to <strong id="maskedEmail">you@organisation.com</strong>.</div>

					<form id="otpForm" novalidate>
						<div class="otp-row">
							<input type="text" maxlength="1" inputmode="numeric" class="otp-digit">
							<input type="text" maxlength="1" inputmode="numeric" class="otp-digit">
							<input type="text" maxlength="1" inputmode="numeric" class="otp-digit">
							<input type="text" maxlength="1" inputmode="numeric" class="otp-digit">
							<input type="text" maxlength="1" inputmode="numeric" class="otp-digit">
							<input type="text" maxlength="1" inputmode="numeric" class="otp-digit">
						</div>
						<div class="error-text" id="otpError">Please enter the complete 6-digit code.</div>
						<button type="submit" class="btn-primary">Verify code</button>
					</form>
					<div class="resend-line">Didn't get the code? <button type="button" class="link-btn" id="resendBtn">Resend</button></div>
				</div>

				<!-- STEP 3: New password -->
				<div class="step-panel" id="step3">
					<div class="card-eyebrow">Step 3 of 3</div>
					<div class="card-title">Set a new password</div>
					<div class="card-note">Choose a strong password you haven't used before.</div>

					<form id="resetForm" novalidate>
						<div class="field">
							<label for="newPw">New password</label>
							<div class="input-wrap">
								<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 018 0v3" /></svg>
								<input type="password" id="newPw" class="pw-field" placeholder="At least 8 characters" required>
								<button type="button" class="pw-toggle" data-target="newPw" aria-label="Show password">
									<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
								</button>
							</div>
							<div class="strength-bar"><span></span><span></span><span></span><span></span></div>
						</div>
						<div class="field">
							<label for="confirmPw">Confirm new password</label>
							<div class="input-wrap">
								<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 018 0v3" /></svg>
								<input type="password" id="confirmPw" class="pw-field" placeholder="Re-enter password" required>
								<button type="button" class="pw-toggle" data-target="confirmPw" aria-label="Show password">
									<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
								</button>
							</div>
							<div class="error-text" id="resetError">Passwords must match and be at least 8 characters.</div>
						</div>
						<button type="submit" class="btn-primary">Reset password</button>
					</form>
				</div>

				<!-- STEP 4: Success -->
				<div class="step-panel" id="step4">
					<div class="success-box">
						<div class="ring">
							<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M5 13l4 4L19 7" /></svg>
						</div>
						<div class="card-title" style="text-align:center;">Password reset successful</div>
						<div class="card-note" style="text-align:center;">Your password has been updated. You can now sign in with your new password.</div>
						<a href="sign.html" class="btn-primary">Go to Sign In</a>
					</div>
				</div>

			</div>
		</div>

	</div>
</div>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}


